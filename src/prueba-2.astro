---
const SUPABASE_URL = "https://kbghquvejqteiawdotqd.supabase.co";
const SUPABASE_KEY = "sb_publishable_ld7ydSagUVERw0yphWzjvg_yeSPpKfi";

let noticias = [];

try {
  const r = await fetch(
    `${SUPABASE_URL}/rest/v1/noticias?select=*&publicado=eq.true&order=created_at.desc&limit=25`,
    {
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`
      }
    }
  );

  if (r.ok) noticias = await r.json();
} catch (e) {
  console.error(e);
}

const principal = noticias[0];
const destacadas = noticias.slice(1, 5);
const recientes = noticias.slice(5);

function texto(html = "") {
  return String(html)
    .replace(/<script[\s\S]*?<\/script>/gi, "")
    .replace(/<style[\s\S]*?<\/style>/gi, "")
    .replace(/<img[^>]*>/gi, "")
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function resumen(n, largo = 180) {
  const t = texto(n?.contenido || "");
  return t.length > largo ? t.substring(0, largo) + "..." : t;
}

function categoria(n) {
  return n?.categoria || "Actualidad";
}

function url(n) {
  return `/noticia?id=${n.id}`;
}
---

<!doctype html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>República Actual 2.0 — Prueba</title>

  <meta
    name="description"
    content="República Actual — noticias de República Dominicana y el mundo."
  />
</head>

<body>

<!-- BARRA SUPERIOR -->
<div class="topbar">
