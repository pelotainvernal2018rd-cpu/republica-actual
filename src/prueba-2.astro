</nav>

<!-- ÚLTIMA HORA -->
<div class="ultima">
  <div class="container ultima-inner">
    <strong>⚡ ÚLTIMA HORA</strong>

    <span>
      {principal?.titulo || "República Actual"}
    </span>
  </div>
</div>


<main class="container">

<!-- HERO -->
<section class="hero-grid">

  {
    principal ? (
      <a href={url(principal)} class="hero">

        {
          principal.imagen && (
            <img
              src={principal.imagen}
              alt={principal.titulo}
            />
          )
        }

        <div class="hero-overlay"></div>

        <div class="hero-text">

          <span>{categoria(principal)}</span>

          <h1>{principal.titulo}</h1>

          <p>
            {resumen(principal, 240)}
          </p>

          <b>LEER NOTICIA →</b>

        </div>

      </a>
    ) : (
      <div class="hero-vacio">
        Esperando noticias...
      </div>
    )
  }


  <!-- RD AHORA -->
  <aside class="rd-ahora">

    <div class="titulo-box">
      <h2>RD AHORA</h2>
      <b>● EN VIVO</b>
    </div>

    <div class="mapa">
      🇩🇴
    </div>

    <h3>Actualidad nacional</h3>

    <div class="provincias">
      <a href="/categoria/nacionales">Todas</a>
      <a href="/categoria/santo-domingo">Santo Domingo</a>
      <a href="/categoria/santiago">Santiago</a>
      <a href="/categoria/la-vega">La Vega</a>
      <a href="/categoria/puerto-plata">Puerto Plata</a>
    </div>

  </aside>

</section>


<!-- DESTACADAS -->
<section class="seccion">

  <div class="seccion-titulo">
    <h2>Noticias destacadas</h2>
    <a href="/">Ver todas →</a>
  </div>

  <div class="destacadas">

    {
      destacadas.map((n) => (
        <a href={url(n)} class="card">

          {
            n.imagen ? (
              <img
                src={n.imagen}
                alt={n.titulo}
                loading="lazy"
              />
            ) : (
              <div class="sin-imagen">
                REPÚBLICA ACTUAL
              </div>
            )
          }

          <div class="card-text">

            <span>{categoria(n)}</span>

            <h3>{n.titulo}</h3>

            <p>{resumen(n, 130)}</p>

          </div>

        </a>
      ))
    }

  </div>

</section>


<!-- CONTENIDO -->
<section class="contenido-grid">

  <div>

    <div class="seccion-titulo">
      <h2>Noticias recientes</h2>
      <a href="/">Más noticias →</a>
    </div>

    <div class="lista">

      {
        recientes.map((n) => (
          <a href={url(n)} class="noticia">

            {
              n.imagen ? (
                <img
                  src={n.imagen}
                  alt={n.titulo}
                  loading="lazy"
                />
              ) : (
                <div class="mini-logo">
                  RA
                </div>
              )
            }

            <div>

              <span>{categoria(n)}</span>

              <h3>{n.titulo}</h3>

              <p>{resumen(n, 150)}</p>

            </div>

          </a>
        ))
      }

    </div>

  </div>


  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="widget">

      <h2>🌤 CLIMA EN RD</h2>

      <strong class="temperatura">
        --°C
      </strong>

      <p>Santo Domingo</p>

      <small>
        Módulo meteorológico automático.
      </small>

    </div>


    <div class="widget">

      <h2>🔥 TEMAS DEL MOMENTO</h2>

      <ol>
        <li>Actualidad nacional</li>
        <li>Noticias de última hora</li>
        <li>Economía</li>
        <li>Deportes</li>
        <li>Internacionales</li>
      </ol>

    </div>


    <div class="widget empleo">

      <small>💼 OPORTUNIDADES</small>

      <h2>EMPLÉATE</h2>

      <p>
        Encuentra tu próximo empleo.
      </p>

      <a href="/categoria/empleate">
        VER VACANTES →
      </a>

    </div>

  </aside>

</section>


<!-- MÓDULOS -->
<section class="modulos">

  <a href="/categoria/empleate" class="modulo azul">

    <strong>💼</strong>

    <div>
      <small>OPORTUNIDADES</small>
      <h2>EMPLÉATE</h2>
      <p>
        Vacantes en República Dominicana
        y el extranjero.
      </p>
    </div>

  </a>


  <a href="/pagina/loterias" class="modulo rojo">

    <strong>🎱</strong>

    <div>
      <small>RESULTADOS</small>
      <h2>LOTERÍAS</h2>
      <p>
        República Dominicana y Estados Unidos.
      </p>
    </div>

  </a>

</section>


<!-- LOTERÍAS -->
<section class="loterias">

  <div class="seccion-titulo">

    <h2>Resultados de Loterías</h2>

    <a href="/pagina/loterias">
      Ver módulo completo →
    </a>

  </div>


  <div class="tabs">

    <span class="seleccionado">
      🇩🇴 República Dominicana
    </span>

    <span>
      🇺🇸 Estados Unidos
    </span>

    <span>
      Historial
    </span>

    <span>
      Próximos sorteos
    </span>

    <span>
      Estadísticas
    </span>

  </div>


  <div class="loteria-info">

    <strong>
      Módulo de resultados
    </strong>

    <p>
      Aquí conectaremos los resultados reales
      automáticamente. No se muestran números
      inventados durante la prueba.
    </p>

  </div>

</section>

</main>


<!-- FOOTER -->
<footer>

  <div class="container footer">

    <div>

      <img
        src="/republica-actual-logo.svg"
        alt="República Actual"
      />

      <p>
        Las noticias de hoy,
        siempre contigo.
      </p>

    </div>

    <div>

      <strong>REPÚBLICA ACTUAL 2.0</strong>

      <p>
        Versión de prueba.
        La plantilla actual permanece intacta.
      </p>

    </div>

  </div>

</footer>

</body>
</html>


<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f4f7fa;
  color: #10263b;
  font-family: Arial, Helvetica, sans-serif;
}

