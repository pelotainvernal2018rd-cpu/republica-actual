    width: calc(100% - 20px);
  }

  .topbar-inner {
    justify-content: center;
  }

  .topbar-inner span:last-child {
    display: none;
  }

  .logo img {
    width: 230px;
  }

  .empleo-banner {
    width: 100%;
    justify-content: space-between;
  }

  .hero {
    min-height: 390px;
  }

  .hero img {
    height: 390px;
  }

  .destacadas,
  .modulos {
    grid-template-columns: 1fr;
  }

  .noticia {
    grid-template-columns: 110px 1fr;
  }

  .noticia img,
  .mini-logo {
    width: 110px;
    height: 90px;
  }

  .noticia h3 {
    font-size: 15px;
  }

  .noticia p {
    display: none;
  }

  .footer {
    flex-direction: column;
  }

}

</style>