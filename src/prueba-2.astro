}


/* RESPONSIVE */

@media (max-width: 900px) {

  .hero-grid,
  .contenido-grid {
    grid-template-columns: 1fr;
  }

  .destacadas {
    grid-template-columns: 1fr 1fr;
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 0;
  }

}

@media (max-width: 600px) {

