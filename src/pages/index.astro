// ==================================================
// REPÚBLICA ACTUAL - PORTADA
// Astro + Firestore optimizado
// ==================================================
import VisitantesEnVivo from '../components/VisitantesEnVivo.astro';
import Layout from '../layouts/Layout.astro';
import { cargarNoticiasPublicadas } from '../lib/noticias-firestore.js';

let noticias = [];
let errorConexion = '';

try {
  noticias = await cargarNoticiasPublicadas();
} catch (error) {
  console.error(error);
  errorConexion = 'No se pudieron cargar las noticias.';
}

const totalPaginas = Math.ceil(noticias.length / 10);
const paginaActual = 1;
const inicioPagina = 1;
const finPagina = Math.min(5, totalPaginas);

// ======================================================
// FUNCIONES
// ======================================================

function limpiarHTML(html = '') {
  return html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function resumen(contenido = '', limite = 210) {
  const texto = limpiarHTML(contenido);

  if (texto.length <= limite) {
    return texto;
  }

  return texto.substring(0, limite).trim() + '...';
}

function obtenerCategoria(noticia) {
  if (noticia.categoria) {
    return noticia.categoria;
  }

  if (Array.isArray(noticia.etiquetas) && noticia.etiquetas.length) {
    return noticia.etiquetas[0];
  }

  return 'Actualidad';
}

function enlaceNoticia(noticia) {
  return `/noticia/${noticia.slug || noticia.id}/`;
}

function imagenCloudflare(url = '', ancho = 700) {
  if (!/^https?:\/\//i.test(url)) return url;
  return `/cdn-cgi/image/width=${ancho},quality=75,format=auto,fit=cover/${url}`;
}

// 6 noticias principales de portada
const noticiasPrincipales = noticias.slice(0, 6);

// Contenido evergreen para "NO PASAN DE MODA".
// Prioriza categoría/etiqueta explícita y también temas útiles de larga duración.
function esEvergreen(noticia) {
  const categoria = String(noticia.categoria || '').toLowerCase();
  const etiquetas = Array.isArray(noticia.etiquetas)
    ? noticia.etiquetas.join(' ').toLowerCase()
    : String(noticia.etiquetas || '').toLowerCase();
  const titulo = String(noticia.titulo || '').toLowerCase();

  const marcaEvergreen =
    categoria.includes('no pasan de moda') ||
    categoria.includes('evergreen') ||
    etiquetas.includes('no pasan de moda') ||
    etiquetas.includes('evergreen');

  const temasEvergreen = [
    'cómo ', 'como ', 'requisitos', 'pasos', 'guía', 'guia',
    'historia', 'playa', 'playas', 'turismo', 'turístico', 'turistico',
    'república dominicana', 'republica dominicana', 'samaná', 'samana',
    'punta cana', 'puerto plata', 'zona colonial', 'pasaporte',
    'licencia', 'acta de nacimiento', 'aeropuerto', 'provincia'
  ];

  return marcaEvergreen || temasEvergreen.some(tema => titulo.includes(tema));
}

const noPasanDeModa = noticias
  .filter(esEvergreen)
  .filter(n => !noticiasPrincipales.some(p => String(p.id) === String(n.id)))
  .slice(0, 9);
---

<Layout
