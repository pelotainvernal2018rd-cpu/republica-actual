// ==================================================
// REPÚBLICA ACTUAL - PORTADA
// Astro + Firestore optimizado
// ==================================================
import VisitantesEnVivo from '../components/VisitantesEnVivo.astro';
import Layout from '../layouts/Layout.astro';
import { cargarNoticiasPublicadas } from '../lib/noticias-firestore.js';

let noticias = [];
let errorConexion = '';

try {
  noticias = await cargarNoticiasPublicadas();
} catch (error) {
  console.error(error);
  errorConexion = 'No se pudieron cargar las noticias.';
}

const totalPaginas = Math.ceil(noticias.length / 10);
const paginaActual = 1;
const inicioPagina = 1;
const finPagina = Math.min(5, totalPaginas);

// ======================================================
// FUNCIONES
// ======================================================

function limpiarHTML(html = '') {
  return html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function resumen(contenido = '', limite = 210) {
  const texto = limpiarHTML(contenido);

  if (texto.length <= limite) {
    return texto;
  }

  return texto.substring(0, limite).trim() + '...';
}

function obtenerCategoria(noticia) {
  if (noticia.categoria) {
    return noticia.categoria;
  }

  if (Array.isArray(noticia.etiquetas) && noticia.etiquetas.length) {
    return noticia.etiquetas[0];
  }

  return 'Actualidad';
}

function enlaceNoticia(noticia) {
  return `/noticia/${noticia.slug || noticia.id}/`;
}

function imagenCloudflare(url = '', ancho = 700) {
  if (!/^https?:\/\//i.test(url)) return url;
  return `/cdn-cgi/image/width=${ancho},quality=75,format=auto,fit=cover/${url}`;
}

// 6 noticias principales de portada
const noticiaPrincipal = noticias[0] || null;
const noticiasPrincipales = noticias.slice(1, 7);

// NO PASAN DE MODA: exclusivamente manual.
// Una entrada solo aparece aquí cuando se marca de forma explícita
// con la categoría o etiqueta "No pasan de moda".
// Las noticias automáticas NO entran por palabras del título.
function esNoPasanDeModaManual(noticia) {
  const categoria = String(noticia.categoria || '')
    .trim()
    .toLowerCase();

  const etiquetas = Array.isArray(noticia.etiquetas)
    ? noticia.etiquetas.map(e => String(e).trim().toLowerCase())
    : String(noticia.etiquetas || '')
        .split(',')
        .map(e => e.trim().toLowerCase());

  return (
    categoria === 'no pasan de moda' ||
    etiquetas.includes('no pasan de moda')
  );
}

const noPasanDeModa = noticias
  .filter(esNoPasanDeModaManual)
  .slice(0, 9);
