  <main>

    <div class="franja">
  <strong>ÚLTIMA HORA</strong>

  <a
    id="ticker-noticia"
    href={noticias.length > 0 ? enlaceNoticia(noticias[0]) : "/"}
  >
    {noticias.length > 0 ? noticias[0].titulo : "República Actual"}
  </a>
</div>

<script define:vars={{
  tickerNoticias: noticias.slice(0, 6).map(n => ({
    titulo: n.titulo,
    enlace: enlaceNoticia(n)
  }))
}}>
  const ticker = document.getElementById("ticker-noticia");

  if (ticker && tickerNoticias.length > 1) {
    let posicion = 0;

    setInterval(() => {
      posicion = (posicion + 1) % tickerNoticias.length;

      ticker.style.opacity = "0";

      setTimeout(() => {
        ticker.textContent = tickerNoticias[posicion].titulo;
        ticker.href = tickerNoticias[posicion].enlace;
        ticker.style.opacity = "1";
      }, 250);

    }, 5000);
  }
</script>




<style>
  #ticker-noticia {
    color: #102d46;
    text-decoration: none;
    transition: opacity .25s ease;
  }

  #ticker-noticia:hover {
    color: #e52b32;
  }
</style>


    <h3 class="titulo-seccion">
      Últimas publicaciones
    </h3>


    {
      errorConexion ? (

        <div class="mensaje">
          {errorConexion}
        </div>

      ) : noticias.length === 0 ? (

        <div class="mensaje">
          No hay noticias publicadas todavía.
        </div>

      ) : (

        <section class="noticias">

          {
            noticias.slice(0, 10).map((noticia) => (

              <article class="noticia">

                <h2>
                  <a href={enlaceNoticia(noticia)}>
                    {noticia.titulo}
                  </a>
                </h2>


                <div class="noticia-cuerpo">

                  {
                    noticia.imagen && (

                      <a href={enlaceNoticia(noticia)}>

                        <img
                          class="noticia-imagen"
                          src={noticia.imagen}
                          alt={noticia.titulo}
                          loading="lazy"
                          referrerpolicy="no-referrer"
                        />

                      </a>

                    )
                  }


                  <div>

                    <div
  id="categoria"
  class="categoria"
></div>

                    <p class="resumen">
                      {resumen(noticia.contenido)}
                    </p>

                    <a
                      class="leer"
                      href={enlaceNoticia(noticia)}
                    >
                      Leer más →
                    </a>

                  </div>

                </div>

              </article>

            ))
          }
{
  totalPaginas > 1 && (
    <nav class="paginacion" aria-label="Páginas de noticias">

      {paginaActual > 1 && (
        <a href={paginaActual === 2 ? '/' : `/pagina/${paginaActual - 1}`}>
          ←
        </a>
      )}

      {Array.from(
        { length: finPagina - inicioPagina + 1 },
        (_, i) => inicioPagina + i
      ).map((pagina) => {
        if (pagina === paginaActual) {
          return <span class="activa">{pagina}</span>;
        }

        return (
          <a href={pagina === 1 ? '/' : `/pagina/${pagina}`}>
            {pagina}
          </a>
        );
      })}

      {finPagina < totalPaginas && (
        <span class="puntos">…</span>
      )}

      {finPagina < totalPaginas && (
        <a href={`/pagina/${finPagina + 1}`}>
          →
        </a>
      )}

    </nav>
  )
}
        </section>

      )
    }

