            <div class="boxhead">▣ ARCHIVO HISTÓRICO</div>
            <div class="archive-controls"><select><option>Día</option><option>29</option></select><select><option>Mes</option><option>Septiembre</option></select><select><option>Año</option><option>2026</option></select><select><option>Hora</option><option>8:00 PM</option></select><button>Ver noticias de ese momento →</button></div>
          </section>
        </div>

        <section class="section evergreen">
          <div class="boxhead">♻ NOTICIAS QUE NO CADUCAN <span class="more">Ver más →</span></div>
          <div class="ever-grid">{evergreen.map((n,i)=><a class="ever" href={enlace(n)}><img src={imagen(n,`ever${i}`)} alt={n.titulo}/><h3>{n.titulo}</h3><p>{resumen(n.contenido,70)}</p></a>)}</div>
