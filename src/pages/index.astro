<style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #102a43;
    }


    /* =========================================
       BARRA SUPERIOR
    ========================================= */

    .topbar {
      background: #102d46;
      color: white;
      text-align: center;
      padding: 8px 15px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .5px;
    }


    /* =========================================
       CABECERA
    ========================================= */

    header {
      max-width: 1100px;
      margin: auto;
      padding: 28px 20px 24px;
    }

    .logo {
      font-size: 43px;
      font-weight: 900;
      letter-spacing: -2px;
      margin: 0;
      color: #102d46;
    }

    .logo span {
      color: #e52b32;
    }

    .slogan {
      margin-top: 6px;
      color: #63788b;
      font-size: 13px;
      letter-spacing: 1.5px;
    }


    /* =========================================
       MENÚ
    ========================================= */

    nav {
      border-top: 1px solid #e3e7eb;
      border-bottom: 3px solid #102d46;
    }

    .menu {
      max-width: 1100px;
      margin: auto;
      display: flex;
      gap: 30px;
      padding: 14px 20px;
      overflow-x: auto;
    }

    .menu a {
      color: #102d46;
      text-decoration: none;
      text-transform: uppercase;
      font-size: 13px;
      font-weight: 800;
      white-space: nowrap;
    }

    .menu a:hover {
      color: #e52b32;
    }


    /* =========================================
       CONTENEDOR
    ========================================= */

    main {
      max-width: 1100px;
      margin: auto;
      padding: 24px 20px 50px;
    }


    /* =========================================
       EN PORTADA
    ========================================= */

    .franja {
      background: #f3f5f7;
      border-left: 4px solid #e52b32;
      padding: 13px 15px;
      margin-bottom: 34px;
      font-size: 13px;
    }

    .franja strong {
      color: #e52b32;
      margin-right: 12px;
    }


    /* =========================================
       TÍTULO SECCIÓN
    ========================================= */

    .titulo-seccion {
      color: #e52b32;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 14px;
      border-bottom: 1px solid #e1e6ea;
      padding-bottom: 12px;
      margin-bottom: 5px;
    }


    /* =========================================
       PORTADA MODERNA: 6 NOTICIAS
    ========================================= */

    .noticias {
      width: 100%;
      max-width: none;
    }

    .noticias-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      margin-top: 20px;
    }

    .noticia {
      border: 1px solid #e1e6ea;
      background: #fff;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(16,45,70,.06);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .noticia:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(16,45,70,.10);
    }

    .noticia-imagen-enlace {
      display: block;
      width: 100%;
      height: 230px;
      overflow: hidden;
      background: #eef1f4;
    }

    .noticia-imagen {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .3s ease;
    }

    .noticia:hover .noticia-imagen {
      transform: scale(1.025);
    }

    .noticia-contenido {
      padding: 18px 20px 21px;
    }

    .noticia h2 {
      margin: 0 0 10px;
      font-size: 23px;
      line-height: 1.16;
      letter-spacing: -.45px;
    }

    .noticia h2 a {
      color: #102d46;
      text-decoration: none;
    }

    .noticia h2 a:hover {
      color: #e52b32;
    }

    .categoria {
      color: #e52b32;
      text-transform: uppercase;
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .resumen {
      color: #5f7180;
      font-size: 14px;
      line-height: 1.6;
      margin: 0 0 14px;
    }

    .leer {
      color: #e52b32;
      font-size: 12px;
      font-weight: 800;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: .7px;
    }

    .leer:hover {
      text-decoration: underline;
    }

    /* =========================================
       NO PASAN DE MODA: 9 HORIZONTALES
    ========================================= */

    .evergreen {
      margin-top: 48px;
      padding-top: 4px;
    }

    .evergreen-encabezado {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border-bottom: 2px solid #102d46;
      padding-bottom: 11px;
      margin-bottom: 22px;
    }

    .evergreen-encabezado h2 {
      margin: 0;
      color: #102d46;
      font-size: 22px;
      letter-spacing: .2px;
      text-transform: uppercase;
    }

    .evergreen-encabezado span {
      color: #e52b32;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .evergreen-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 22px;
    }

    .evergreen-item {
      min-width: 0;
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 13px;
      align-items: start;
      border-bottom: 1px solid #e1e6ea;
      padding-bottom: 17px;
    }

    .evergreen-foto {
      width: 112px;
      height: 82px;
      display: block;
      object-fit: cover;
      background: #eef1f4;
    }

    .evergreen-categoria {
      display: block;
      color: #e52b32;
      text-transform: uppercase;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .8px;
      margin-bottom: 5px;
    }

    .evergreen-item h3 {
      margin: 0 0 6px;
      font-size: 15px;
      line-height: 1.22;
    }

    .evergreen-item h3 a {
      color: #102d46;
      text-decoration: none;
    }

    .evergreen-item h3 a:hover {
      color: #e52b32;
    }

    .evergreen-resumen {
      margin: 0;
      color: #6a7986;
      font-size: 11px;
      line-height: 1.45;
    }


    /* =========================================
       ERROR / VACÍO
    ========================================= */

    .mensaje {
      padding: 30px 0;
      color: #687986;
    }


    /* =========================================
       FOOTER
    ========================================= */

    footer {
      margin-top: 50px;
      background: #102d46;
      color: white;
      text-align: center;
      padding: 28px 20px;
      font-size: 13px;
    }


    /* =========================================
       MÓVIL
    ========================================= */

    @media (max-width: 950px) and (min-width: 701px) {
      .evergreen-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {

      header {
        padding-top: 22px;
      }

      .logo {
        font-size: 32px;
      }

      .menu {
        gap: 22px;
      }

      main {
        padding: 20px 16px 40px;
      }

      .noticias-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .noticia h2 {
        font-size: 22px;
      }

      .noticia-imagen-enlace {
        height: 220px;
      }

      .evergreen-grid {
        grid-template-columns: 1fr;
      }

      .evergreen-item {
        grid-template-columns: 118px minmax(0, 1fr);
      }

      .evergreen-foto {
        width: 118px;
        height: 86px;
      }

    }

  </style>


  <div class="topbar">
    INFORMACIÓN CON CONTEXTO Y CLARIDAD
  </div>


  <header>

    <h1 class="logo">
      REPÚBLICA<span>·</span>ACTUAL
    </h1>

    <div class="slogan">
      LO QUE PASA. LO QUE IMPORTA.
    </div>

  </header>


  <nav>

    <div class="menu">

      <a href="/">Inicio</a>

      <a href="/categoria/nacionales">Nacionales</a>

      <a href="/categoria/politica">Política</a>

      <a href="/categoria/economia">Economía</a>

      <a href="/categoria/deportes">Deportes</a>

      <a href="/resultados-loterias/">Loterías</a>

      <a href="/categoria/entretenimiento">Entretenimiento</a>

      <a href="/categoria/mundo">Mundo</a>

      <a href="/categoria/tecnologia">Tecnología</a>

    </div>

  </nav>


  <main>

    <div class="franja">
  <strong>ÚLTIMA HORA</strong>

  <a
    id="ticker-noticia"
    href={noticias.length > 0 ? enlaceNoticia(noticias[0]) : "/"}
  >
    {noticias.length > 0 ? noticias[0].titulo : "República Actual"}
  </a>
</div>

<script define:vars={{
  tickerNoticias: noticias.slice(0, 6).map(n => ({
    titulo: n.titulo,
    enlace: enlaceNoticia(n)
  }))
}}>
  const ticker = document.getElementById("ticker-noticia");

  if (ticker && tickerNoticias.length > 1) {
    let posicion = 0;

    setInterval(() => {
      posicion = (posicion + 1) % tickerNoticias.length;

      ticker.style.opacity = "0";

      setTimeout(() => {
        ticker.textContent = tickerNoticias[posicion].titulo;
        ticker.href = tickerNoticias[posicion].enlace;
        ticker.style.opacity = "1";
      }, 250);

    }, 5000);
  }
</script>




<style>
  #ticker-noticia {
    color: #102d46;
    text-decoration: none;
    transition: opacity .25s ease;
  }

  #ticker-noticia:hover {
    color: #e52b32;
  }
</style>


    <h3 class="titulo-seccion">
      Últimas publicaciones
    </h3>

    {
      errorConexion ? (
        <div class="mensaje">
          {errorConexion}
        </div>
      ) : noticias.length === 0 ? (
        <div class="mensaje">
          No hay noticias publicadas todavía.
        </div>
      ) : (
        <>
          <section class="noticias" aria-label="Últimas publicaciones">
            <div class="noticias-grid">
              {
                noticiasPrincipales.map((noticia, indice) => (
                  <article class="noticia">
                    {noticia.imagen && (
                      <a class="noticia-imagen-enlace" href={enlaceNoticia(noticia)}>
                        <img
                          class="noticia-imagen"
                          src={imagenCloudflare(noticia.imagen, 700)}
                          srcset={`${imagenCloudflare(noticia.imagen, 520)} 520w, ${imagenCloudflare(noticia.imagen, 800)} 800w`}
                          alt={noticia.titulo}
                          width="700"
                          height="460"
                          sizes="(max-width: 700px) calc(100vw - 32px), 530px"
                          loading={indice === 0 ? "eager" : "lazy"}
                          fetchpriority={indice === 0 ? "high" : "auto"}
                          decoding="async"
                          referrerpolicy="no-referrer"
                          data-original={noticia.imagen}
                          onerror="if(this.dataset.fallbackStage!=='original'){this.dataset.fallbackStage='original';this.removeAttribute('srcset');this.src=this.dataset.original;}else{this.onerror=null;this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22700%22 height=%22460%22 viewBox=%220 0 700 460%22%3E%3Crect width=%22700%22 height=%22460%22 fill=%22%23eef1f4%22/%3E%3Ctext x=%22350%22 y=%22230%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22 font-family=%22Arial%22 font-size=%2228%22 fill=%22%23102d46%22%3EREPÚBLICA ACTUAL%3C/text%3E%3C/svg%3E';}"
                        />
                      </a>
                    )}

                    <div class="noticia-contenido">
                      <div class="categoria">{obtenerCategoria(noticia)}</div>
                      <h2>
                        <a href={enlaceNoticia(noticia)}>
                          {noticia.titulo}
                        </a>
                      </h2>
                      <p class="resumen">
                        {resumen(noticia.contenido, 150)}
                      </p>
                      <a class="leer" href={enlaceNoticia(noticia)}>
                        Leer más →
                      </a>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          {noPasanDeModa.length > 0 && (
            <section class="evergreen" aria-labelledby="no-pasan-de-moda">
              <div class="evergreen-encabezado">
                <h2 id="no-pasan-de-moda">No pasan de moda</h2>
                <span>Guías · Historia · RD</span>
              </div>

              <div class="evergreen-grid">
                {noPasanDeModa.map((noticia) => (
                  <article class="evergreen-item">
                    {noticia.imagen && (
                      <a href={enlaceNoticia(noticia)}>
                        <img
                          class="evergreen-foto"
                          src={imagenCloudflare(noticia.imagen, 300)}
                          alt={noticia.titulo}
                          width="112"
                          height="82"
                          loading="lazy"
                          decoding="async"
                          referrerpolicy="no-referrer"
                          data-original={noticia.imagen}
                          onerror="if(this.dataset.fallbackStage!=='original'){this.dataset.fallbackStage='original';this.src=this.dataset.original;}"
                        />
                      </a>
                    )}
                    <div>
                      <span class="evergreen-categoria">{obtenerCategoria(noticia)}</span>
                      <h3>
                        <a href={enlaceNoticia(noticia)}>
                          {noticia.titulo}
                        </a>
                      </h3>
                      <p class="evergreen-resumen">
                        {resumen(noticia.contenido, 85)}
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

          {totalPaginas > 1 && (
            <nav class="paginacion" aria-label="Páginas de noticias">
              {Array.from(
                { length: finPagina - inicioPagina + 1 },
                (_, i) => inicioPagina + i
              ).map((pagina) => {
                if (pagina === paginaActual) {
                  return <span class="activa">{pagina}</span>;
                }
                return (
                  <a href={pagina === 1 ? '/' : `/pagina/${pagina}`}>
                    {pagina}
                  </a>
                );
              })}

              {finPagina < totalPaginas && <span class="puntos">…</span>}
              {finPagina < totalPaginas && (
                <a href={`/pagina/${finPagina + 1}`}>→</a>
              )}
            </nav>
          )}
        </>
      )
    }

  </main>


 <footer class="footer">
  <div class="footer-contenido">



    <div class="footer-logo">
      REPÚBLICA<span>·</span>ACTUAL
    </div>

    <div class="footer-enlaces">
      <a href="/quienes-somos/">Quiénes somos</a>
      <a href="/contacto/">Contacto</a>
      <a href="/politica-de-privacidad/">Política de privacidad</a>
      <a href="/terminos-y-condiciones/">Términos y condiciones</a>
    </div>

    <p>
      © 2026 República Actual. Todos los derechos reservados.
    </p>

  </div>
  <VisitantesEnVivo />
</footer>

