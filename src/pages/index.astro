import VisitantesEnVivo from '../components/VisitantesEnVivo.astro';
import RegistrarVisita from '../components/RegistrarVisita.astro';

const SUPABASE_URL = 'https://kbghquvejqteiawdotqd.supabase.co';
const SUPABASE_KEY = 'sb_publishable_ld7ydSagUVERw0yphWzjvg_yeSPpKfi';

let noticias = [];
let errorConexion = '';

try {
  const endpoint = `${SUPABASE_URL}/rest/v1/noticias?select=*&publicado=eq.true&order=created_at.desc`;
  const respuesta = await fetch(endpoint, {
    headers: {
      apikey: SUPABASE_KEY,
      Authorization: `Bearer ${SUPABASE_KEY}`,
      Accept: 'application/json'
    }
  });
  if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);
  noticias = await respuesta.json();
} catch (error) {
  console.error(error);
  errorConexion = 'No se pudieron cargar las noticias.';
}

function limpiarHTML(html = '') {
  return String(html)
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}
function resumen(c = '', limite = 170) {
  const t = limpiarHTML(c);
  return t.length > limite ? t.slice(0, limite).trim() + '...' : t;
}
function categoria(n) {
  return n?.categoria || (Array.isArray(n?.etiquetas) ? n.etiquetas[0] : '') || 'Actualidad';
}
function enlace(n) {
  return n ? `/noticia/${n.slug || n.id}/` : '#';
}
function imagen(n, seed = 'news') {
  return n?.imagen || `https://picsum.photos/seed/${seed}/900/600`;
}
function fecha(n) {
  if (!n?.created_at) return 'Reciente';
  const d = new Date(n.created_at);
  return new Intl.DateTimeFormat('es-DO', { day:'numeric', month:'short', year:'numeric' }).format(d);
}

const principal = noticias[0];
const destacadas = noticias.slice(1, 5);
const videos = noticias.filter(n => /<video|youtube|youtu\.be|vimeo/i.test(String(n.contenido || ''))).slice(0, 4);
const videoCards = videos.length ? videos : noticias.slice(0, 4);
const provincias = [
  ['Santo Domingo', noticias[0]],
  ['Santiago', noticias[1]],
  ['La Vega', noticias[2]],
  ['Puerto Plata', noticias[3]],
  ['San Cristóbal', noticias[4]],
];
const evergreen = noticias.slice(5, 10);
const relacionados = noticias.slice(1, 4);
const timeline = noticias.slice(0, 5).reverse();
const ticker = noticias.slice(0, 6);
const temas = noticias.slice(0, 5);
const ahora = new Date();
const fechaCabecera = new Intl.DateTimeFormat('es-DO', {
  weekday:'long', day:'numeric', month:'long', year:'numeric'
}).format(ahora);
