// ==================================================
// REPÚBLICA ACTUAL - PORTADA
// Astro + Supabase
// ==================================================
import VisitantesEnVivo from '../components/VisitantesEnVivo.astro';
import RegistrarVisita from '../components/RegistrarVisita.astro';
const SUPABASE_URL = 'https://kbghquvejqteiawdotqd.supabase.co';
const SUPABASE_KEY = 'sb_publishable_ld7ydSagUVERw0yphWzjvg_yeSPpKfi';

let noticias = [];
let errorConexion = '';

try {
  const endpoint =
    `${SUPABASE_URL}/rest/v1/noticias?select=*&publicado=eq.true&order=created_at.desc`;

  const respuesta = await fetch(endpoint, {
    headers: {
      apikey: SUPABASE_KEY,
      Authorization: `Bearer ${SUPABASE_KEY}`,
      Accept: 'application/json'
    }
  });

  if (!respuesta.ok) {
    throw new Error(`HTTP ${respuesta.status}`);
  }

  noticias = await respuesta.json();

} catch (error) {
  console.error(error);
  errorConexion = 'No se pudieron cargar las noticias.';
}
const totalPaginas = Math.ceil(noticias.length / 10);
const rutaActual = Astro.url.pathname;

const paginaActual =
  rutaActual.startsWith('/pagina/')
    ? Number(rutaActual.split('/').filter(Boolean).pop()) || 1
    : 1;

const inicioPagina =
  Math.floor((paginaActual - 1) / 5) * 5 + 1;

const finPagina =
  Math.min(inicioPagina + 4, totalPaginas);

// ======================================================
// FUNCIONES
// ======================================================

function limpiarHTML(html = '') {
  return html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function resumen(contenido = '', limite = 210) {
  const texto = limpiarHTML(contenido);

  if (texto.length <= limite) {
    return texto;
  }

  return texto.substring(0, limite).trim() + '...';
}

function obtenerCategoria(noticia) {
  if (noticia.categoria) {
    return noticia.categoria;
  }

  if (Array.isArray(noticia.etiquetas) && noticia.etiquetas.length) {
    return noticia.etiquetas[0];
  }

  return 'Actualidad';
}

function enlaceNoticia(noticia) {
  return `/noticia/${noticia.slug || noticia.id}/`;
}
