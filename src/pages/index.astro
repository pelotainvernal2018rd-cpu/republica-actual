<script define:vars={{
  tickerNoticias: noticias.slice(0, 6).map(n => ({
    titulo: n.titulo,
    enlace: enlaceNoticia(n)
  }))
}}>
  const ticker = document.getElementById("ticker-noticia");

  if (ticker && tickerNoticias.length > 1) {
    let posicion = 0;

    setInterval(() => {
      posicion = (posicion + 1) % tickerNoticias.length;

      ticker.style.opacity = "0";

      setTimeout(() => {
        ticker.textContent = tickerNoticias[posicion].titulo;
        ticker.href = tickerNoticias[posicion].enlace;
        ticker.style.opacity = "1";
      }, 250);

    }, 5000);
  }
</script>




