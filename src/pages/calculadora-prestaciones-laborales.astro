const title = 'Calculadora de Prestaciones Laborales RD 2026 | Cesantía, Preaviso y Liquidación';
const description = 'Calcula prestaciones laborales en República Dominicana 2026: cesantía, preaviso, vacaciones, salario de Navidad y bonificación. Salarios y comisiones de 12 meses. Gratis.';
