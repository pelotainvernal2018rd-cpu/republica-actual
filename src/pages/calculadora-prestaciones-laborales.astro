const faq = [
  {q:'¿Cómo calcular las prestaciones laborales en República Dominicana?',a:'Se utilizan la antigüedad, el salario ordinario y el tipo de terminación. El cálculo puede incluir preaviso, cesantía, vacaciones pendientes y salario de Navidad según corresponda.'},
  {q:'¿Cómo se calcula la cesantía en RD?',a:'El artículo 80 del Código de Trabajo establece días de salario según la antigüedad. El resultado depende también de la causa de terminación del contrato.'},
  {q:'¿Cómo calcular el salario de Navidad?',a:'Como regla general, equivale a una duodécima parte de los salarios ordinarios devengados durante el año calendario, sujeto a las condiciones y límites legales.'},
