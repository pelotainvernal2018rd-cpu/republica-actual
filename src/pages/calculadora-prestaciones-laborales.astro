  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:'https://republicaactual.net/'},{'@type':'ListItem',position:2,name:'Calculadora de prestaciones laborales',item:canonical}]}
