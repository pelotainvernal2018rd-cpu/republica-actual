-row label{display:flex;align-items:center;gap:7px;border:1px solid #d9e3f0;border-radius:10px;padding:10px 13px;cursor:pointer;font-weight:600;margin:0}.radio-row input{width:auto}.salary-table{width:100%;border-collapse:collapse;font-size:13px}.salary-table th{background:#eef4fc;color:#254469;text-align:left;padding:10px 6px}.salary-table td{border-bottom:1px solid #e9eef6;padding:6px}.salary-table td:first-child{font-weight:700;color:#677991;width:42px}.salary-table input{padding:9px 7px;font-size:14px}.salary-table td:last-child{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.scroll{overflow-x:auto}.summary{background:linear-gradient(120deg,#082e69,#0d61c5);color:white;padding:24px;border-radius:15px;margin-bottom:17px}.summary .total{font-size:clamp(27px,3vw,39px);font-weight:850;margin:8px 0}.summary small{color:#d8e8fc}.line{display:flex;align-items:start;justify-content:space-between;gap:12px;border-bottom:1px solid #e7edf5;padding:12px 0;font-size:14px}.line strong{text-align:right;white-space:nowrap}.line.total-line{font-weight:800;font-size:17px;border-top:2px solid #dbe5f3}.muted{color:#61738d}.warning{background:#fff7e9;border-left:4px solid #efa82b;border-radius:9px;padding:15px;line-height:1.65;font-size:13px;margin-top:15px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:15px}.btn{border:0;border-radius:10px;padding:13px 16px;font-weight:800;cursor:pointer;background:#095dcb;color:white}.btn.secondary{background:#e9f1fc;color:#124b98}.btn:focus-visible{outline:3px solid #80b6ff}.error{color:#bd2431;font-weight:700;font-size:14px}.article{line-height:1.85}.article h2{margin-top:25px}.article p{color:#435570}.faq details{border-top:1px solid #e5ebf3;padding:15px 0}.faq summary{cursor:pointer;font-weight:700}.faq p{color:#4a5c73}.note{background:#eff5fd;border-radius:10px;padding:13px;color:#405a78;font-size:13px;line-height:1.6}footer{background:#092c60;color:white;text-align:center;padding:25px}footer a{color:white}.optional{font-size:11px;font-weight:500;color:#71829b}.hidden{display:none!important}@media(max-width:850px){.layout{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.hero{padding:24px}.card{padding:18px}.top small{display:none}}@media print{.top,.crumb,.hero .chips,.actions,.article,.faq,footer,.no-print{display:none!important}.wrap{padding:0}.hero{box-shadow:none;background:white;color:black;padding:0}.hero p{color:#333}.layout{display:block}.card{box-shadow:none;break-inside:avoid}.summary{background:#eee;color:#111}.summary small{color:#333}}
