
---
const titulo = 'Calculadora de Prestaciones Laborales RD 2026 | República Actual';
const descripcion = 'Calculadora de prestaciones laborales RD 2026: estima cesantía, preaviso, salario de Navidad, vacaciones, bonificación y pagos pendientes en República Dominicana.';
const url = 'https://republicaactual.net/calculadora-prestaciones-laborales/';
---

<!doctype html>
<html lang="es-DO">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={url} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={url} />
  <meta property="og:type" content="website" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Calculadora de Prestaciones Laborales RD",
    url,
    applicationCategory: "FinanceApplication",
    operatingSystem: "All",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "DOP"
    },
    publisher: {
      "@type": "Organization",
      name: "República Actual",
      url: "https://republicaactual.net/"
    }
  })} />

  <style>
    :global(*) { box-sizing: border-box; }
    :global(body) {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f2f5fa;
      color: #15233b;
    }
    .header {
      background: #082b60;
      color: white;
      padding: 20px;
      text-align: center;
      border-bottom: 5px solid #e52d39;
    }
    .header a {
      color: white;
      text-decoration: none;
      font-size: 26px;
      font-weight: 900;
    }
    .nav {
      background: white;
      padding: 13px 20px;
      border-bottom: 1px solid #e0e5ee;
    }
    .nav div {
      max-width: 1100px;
      margin: auto;
    }
    .nav a { color: #0757bc; text-decoration: none; }
    main {
      max-width: 1100px;
      margin: auto;
      padding: 28px 16px 50px;
    }
    h1 {
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.2;
      margin: 10px 0;
    }
    .intro {
      color: #52627a;
      line-height: 1.7;
      max-width: 850px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 22px;
      margin-top: 26px;
    }
    .card {
      background: white;
      padding: 26px;
      border-radius: 16px;
      border: 1px solid #e0e7f0;
      box-shadow: 0 5px 20px #1020400c;
    }
    h2 { font-size: 23px; margin-top: 0; }
    .field { margin-bottom: 19px; }
    label {
      display: block;
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 8px;
    }
    input, select {
      width: 100%;
      padding: 13px;
      border: 1px solid #bdc9d9;
      border-radius: 9px;
      font-size: 16px;
      background: white;
      color: #15233b;
    }
    input:focus, select:focus {
      outline: 2px solid #1164d7;
      border-color: #1164d7;
    }
    .dates {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .hint {
      font-size: 12px;
      color: #65758a;
      line-height: 1.5;
      margin-top: 6px;
    }
    button {
      width: 100%;
      padding: 16px;
      background: #075cc9;
      color: white;
      border: 0;
      border-radius: 10px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { background: #03479f; }
    .result {
      background: linear-gradient(135deg,#082b60,#075ac4);
      color: white;
      border-radius: 14px;
      padding: 25px;
      margin-bottom: 18px;
    }
    .result small { color: #dce9fa; }
    .secondary-button { margin-top: 10px; background: #24466f; }
    @media print { .header,.nav,footer,button,.warning { display: none !important; } body { background: white !important; } main { padding: 0; } .grid { grid-template-columns: 1fr 1fr; } .card { box-shadow: none; break-inside: avoid; } }
    .result strong {
      display: block;
      font-size: clamp(28px, 4vw, 38px);
      margin: 12px 0;
      overflow-wrap: anywhere;
    }
    .line {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 15px 0;
      border-bottom: 1px solid #e6ebf2;
    }
    .line b { text-align: right; }
    .warning {
      background: #fff7e6;
      border-left: 4px solid #e8a52b;
      padding: 16px;
      border-radius: 7px;
      margin-top: 22px;
      font-size: 14px;
      line-height: 1.7;
    }
    .article {
      margin-top: 28px;
      line-height: 1.8;
    }
    .article h2 { margin-top: 25px; }
    .article a, .warning a { color: #075ac9; }
    .error { color: #c32030; font-weight: bold; }
    footer {
      text-align: center;
      background: #082b60;
      color: white;
      padding: 25px;
    }
    footer a { color: white; }
    @media(max-width:760px) {
      .grid,.dates { grid-template-columns: 1fr; }
      .card { padding: 19px; }
      .header a { font-size: 22px; }
    }
  </style>
</head>

<body>
  <header class="header">
    <a href="/">REPÚBLICA ACTUAL</a>
  </header>

  <nav class="nav">
    <div>
      <a href="/">Inicio</a> /
      Calculadora de prestaciones
    </div>
  </nav>

  <main>
    <h1>Calculadora de Prestaciones Laborales RD 2026</h1>

    <p class="intro">
      Estima cuánto podrías recibir por concepto de
      prestaciones laborales en República Dominicana.
      Calcula cesantía, preaviso y salario de Navidad
      según tu salario, antigüedad y tipo de terminación.
    </p>

    <div class="grid">
      <section class="card">
        <h2>Datos del trabajador</h2>

        <form id="formulario">
          <div class="field">
            <label for="salario">Salario mensual ordinario (RD$)</label>
            <input id="salario" type="number" min="1" step="0.01"
              placeholder="Ejemplo: 30000" required />
            <p class="hint">
              Para salarios variables o comisiones, utiliza
              el promedio legal aplicable.
            </p>
          </div>

          <div class="dates">
            <div class="field">
              <label for="inicio">Fecha de ingreso</label>
              <input id="inicio" type="date" required />
            </div>
            <div class="field">
              <label for="fin">Fecha de salida</label>
              <input id="fin" type="date" required />
            </div>
          </div>

          <div class="field">
            <label for="tipo">Tipo de terminación</label>
            <select id="tipo">
              <option value="desahucio">
                Desahucio por el empleador
              </option>
              <option value="renuncia">
                Renuncia voluntaria
              </option>
              <option value="justificado">Despido justificado</option>
              <option value="injustificado">Despido injustificado (estimación de prestaciones)</option>
              <option value="dimension">Dimisión justificada (requiere validación legal)</option>
            </select>
            <p class="hint">
              Despidos injustificados y dimisiones justificadas
              requieren una evaluación adicional.
            </p>
          </div>

          <div class="field" id="grupoAviso">
            <label for="aviso">¿Se cumplió el preaviso?</label>
            <select id="aviso">
              <option value="no">No se cumplió</option>
              <option value="si">Sí, completamente</option>
            </select>
          </div>

          <div class="field">
            <label for="devengado">
              Salario ordinario devengado en el año (RD$)
            </label>
            <input id="devengado" type="number" min="0"
              step="0.01" placeholder="Opcional" />
            <p class="hint">
              Si no introduces este dato, se estimará
              proporcionalmente según el salario mensual.
            </p>
          </div>

          <h2>Derechos adquiridos y pagos pendientes</h2>
          <div class="dates">
            <div class="field"><label for="vacaciones">Días de vacaciones pendientes</label><input id="vacaciones" type="number" min="0" step="0.5" value="0" /><p class="hint">Introduce los días remunerados pendientes que correspondan; no se presume que todos los días de vacaciones estén pendientes.</p></div>
            <div class="field"><label for="navidadPagada">Salario de Navidad ya pagado (RD$)</label><input id="navidadPagada" type="number" min="0" step="0.01" value="0" /></div>
            <div class="field"><label for="salariosPendientes">Salarios pendientes (RD$)</label><input id="salariosPendientes" type="number" min="0" step="0.01" value="0" /></div>
            <div class="field"><label for="comisiones">Comisiones pendientes (RD$)</label><input id="comisiones" type="number" min="0" step="0.01" value="0" /></div>
            <div class="field"><label for="extras">Horas extras y recargos pendientes (RD$)</label><input id="extras" type="number" min="0" step="0.01" value="0" /></div>
            <div class="field"><label for="otros">Otros pagos pendientes (RD$)</label><input id="otros" type="number" min="0" step="0.01" value="0" /></div>
          </div>
          <h2>Bonificación anual</h2>
          <div class="field"><label for="bonificacion">Bonificación que corresponde pagar (RD$)</label><input id="bonificacion" type="number" min="0" step="0.01" value="0" /><p class="hint">Indica el monto confirmado o estimado a partir de los beneficios netos distribuibles de la empresa y los días de participación correspondientes. No se presume que exista bonificación ni se calcula solo con el salario.</p></div>
          <div class="dates">
            <div class="field"><label for="descuentos">Anticipos y descuentos aplicables (RD$)</label><input id="descuentos" type="number" min="0" step="0.01" value="0" /></div>
            <div class="field"><label for="navidadTope">Tope aplicable al salario de Navidad (RD$, opcional)</label><input id="navidadTope" type="number" min="0" step="0.01" placeholder="Si se conoce" /><p class="hint">Verifica el límite legal de cinco salarios mínimos aplicable al caso; si lo dejas vacío no se aplica un tope automático.</p></div>
          </div>
          <button type="submit">CALCULAR LIQUIDACIÓN COMPLETA</button>
          <button type="button" id="imprimir" class="secondary-button">IMPRIMIR / GUARDAR EN PDF</button>

          <p id="error" class="error" role="alert"></p>
        </form>
      </section>

      <section class="card" aria-live="polite">
        <h2>Resultado estimado</h2>

        <div class="result">
          <small>Total orientativo</small>
          <strong id="total">RD$ 0.00</strong>
          <small id="antiguedad">
            Completa el formulario para calcular
          </small>
        </div>

        <div class="line">
          <span>Preaviso</span>
          <b id="preaviso">RD$ 0.00</b>
        </div>

        <div class="line">
          <span>Cesantía</span>
          <b id="cesantia">RD$ 0.00</b>
        </div>

        <div class="line">
          <span>Salario de Navidad</span>
          <b id="navidad">RD$ 0.00</b>
        </div>

        <div class="line"><span>Vacaciones pendientes</span><b id="vacacionesResultado">RD$ 0.00</b></div>
        <div class="line"><span>Bonificación anual (monto introducido)</span><b id="bonificacionResultado">RD$ 0.00</b></div>
        <div class="line"><span>Salarios pendientes</span><b id="salariosResultado">RD$ 0.00</b></div>
        <div class="line"><span>Comisiones pendientes</span><b id="comisionesResultado">RD$ 0.00</b></div>
        <div class="line"><span>Horas extras y recargos pendientes</span><b id="extrasResultado">RD$ 0.00</b></div>
        <div class="line"><span>Otros pagos pendientes</span><b id="otrosResultado">RD$ 0.00</b></div>
        <div class="line"><span>Descuentos aplicables</span><b id="descuentosResultado">RD$ 0.00</b></div>
        <p id="detalleCalculo" class="hint" aria-live="polite"></p>

        <div class="warning"><strong>Aviso importante:</strong> Cálculo orientativo, no liquidación oficial ni asesoría legal. Las prestaciones dependen de la causa de terminación y de los hechos comprobados. La bonificación depende de los beneficios empresariales y de los requisitos legales; el importe debe verificarse. Vacaciones y pagos pendientes requieren datos reales. El salario de Navidad puede estar sujeto a límite legal y pagos anteriores. Las indemnizaciones judiciales no se calculan aquí. Contrasta el resultado con la <a href="https://calculo.mt.gob.do/" target="_blank" rel="noopener noreferrer">calculadora del Ministerio de Trabajo</a> y con un profesional cuando corresponda.</div>
      </section>
    </div>

    <article class="card article">
      <h2>¿Cómo calcular las prestaciones laborales en RD?</h2>
      <p>
        Las prestaciones laborales en República Dominicana
        dependen del tiempo trabajado, el salario ordinario
        y la causa de terminación del contrato.
        Su regulación principal está contenida en el
        Código de Trabajo dominicano.
      </p>

      <h2>¿Cuántos días corresponden de preaviso?</h2>
      <p>
        El artículo 76 del Código de Trabajo establece
        períodos generales de 7 días para una antigüedad
        desde tres hasta menos de seis meses,
        14 días desde seis meses hasta menos de un año,
        y 28 días a partir de un año.
      </p>

      <h2>¿Cómo se calcula la cesantía?</h2>
      <p>
        El artículo 80 establece escalas de cesantía
        según la duración del contrato. Para períodos
        desde tres meses hasta menos de un año,
        se contemplan 6 o 13 días, según corresponda.
        Para contratos de un año o más se aplican
        las escalas de 21 o 23 días por año,
        además de las reglas para fracciones.
      </p>

      <h2>¿Qué es el salario de Navidad?</h2>
      <p>
        Es la duodécima parte del salario ordinario
        devengado durante el año calendario, sujeto
        a los límites y condiciones de la legislación.
      </p>

      <h2>¿La renuncia genera cesantía?</h2>
      <p>
        La renuncia voluntaria ordinaria no genera
        automáticamente auxilio de cesantía.
        Sin embargo, pueden corresponder derechos
        adquiridos y otras cantidades pendientes.
      </p>

      <h2>¿Dónde verificar las prestaciones laborales?</h2>
      <p>
        Consulta la
        <a href="https://calculo.mt.gob.do/"
           target="_blank"
           rel="noopener noreferrer">
          herramienta oficial del Ministerio de Trabajo
        </a>
        para contrastar los resultados.
      </p>
    </article>
  </main>

  <footer>
    <p>© 2026 República Actual</p>
    <a href="/">Volver al periódico</a>
  </footer>

  <script>
    const campo = (id: string) => document.getElementById(id) as HTMLInputElement;
    const formato = (n: number) => new Intl.NumberFormat('es-DO', {style:'currency', currency:'DOP'}).format(n);
    const numero = (id: string) => { const raw=campo(id).value.trim(); const n=raw===''?0:Number(raw); if (!Number.isFinite(n)||n<0) throw new Error('Revisa el valor de '+campo(id).previousElementSibling?.textContent); return n; };
    const leerFecha = (v: string) => { if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return null; const [y,m,d]=v.split('-').map(Number); const f=new Date(Date.UTC(y,m-1,d)); return f.getUTCFullYear()===y&&f.getUTCMonth()===m-1&&f.getUTCDate()===d?f:null; };
    const sumarMeses = (fecha: Date, meses: number) => { const y=fecha.getUTCFullYear(),m=fecha.getUTCMonth()+meses,d=fecha.getUTCDate(); const primer=new Date(Date.UTC(y,m,1)); const ultimo=new Date(Date.UTC(primer.getUTCFullYear(),primer.getUTCMonth()+1,0)).getUTCDate(); return new Date(Date.UTC(primer.getUTCFullYear(),primer.getUTCMonth(),Math.min(d,ultimo))); };
    function mesesCompletos(a: Date,b: Date) { let n=(b.getUTCFullYear()-a.getUTCFullYear())*12+b.getUTCMonth()-a.getUTCMonth(); while(n>0&&sumarMeses(a,n)>b)n--; return Math.max(0,n); }
    function diasCesantia(meses: number) { if(meses<3)return 0; if(meses<6)return 6; if(meses<12)return 13; const anos=Math.floor(meses/12),resto=meses%12; const base=meses>=60?23:21; return anos*base+(resto>=6?13:resto>=3?6:0); }
    function calcular(event: Event) {
      event.preventDefault(); campo('error').textContent='';
      try {
        const salario=numero('salario'),inicio=leerFecha(campo('inicio').value),fin=leerFecha(campo('fin').value);
        if(salario<=0||!inicio||!fin||fin<inicio) throw new Error('Verifica salario y fechas: la salida debe ser igual o posterior al ingreso.');
        const meses=mesesCompletos(inicio,fin),diario=salario/23.83,tipo=campo('tipo').value;
        const elegible=['desahucio','injustificado','dimension'].includes(tipo);
        const diasAviso=meses>=12?28:meses>=6?14:meses>=3?7:0;
        const preaviso=elegible&&campo('aviso').value==='no'?diasAviso*diario:0;
        const cesantia=elegible?diasCesantia(meses)*diario:0;
        const inicioAno=new Date(Date.UTC(fin.getUTCFullYear(),0,1));
        const comienzo=inicio>inicioAno?inicio:inicioAno;
        const diasTrabajados=(fin.getTime()-comienzo.getTime())/86400000+1;
        const diasAno=(Date.UTC(fin.getUTCFullYear()+1,0,1)-inicioAno.getTime())/86400000;
        const devengado=campo('devengado').value.trim()===''?salario*12*diasTrabajados/diasAno:numero('devengado');
        const navidadBruta=devengado/12;
        const tope=campo('navidadTope').value.trim()===''?Infinity:numero('navidadTope');
        const navidad=Math.max(0,Math.min(navidadBruta,tope)-numero('navidadPagada'));
        const vacaciones=numero('vacaciones')*diario;
        const bonificacion=numero('bonificacion');
        const salarios=numero('salariosPendientes'),comisiones=numero('comisiones'),extras=numero('extras'),otros=numero('otros'),descuentos=numero('descuentos');
        const total=preaviso+cesantia+navidad+vacaciones+bonificacion+salarios+comisiones+extras+otros-descuentos;
        const valores={preaviso,cesantia,navidad,vacacionesResultado:vacaciones,bonificacionResultado:bonificacion,salariosResultado:salarios,comisionesResultado:comisiones,extrasResultado:extras,otrosResultado:otros,descuentosResultado:-descuentos,total};
        for(const [id,n] of Object.entries(valores)) campo(id).textContent=formato(n);
        campo('antiguedad').textContent=`${meses} meses completos de servicio`;
        campo('detalleCalculo').textContent=`Salario diario orientativo: ${formato(diario)}. Preaviso: ${elegible?diasAviso:0} días si no se otorgó. Cesantía: ${elegible?diasCesantia(meses):0} días. Navidad bruta: ${formato(navidadBruta)}. ${tipo==='injustificado'||tipo==='dimension'?'La procedencia de estos conceptos debe validarse según la decisión o situación legal.':''}`;
      } catch(e) {campo('error').textContent=e instanceof Error?e.message:'No fue posible calcular.';}
    }
    campo('formulario').addEventListener('submit',calcular);
    campo('tipo').addEventListener('change',()=>{campo('grupoAviso').hidden=!['desahucio','injustificado','dimension'].includes(campo('tipo').value);});
    campo('imprimir').addEventListener('click',()=>window.print());
  </script>
</body>
</html>
