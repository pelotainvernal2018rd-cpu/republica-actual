---
import Layout from '../layouts/Layout.astro';

const hoyISO = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Santo_Domingo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(new Date());

const hoy = new Intl.DateTimeFormat('es-DO', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Santo_Domingo'
}).format(new Date());

const loterias = [
  { id:'loteria-nacional-noche', nombre:'Lotería Nacional', grupo:'rd', horario:'Noche' },
  { id:'leidsa-noche', nombre:'LEIDSA', grupo:'rd', horario:'Noche' },
  { id:'loteria-real-mediodia', nombre:'Lotería Real', grupo:'rd', horario:'Mediodía' },
  { id:'loteka-noche', nombre:'Loteka', grupo:'rd', horario:'Noche' },
  { id:'la-primera-mediodia', nombre:'La Primera', grupo:'rd', horario:'Mediodía' },
  { id:'la-suerte-mediodia', nombre:'La Suerte', grupo:'rd', horario:'Mediodía' },
  { id:'lotedom-mediodia', nombre:'LoteDom', grupo:'rd', horario:'Mediodía' },

  { id:'king-lottery-mediodia', nombre:'King Lottery', grupo:'otras', horario:'Mediodía' },
  { id:'anguila-noche', nombre:'Anguila', grupo:'otras', horario:'Noche' },

  { id:'new-york-dia', nombre:'New York Día', grupo:'usa', horario:'Tarde' },
  { id:'new-york-noche', nombre:'New York Noche', grupo:'usa', horario:'Noche' },
  { id:'florida-dia', nombre:'Florida Día', grupo:'usa', horario:'Tarde' },
  { id:'florida-noche', nombre:'Florida Noche', grupo:'usa', horario:'Noche' },
  { id:'new-jersey-noche', nombre:'Americanas (New Jersey Noche)', grupo:'usa', horario:'Noche' },

  { id:'haiti-bolet-noche', nombre:'Haití Bolet', grupo:'otras', horario:'Noche' }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'República Actual',
      item: 'https://republicaactual.net/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Resultados de Loterías',
      item: 'https://republicaactual.net/resultados-loterias/'
    }
  ]
};
---

<Layout
  title="Resultados de Loterías de Hoy en RD | República Actual"
  description="Resultados de loterías de hoy en República Dominicana. Consulta Lotería Nacional, LEIDSA, Loteka, Lotería Real, La Primera, La Suerte, LoteDom, New York, Florida y más."
>

<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

<main class="pagina-loterias">

  <section class="hero">
    <div class="contenedor">

      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <span>Resultados de Loterías</span>
      </nav>

      <span class="etiqueta">RESULTADOS ACTUALIZADOS</span>

      <h1>Resultados de Loterías de Hoy</h1>

      <p class="intro">
        Consulta los resultados de las principales loterías de
        República Dominicana, Estados Unidos y otros sorteos
        populares.
      </p>

      <div class="fecha">
        📅 {hoy}
      </div>

    </div>
  </section>


  <div class="contenedor cuerpo">

    <section class="barra-estado">

      <div>
        <span class="live"></span>

        <strong id="estado-resultados">
          Resultados de hoy: esperando sorteos
        </strong>
      </div>

      <span id="ultima-actualizacion">
        Actualización automática cada 5 minutos
      </span>

    </section>


    <section class="herramientas">

      <div class="buscador">
        <span>🔎</span>

        <input
          id="buscar-loteria"
          type="search"
          placeholder="Buscar lotería..."
          aria-label="Buscar lotería"
        />
      </div>

      <div class="filtros">
        <button class="activo" data-filtro="Todas">Todas</button>
        <button data-filtro="Mañana">Mañana</button>
        <button data-filtro="Mediodía">Mediodía</button>
        <button data-filtro="Tarde">Tarde</button>
        <button data-filtro="Noche">Noche</button>
      </div>

    </section>


    <section class="bloque">

      <div class="titulo-seccion">
        <div>

          <span class="icono">🇩🇴</span>

          <div>
            <h2>Loterías de República Dominicana</h2>
            <p>Resultados de los principales sorteos dominicanos.</p>
          </div>

        </div>
      </div>

      <div class="grid">

        {
          loterias
            .filter(l => l.grupo === 'rd')
            .map(loteria => (

              <article
                class="tarjeta"
                data-id={loteria.id}
                data-nombre={loteria.nombre.toLowerCase()}
                data-horario={loteria.horario}
              >

                <div class="cabecera">

                  <div>
                    <h3>{loteria.nombre}</h3>

                    <span class="fecha-resultado">
                      Resultado de hoy pendiente
                    </span>
                  </div>

                  <span class="hora">
                    {loteria.horario}
                  </span>

                </div>

                <div class="numeros">

                  <div class="numero">
                    <strong>--</strong>
                    <span>1ro</span>
                  </div>

                  <div class="numero">
                    <strong>--</strong>
                    <span>2do</span>
                  </div>

                  <div class="numero">
                    <strong>--</strong>
                    <span>3ro</span>
                  </div>

                </div>

                <div class="pie">
                  <span class="pendiente">
                    ⏳ Pendiente de resultado
                  </span>
                </div>

              </article>

            ))
        }

      </div>

    </section>


    <section class="bloque">

      <div class="titulo-seccion">
        <div>

          <span class="icono">🇺🇸</span>

          <div>
            <h2>Resultados New York y Florida</h2>

            <p>
              Sorteos estadounidenses consultados diariamente
              desde República Dominicana.
            </p>
          </div>

        </div>
      </div>

      <div class="grid">

        {
          loterias
            .filter(l => l.grupo === 'usa')
            .map(loteria => (

              <article
                class="tarjeta"
                data-id={loteria.id}
                data-nombre={loteria.nombre.toLowerCase()}
                data-horario={loteria.horario}
              >

                <div class="cabecera">

                  <div>
                    <h3>{loteria.nombre}</h3>

                    <span class="fecha-resultado">
                      Resultado de hoy pendiente
                    </span>
                  </div>

                  <span class="hora">
                    {loteria.horario}
                  </span>

                </div>

                <div class="numeros">

                  <div class="numero">
                    <strong>--</strong>
                    <span>1ro</span>
                  </div>

                  <div class="numero">
                    <strong>--</strong>
                    <span>2do</span>
                  </div>

                  <div class="numero">
                    <strong>--</strong>
                    <span>3ro</span>
                  </div>

                </div>

                <div class="pie">
                  <span class="pendiente">
                    ⏳ Pendiente de resultado
                  </span>
                </div>

              </article>

            ))
        }

      </div>

    </section>


    <section class="bloque">

      <div class="titulo-seccion">
        <div>

          <span class="icono">🌎</span>

          <div>
            <h2>Otros sorteos populares</h2>

            <p>
              Resultados adicionales consultados por jugadores
              de República Dominicana.
            </p>
          </div>

        </div>
      </div>

      <div class="grid">

        {
          loterias
            .filter(l => l.grupo === 'otras')
            .map(loteria => (

              <article
                class="tarjeta"
                data-id={loteria.id}
                data-nombre={loteria.nombre.toLowerCase()}
                data-horario={loteria.horario}
              >

                <div class="cabecera">

                  <div>
                    <h3>{loteria.nombre}</h3>

                    <span class="fecha-resultado">
                      Resultado de hoy pendiente
                    </span>
                  </div>

                  <span class="hora">
                    {loteria.horario}
                  </span>

                </div>

                <div class="numeros">

                  <div class="numero">
                    <strong>--</strong>
                    <span>1ro</span>
                  </div>

                  <div class="numero">
                    <strong>--</strong>
                    <span>2do</span>
                  </div>

                  <div class="numero">
                    <strong>--</strong>
                    <span>3ro</span>
                  </div>

                </div>

                <div class="pie">
                  <span class="pendiente">
                    ⏳ Pendiente de resultado
                  </span>
                </div>

              </article>

            ))
        }

      </div>

    </section>


    <section class="seo">

      <h2>
        Resultados de loterías de hoy en República Dominicana
      </h2>

      <p>
        En República Actual puedes consultar los resultados de
        las loterías de hoy de República Dominicana de manera
        rápida y organizada. Esta sección reúne los números
        ganadores de los principales sorteos nacionales e
        internacionales consultados por los dominicanos.
      </p>

      <p>
        Aquí podrás encontrar resultados de la Lotería Nacional,
        LEIDSA, Loteka, Lotería Real, La Primera, La Suerte y
        LoteDom, además de resultados de New York, Florida,
        King Lottery, Anguila y otros sorteos populares.
      </p>

      <h2>¿A qué hora se actualizan los resultados?</h2>

      <p>
        Los resultados se actualizarán durante el día a medida
        que sean publicados los diferentes sorteos. Cada tarjeta
        indicará cuándo un resultado se encuentre disponible.
      </p>

      <h2>Resultados de loterías dominicanas</h2>

      <p>
        República Actual organizará los resultados por lotería
        y horario para facilitar la consulta desde teléfonos,
        computadoras y otros dispositivos. También podrás buscar
        rápidamente una lotería utilizando el buscador disponible
        en esta página.
      </p>

      <div class="aviso">
        <strong>Importante:</strong>
        Los resultados mostrados en República Actual tienen
        carácter informativo. Para reclamaciones, validación de
        jugadas o pago de premios debe utilizarse siempre el
        resultado oficial de la entidad correspondiente.
      </div>

    </section>

  </div>

</main>


<script define:vars={{ hoyISO }} is:inline>

document.addEventListener('DOMContentLoaded', function () {

  var PROJECT_ID = 'republica-actual';

  var FIRESTORE_URL =
    'https://firestore.googleapis.com/v1/projects/' +
    PROJECT_ID +
    '/databases/(default)/documents/resultados_loterias?pageSize=300';

  var buscador =
    document.getElementById('buscar-loteria');

  var botones =
    Array.prototype.slice.call(
      document.querySelectorAll('[data-filtro]')
    );

  var tarjetas =
    Array.prototype.slice.call(
      document.querySelectorAll('.tarjeta')
    );

  var filtroActual = 'Todas';


  function valorFirestore(valor) {

    if (!valor) return null;

    if ('stringValue' in valor) {
      return valor.stringValue;
    }

    if ('booleanValue' in valor) {
      return valor.booleanValue;
    }

    if ('integerValue' in valor) {
      return Number(valor.integerValue);
    }

    if ('doubleValue' in valor) {
      return Number(valor.doubleValue);
    }

    if (valor.arrayValue) {
      return (valor.arrayValue.values || [])
        .map(valorFirestore);
    }

    return null;
  }


  function documentoAObjeto(doc) {

    var salida = {};

    var fields = doc.fields || {};

    Object.keys(fields).forEach(function (key) {
      salida[key] = valorFirestore(fields[key]);
    });

    salida.__id =
      String(doc.name || '').split('/').pop();

    return salida;
  }


  function normalizar(texto) {

    return String(texto || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }


  function fechaBonita(fecha) {

    var partes = String(fecha || '').split('-');

    if (partes.length !== 3) {
      return fecha;
    }

    var fechaLocal = new Date(
      Number(partes[0]),
      Number(partes[1]) - 1,
      Number(partes[2])
    );

    return new Intl.DateTimeFormat(
      'es-DO',
      {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }
    ).format(fechaLocal);
  }


  /*
   * Esta función relaciona el resultado real
   * de Firestore con UNA de las 15 tarjetas.
   *
   * Lo más importante:
   * solamente acepta documentos DE HOY.
   */
  function buscarResultadoParaTarjeta(
    tarjeta,
    resultados
  ) {

    var id =
      tarjeta.getAttribute('data-id') || '';

    var nombre =
      normalizar(
        tarjeta.getAttribute('data-nombre')
      );

    var horario =
      tarjeta.getAttribute('data-horario') || '';


    var candidatos =
      resultados.filter(function (r) {

        var fecha =
          String(
            r.fecha ||
            r.fecha_resultado ||
            ''
          );

        if (fecha !== hoyISO) {
          return false;
        }

        var operador =
          normalizar(r.operador);

        var sorteo =
          normalizar(
            r.sorteo ||
            r.nombre
          );

        var texto =
          operador + ' ' + sorteo;

        if (
          id === 'loteria-nacional-noche'
        ) {
          return (
            texto.indexOf('loteria nacional') !== -1 &&
            (
              normalizar(r.horario) === 'noche' ||
              sorteo.indexOf('nacional') !== -1
            )
          );
        }

        if (id === 'leidsa-noche') {
          return (
            texto.indexOf('leidsa') !== -1 &&
            (
              sorteo.indexOf('quiniela') !== -1 ||
              normalizar(r.horario) === 'noche'
            )
          );
        }

        if (
          id === 'loteria-real-mediodia'
        ) {
          return (
            texto.indexOf('loteria real') !== -1 &&
            (
              normalizar(r.horario) === 'mediodia' ||
              sorteo.indexOf('quiniela real') !== -1
            )
          );
        }

        if (id === 'loteka-noche') {
          return (
            texto.indexOf('loteka') !== -1 &&
            (
              sorteo.indexOf('quiniela') !== -1 ||
              normalizar(r.horario) === 'noche'
            )
          );
        }

        if (
          id === 'la-primera-mediodia'
        ) {
          return (
            texto.indexOf('la primera') !== -1 &&
            (
              normalizar(r.horario) === 'mediodia' ||
              sorteo.indexOf('primera dia') !== -1 ||
              sorteo.indexOf('primera mediodia') !== -1
            )
          );
        }

        if (
          id === 'la-suerte-mediodia'
        ) {
          return (
            texto.indexOf('la suerte') !== -1 &&
            (
              normalizar(r.horario) === 'mediodia' ||
              sorteo.indexOf('quiniela') !== -1
            )
          );
        }

        if (
          id === 'lotedom-mediodia'
        ) {
          return (
            texto.indexOf('lotedom') !== -1 &&
            (
              sorteo.indexOf('quiniela') !== -1 ||
              normalizar(r.horario) === 'mediodia'
            )
          );
        }

        if (
          id === 'king-lottery-mediodia'
        ) {
          return (
            texto.indexOf('king lottery') !== -1 &&
            (
              normalizar(r.horario) === 'mediodia' ||
              texto.indexOf('12 30') !== -1
            )
          );
        }

        if (id === 'anguila-noche') {
          return (
            texto.indexOf('anguila') !== -1 &&
            normalizar(r.horario) === 'noche'
          );
        }

        if (id === 'new-york-dia') {
          return (
            texto.indexOf('new york') !== -1 &&
            (
              normalizar(r.horario) === 'tarde' ||
              normalizar(r.horario) === 'mediodia' ||
              sorteo.indexOf('midday') !== -1 ||
              sorteo.indexOf('dia') !== -1
            )
          );
        }

        if (id === 'new-york-noche') {
          return (
            texto.indexOf('new york') !== -1 &&
            (
              normalizar(r.horario) === 'noche' ||
              sorteo.indexOf('evening') !== -1
            )
          );
        }

        if (id === 'florida-dia') {
          return (
            texto.indexOf('florida') !== -1 &&
            (
              normalizar(r.horario) === 'tarde' ||
              normalizar(r.horario) === 'mediodia' ||
              sorteo.indexOf('midday') !== -1 ||
              sorteo.indexOf('dia') !== -1
            )
          );
        }

        if (id === 'florida-noche') {
          return (
            texto.indexOf('florida') !== -1 &&
            (
              normalizar(r.horario) === 'noche' ||
              sorteo.indexOf('evening') !== -1
            )
          );
        }

        if (id === 'new-jersey-noche') {
          return (
            texto.indexOf('new jersey') !== -1 &&
            (
              normalizar(r.horario) === 'noche' ||
              sorteo.indexOf('evening') !== -1
            )
          );
        }

        if (
          id === 'haiti-bolet-noche'
        ) {
          return (
            (
              texto.indexOf('haiti') !== -1 ||
              texto.indexOf('bolet') !== -1
            ) &&
            normalizar(r.horario) === 'noche'
          );
        }

        return texto.indexOf(nombre) !== -1;
      });


    if (!candidatos.length) {
      return null;
    }


    /*
     * Solo aceptamos resultados con mínimo
     * tres números válidos.
     */
    candidatos =
      candidatos.filter(function (r) {

        return (
          Array.isArray(r.numeros) &&
          r.numeros.length >= 3
        );
      });


    if (!candidatos.length) {
      return null;
    }


    return candidatos[0];
  }


  function actualizarTarjeta(
    tarjeta,
    resultado
  ) {

    if (!resultado) {
      return;
    }

    var numeros =
      resultado.numeros.slice(0, 3);

    var circulos =
      tarjeta.querySelectorAll(
        '.numero strong'
      );

    numeros.forEach(function (numero, i) {

      if (circulos[i]) {

        circulos[i].textContent =
          String(numero)
            .padStart(2, '0');
      }
    });


    var fecha =
      tarjeta.querySelector(
        '.fecha-resultado'
      );

    if (fecha) {

      fecha.textContent =
        'Resultado del ' +
        fechaBonita(hoyISO);
    }


    var estado =
      tarjeta.querySelector(
        '.pendiente'
      );

    if (estado) {

      estado.textContent =
        '✓ Resultado publicado';

      estado.classList.add(
        'publicado'
      );
    }
  }


  function aplicarFiltros() {

    var texto = '';

    if (buscador) {

      texto =
        String(
          buscador.value || ''
        )
          .toLowerCase()
          .trim();
    }


    tarjetas.forEach(function (tarjeta) {

      var nombre =
        String(
          tarjeta.getAttribute(
            'data-nombre'
          ) || ''
        );


      var horario =
        String(
          tarjeta.getAttribute(
            'data-horario'
          ) || ''
        );


      var coincideNombre =
        nombre.indexOf(texto) !== -1;


      var coincideHorario =
        filtroActual === 'Todas' ||
        horario === filtroActual;


      tarjeta.style.display =
        coincideNombre &&
        coincideHorario
          ? ''
          : 'none';
    });
  }


  fetch(FIRESTORE_URL)

    .then(function (respuesta) {

      if (!respuesta.ok) {

        throw new Error(
          'Firestore HTTP ' +
          respuesta.status
        );
      }

      return respuesta.json();
    })

    .then(function (data) {

      var resultados =
        (data.documents || [])
          .map(documentoAObjeto);


      /*
       * DOBLE PROTECCIÓN:
       * eliminamos aquí todo lo que no sea hoy.
       */
      var resultadosHoy =
        resultados.filter(function (r) {

          var fecha =
            String(
              r.fecha ||
              r.fecha_resultado ||
              ''
            );

          return fecha === hoyISO;
        });


      var publicados = 0;


      tarjetas.forEach(function (tarjeta) {

        var resultado =
          buscarResultadoParaTarjeta(
            tarjeta,
            resultadosHoy
          );


        if (resultado) {

          actualizarTarjeta(
            tarjeta,
            resultado
          );

          publicados++;
        }
      });


      var estado =
        document.getElementById(
          'estado-resultados'
        );


      if (estado) {

        estado.textContent =
          publicados > 0
            ? 'Resultados de hoy disponibles: ' +
              publicados +
              ' de ' +
              tarjetas.length
            : 'Resultados de hoy: esperando sorteos';
      }


      var actualizacion =
        document.getElementById(
          'ultima-actualizacion'
        );


      if (actualizacion) {

        actualizacion.textContent =
          'Actualización automática activa';
      }

    })

    .catch(function (error) {

      console.error(
        'Error cargando resultados:',
        error
      );


      var estado =
        document.getElementById(
          'estado-resultados'
        );


      if (estado) {

        estado.textContent =
          'Resultados temporalmente no disponibles';
      }

    });


  if (buscador) {

    buscador.addEventListener(
      'input',
      aplicarFiltros
    );
  }


  botones.forEach(function (boton) {

    boton.addEventListener(
      'click',
      function () {

        filtroActual =
          boton.getAttribute(
            'data-filtro'
          ) ||
          'Todas';


        botones.forEach(
          function (otroBoton) {

            otroBoton.classList.remove(
              'activo'
            );
          }
        );


        boton.classList.add(
          'activo'
        );


        aplicarFiltros();
      }
    );
  });


  aplicarFiltros();

});

</script>


<style>

.pagina-loterias {
  background:#f5f6f8;
  min-height:100vh;
  color:#162235;
}

.contenedor {
  width:min(1180px,calc(100% - 32px));
  margin:auto;
}

.hero {
  background:
    linear-gradient(
      135deg,
      #061a31,
      #0a3765 55%,
      #07518c
    );
  color:white;
  padding:32px 0 42px;
}

.breadcrumb {
  display:flex;
  gap:8px;
  font-size:14px;
  margin-bottom:22px;
  color:#cbd7e4;
}

.breadcrumb a {
  color:white;
  text-decoration:none;
}

.etiqueta {
  display:inline-block;
  font-size:11px;
  font-weight:800;
  letter-spacing:.8px;
  background:#e71d36;
  padding:6px 9px;
  border-radius:5px;
  margin-bottom:12px;
}

.hero h1 {
  font-size:clamp(31px,5vw,50px);
  line-height:1.08;
  margin:0;
