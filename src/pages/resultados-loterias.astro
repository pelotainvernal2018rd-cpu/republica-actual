---
import Layout from '../layouts/Layout.astro';

const hoy = new Intl.DateTimeFormat('es-DO', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
  timeZone: 'America/Santo_Domingo'
}).format(new Date());

const operadores = [
  'Todas','LEIDSA','Lotería Nacional','Loteka','Lotería Real','La Primera','La Suerte','LoteDom',
  'Anguila','King Lottery','New York','Florida','Powerball','Mega Millions'
];

const juegos = [
  {id:'loteria-nacional-noche', operador:'Lotería Nacional', juego:'Lotería Nacional Noche', horario:'Noche', hora:'9:00 PM'},
  {id:'leidsa-noche', operador:'LEIDSA', juego:'Quiniela LEIDSA', horario:'Noche', hora:'8:55 PM'},
  {id:'loteria-real-mediodia', operador:'Lotería Real', juego:'Quiniela Real', horario:'Mediodía', hora:'12:55 PM'},
  {id:'loteka-noche', operador:'Loteka', juego:'Quiniela Loteka', horario:'Noche', hora:'7:55 PM'},
  {id:'loteka-mega-chances', operador:'Loteka', juego:'Mega Chances', horario:'Noche', hora:'7:55 PM'},
  {id:'loteka-megalotto', operador:'Loteka', juego:'MegaLotto', horario:'Noche', hora:'7:55 PM'},
  {id:'loteka-chance-express', operador:'Loteka', juego:'Chance Express', horario:'Tarde', hora:'5:15 PM'},
  {id:'la-primera-noche', operador:'La Primera', juego:'La Primera Noche', horario:'Noche', hora:'7:50 PM'},
  {id:'la-primera-loto5', operador:'La Primera', juego:'Loto 5', horario:'Noche', hora:'7:50 PM'},
  {id:'la-suerte-mediodia', operador:'La Suerte', juego:'La Suerte', horario:'Mediodía', hora:''},
  {id:'lotedom-mediodia', operador:'LoteDom', juego:'Quiniela LoteDom', horario:'Noche', hora:'8:00 PM'},
  {id:'lotedom-quemaito', operador:'LoteDom', juego:'El Quemaito Mayor', horario:'Noche', hora:'8:00 PM'},
  {id:'king-lottery-mediodia', operador:'King Lottery', juego:'King Lottery', horario:'Noche', hora:'7:30 PM'},
  {id:'anguila-noche', operador:'Anguila', juego:'Anguila', horario:'Noche', hora:''},
  {id:'new-york-dia', operador:'New York', juego:'New York Día', horario:'Tarde', hora:''},
  {id:'new-york-noche', operador:'New York', juego:'New York Noche', horario:'Noche', hora:''},
  {id:'florida-dia', operador:'Florida', juego:'Florida Día', horario:'Tarde', hora:''},
  {id:'florida-noche', operador:'Florida', juego:'Florida Noche', horario:'Noche', hora:'9:45 PM'},
  {id:'powerball', operador:'Powerball', juego:'Powerball', horario:'Noche', hora:''},
  {id:'mega-millions', operador:'Mega Millions', juego:'Mega Millions', horario:'Noche', hora:''}
];

const schema = {
  '@context':'https://schema.org', '@type':'WebPage',
  name:'Resultados de Loterías de Hoy',
  url:'https://republicaactual.net/resultados-loterias/',
  description:'Resultados de loterías de hoy en República Dominicana, New York, Florida y otros sorteos.'
};
---

<Layout title="Resultados de Loterías de Hoy en RD | República Actual" description="Resultados de loterías de hoy en República Dominicana. Consulta LEIDSA, Lotería Nacional, Loteka, Lotería Real, La Primera, La Suerte, LoteDom, New York, Florida y más.">
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

<main class="lottery-page">
  <section class="hero">
    <div class="wrap">
      <nav class="crumb"><a href="/">Inicio</a><span>›</span><span>Resultados de Loterías</span></nav>
      <div class="hero-grid">
        <div>
          <span class="eyebrow">REPÚBLICA ACTUAL • LOTERÍAS</span>
          <h1>Resultados de las loterías de hoy</h1>
          <p class="today">{hoy}</p>
          <p class="lead">Consulta en un solo lugar los sorteos dominicanos y los principales resultados internacionales.</p>
        </div>
        <div class="next-box">
          <span class="next-label">PRÓXIMO SORTEO</span>
          <strong id="proximo-nombre">Calculando...</strong>
          <span id="proximo-hora">Horario de República Dominicana</span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap content">
    <section class="statusbar">
      <div><span class="pulse"></span><strong>Resultados en actualización automática</strong></div>
      <span id="ultima-actualizacion">Consultando resultados...</span>
    </section>

    <section class="filters-panel">
      <div class="filter-title">Filtrar por operador</div>
      <div class="operator-scroll" id="operadores">
        {operadores.map((op, i) => <button class:list={['operator-btn', {active:i===0}]} data-operador={op}>{op}</button>)}
      </div>
      <div class="schedule-row">
        <strong>Horario</strong>
        <div class="schedule-buttons">
          {['Todas','Mañana','Mediodía','Tarde','Noche'].map((h,i) => <button class:list={['schedule-btn',{active:i===0}]} data-horario={h}>{h}</button>)}
        </div>
      </div>
    </section>

    <section class="results-head">
      <div><h2>Últimos resultados</h2><p>Los sorteos pendientes se actualizan automáticamente cuando son confirmados.</p></div>
      <div class="search"><span>⌕</span><input id="buscar" type="search" placeholder="Buscar lotería o sorteo" /></div>
    </section>

    <div id="resultados" class="operator-groups">
      {Array.from(new Set(juegos.map(j=>j.operador))).map(operador => (
        <section class="operator-group" data-grupo-operador={operador}>
          <div class="operator-heading">
            <div class="operator-mark">{operador.slice(0,2).toUpperCase()}</div>
            <div><h2>{operador}</h2><span>{juegos.filter(j=>j.operador===operador).length} sorteos disponibles</span></div>
          </div>
          <div class="cards-grid">
            {juegos.filter(j=>j.operador===operador).map(j => (
              <article class="result-card" data-id={j.id} data-operador={j.operador} data-juego={j.juego} data-horario={j.horario} data-hora={j.hora}>
                <div class="card-top">
                  <div><h3>{j.juego}</h3><span class="meta"><b>{j.horario}</b>{j.hora ? ` · ${j.hora}` : ''}</span></div>
                  <span class="state pending">Pendiente</span>
                </div>
                <div class="balls"><span>--</span><span>--</span><span>--</span></div>
                <div class="card-bottom"><span class="result-date">Esperando resultado de hoy</span><span class="verified">⏳</span></div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="seo-box">
      <h2>Resultados de loterías de hoy en República Dominicana</h2>
      <p>República Actual reúne los resultados de las principales loterías consultadas por jugadores dominicanos. Esta página se actualiza automáticamente a medida que los sorteos son confirmados.</p>
      <p><strong>Importante:</strong> los resultados publicados tienen carácter informativo. Para validar jugadas, reclamar o cobrar premios debe utilizarse siempre la información oficial de la entidad correspondiente.</p>
    </section>
  </div>
</main>

<script>
  const PROJECT_ID = 'republica-actual';
  const COLLECTION = 'resultados_loterias';
  const API = `https://firestore.googleapis.com/v1/projects/${PROJECT_ID}/databases/(default)/documents/${COLLECTION}?pageSize=300`;

  let filtroOperador = 'Todas';
  let filtroHorario = 'Todas';

  function hoyRD() {
    return new Intl.DateTimeFormat('en-CA',{timeZone:'America/Santo_Domingo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  }

  function decode(v) {
    if (!v) return null;
    if ('stringValue' in v) return v.stringValue;
    if ('booleanValue' in v) return v.booleanValue;
    if ('integerValue' in v) return Number(v.integerValue);
    if ('doubleValue' in v) return Number(v.doubleValue);
    if ('timestampValue' in v) return v.timestampValue;
    if ('arrayValue' in v) return (v.arrayValue.values || []).map(decode);
    if ('mapValue' in v) return decodeFields(v.mapValue.fields || {});
    return null;
  }
  function decodeFields(fields) { const out={}; for (const [k,v] of Object.entries(fields||{})) out[k]=decode(v); return out; }

  function normal(s='') { return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim(); }

  function aplicarFiltros() {
    const q = normal(document.querySelector('#buscar')?.value || '');
    document.querySelectorAll('.result-card').forEach(card => {
      const op = card.getAttribute('data-operador') || '';
      const hor = card.getAttribute('data-horario') || '';
      const texto = normal((card.getAttribute('data-juego')||'')+' '+op);
      const okOp = filtroOperador==='Todas' || op===filtroOperador;
      const okHor = filtroHorario==='Todas' || hor===filtroHorario;
      card.style.display = okOp && okHor && (!q || texto.includes(q)) ? '' : 'none';
    });
    document.querySelectorAll('.operator-group').forEach(group => {
      const visibles = [...group.querySelectorAll('.result-card')].some(c => c.style.display !== 'none');
      group.style.display = visibles ? '' : 'none';
    });
  }

  document.querySelectorAll('.operator-btn').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.operator-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active');
    filtroOperador = btn.getAttribute('data-operador') || 'Todas'; aplicarFiltros();
  }));
  document.querySelectorAll('.schedule-btn').forEach(btn => btn.addEventListener('click', () => {
    document.querySelectorAll('.schedule-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active');
    filtroHorario = btn.getAttribute('data-horario') || 'Todas'; aplicarFiltros();
  }));
  document.querySelector('#buscar')?.addEventListener('input', aplicarFiltros);

  function candidatosPara(card, docs) {
    const id = card.getAttribute('data-id') || '';
    const operador = normal(card.getAttribute('data-operador') || '');
    const juego = normal(card.getAttribute('data-juego') || '');
    const hoy = hoyRD();
    return docs.filter(r => {
      const fecha = String(r.fecha || r.fecha_resultado || '');
      if (fecha !== hoy) return false;
      if (r.verificado_hoy !== true) return false;
      if (!Array.isArray(r.numeros) || !r.numeros.length) return false;
      if (r.__id === id) return true;
      return normal(r.operador || r.loteria || '') === operador && normal(r.sorteo || r.juego || '') === juego;
    });
  }

  function pintar(card, r) {
    const nums = (r.numeros || []).map(n=>String(n).padStart(2,'0'));
    const balls = card.querySelector('.balls');
    if (balls) balls.innerHTML = nums.map(n=>`<span>${n}</span>`).join('');
    const state = card.querySelector('.state');
    if (state) { state.textContent='Publicado'; state.classList.remove('pending'); state.classList.add('published'); }
    const date = card.querySelector('.result-date');
    if (date) date.textContent = 'Resultado confirmado de hoy';
    const verified = card.querySelector('.verified'); if (verified) verified.textContent='✓ Verificado';
  }

  async function cargar() {
    try {
      const res = await fetch(API,{cache:'no-store'});
      if (!res.ok) throw new Error('Firestore '+res.status);
      const data = await res.json();
      const docs = (data.documents || []).map(d => ({__id:d.name.split('/').pop(), ...decodeFields(d.fields||{})}));
      let publicados=0;
      document.querySelectorAll('.result-card').forEach(card => {
        const cand = candidatosPara(card,docs);
        if (cand.length) { pintar(card,cand[0]); publicados++; }
      });
      const u=document.querySelector('#ultima-actualizacion');
      if(u) u.textContent = publicados ? `${publicados} sorteos confirmados hoy` : 'Esperando los sorteos de hoy';
    } catch(e) {
      const u=document.querySelector('#ultima-actualizacion'); if(u) u.textContent='No fue posible actualizar en este momento';
      console.error(e);
    }
  }

  function calcularProximo() {
    const ahora = new Date();
    const partes = new Intl.DateTimeFormat('en-US',{timeZone:'America/Santo_Domingo',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(ahora);
    const h=Number(partes.find(p=>p.type==='hour')?.value||0), m=Number(partes.find(p=>p.type==='minute')?.value||0), actual=h*60+m;
    const items=[...document.querySelectorAll('.result-card')].map(c=>{
      const t=c.getAttribute('data-hora')||''; const mt=t.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i); if(!mt)return null;
      let hh=Number(mt[1]); const mm=Number(mt[2]); const ap=mt[3].toUpperCase(); if(ap==='PM'&&hh!==12)hh+=12; if(ap==='AM'&&hh===12)hh=0;
      return {c,min:hh*60+mm,t};
    }).filter(Boolean).filter(x=>x.min>=actual).sort((a,b)=>a.min-b.min);
    const n=document.querySelector('#proximo-nombre'), hEl=document.querySelector('#proximo-hora');
    if(items.length){n.textContent=items[0].c.getAttribute('data-juego')||'Próximo sorteo'; hEl.textContent=items[0].t+' · hora RD';}
    else {n.textContent='Sorteos del día finalizados'; hEl.textContent='Consulta nuevamente mañana';}
  }

  calcularProximo(); cargar(); setInterval(cargar, 120000);
</script>

<style is:global>
  body{background:#f5f7fb}.lottery-page{color:#152033}.wrap{width:min(1180px,calc(100% - 32px));margin:auto}
  .hero{background:linear-gradient(135deg,#071d3d 0%,#0b3972 62%,#1168a7 100%);color:#fff;padding:24px 0 38px;border-bottom:5px solid #e63946}
  .crumb{display:flex;gap:9px;align-items:center;font-size:13px;margin-bottom:28px;color:#c9d8ec}.crumb a{color:#fff;text-decoration:none}.hero-grid{display:grid;grid-template-columns:1fr 330px;gap:30px;align-items:end}.eyebrow{display:inline-block;font-size:12px;font-weight:900;letter-spacing:.11em;color:#9ed7ff;margin-bottom:10px}.hero h1{font-size:clamp(31px,4vw,48px);line-height:1.05;margin:0 0 9px}.today{text-transform:capitalize;font-weight:800;margin:0 0 12px;color:#d9e9fb}.lead{max-width:700px;margin:0;color:#d2e1f2;line-height:1.6}.next-box{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:7px;backdrop-filter:blur(8px)}.next-label{font-size:11px;font-weight:900;letter-spacing:.1em;color:#9ed7ff}.next-box strong{font-size:20px}.next-box span:last-child{font-size:13px;color:#d9e9fb}
  .content{padding:20px 0 50px}.statusbar{background:#fff;border:1px solid #e0e6ef;border-radius:12px;padding:13px 16px;display:flex;justify-content:space-between;align-items:center;gap:16px;box-shadow:0 3px 14px rgba(18,42,76,.05);font-size:14px}.statusbar>div{display:flex;align-items:center;gap:9px}.pulse{width:9px;height:9px;border-radius:50%;background:#18a558;box-shadow:0 0 0 5px #e3f7eb}.statusbar>span{color:#66758b}
  .filters-panel{margin-top:18px;background:#fff;border:1px solid #e0e6ef;border-radius:14px;padding:18px;box-shadow:0 3px 14px rgba(18,42,76,.04)}.filter-title{font-size:13px;font-weight:900;margin-bottom:10px}.operator-scroll{display:flex;gap:8px;overflow:auto;padding-bottom:6px}.operator-btn,.schedule-btn{border:1px solid #dce3ec;background:#f8fafc;color:#304158;border-radius:999px;padding:9px 14px;font-weight:800;white-space:nowrap;cursor:pointer}.operator-btn.active,.schedule-btn.active{background:#0b3972;color:#fff;border-color:#0b3972}.schedule-row{border-top:1px solid #edf0f4;margin-top:12px;padding-top:14px;display:flex;align-items:center;gap:18px}.schedule-buttons{display:flex;gap:8px;flex-wrap:wrap}
  .results-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:30px 0 16px}.results-head h2{font-size:27px;margin:0 0 5px}.results-head p{margin:0;color:#68778b}.search{width:300px;background:#fff;border:1px solid #dce3ec;border-radius:10px;padding:0 12px;display:flex;align-items:center}.search input{width:100%;border:0;outline:0;padding:12px;background:transparent}
  .operator-group{margin:0 0 26px}.operator-heading{display:flex;align-items:center;gap:12px;margin-bottom:12px}.operator-mark{width:45px;height:45px;border-radius:12px;background:#e9f2ff;color:#0b3972;display:grid;place-items:center;font-weight:950}.operator-heading h2{font-size:20px;margin:0 0 2px}.operator-heading span{font-size:12px;color:#748197}.cards-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.result-card{background:#fff;border:1px solid #dfe5ed;border-radius:14px;padding:16px;box-shadow:0 4px 16px rgba(20,46,80,.055);transition:.18s}.result-card:hover{transform:translateY(-2px);box-shadow:0 7px 20px rgba(20,46,80,.09)}.card-top{display:flex;justify-content:space-between;gap:12px}.card-top h3{font-size:16px;margin:0 0 5px}.meta{font-size:12px;color:#68778b}.meta b{color:#0b3972}.state{height:max-content;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900}.state.pending{background:#fff4d8;color:#936500}.state.published{background:#e2f7ea;color:#11723d}.balls{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0}.balls span{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#0b3972;color:#fff;font-size:19px;font-weight:950;box-shadow:inset 0 -4px 0 rgba(0,0,0,.13)}.card-bottom{border-top:1px solid #edf0f4;padding-top:11px;display:flex;justify-content:space-between;gap:10px;color:#758398;font-size:11px}.verified{font-weight:900;color:#11723d}
  .seo-box{background:#fff;border:1px solid #e0e6ef;border-radius:14px;padding:24px;margin-top:32px;line-height:1.7}.seo-box h2{margin-top:0;color:#0b3972}.seo-box p:last-child{margin-bottom:0}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr}.next-box{max-width:430px}.cards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.wrap{width:min(100% - 22px,1180px)}.hero{padding-top:18px}.hero h1{font-size:32px}.statusbar,.results-head,.schedule-row{align-items:flex-start;flex-direction:column}.search{width:100%}.cards-grid{grid-template-columns:1fr}.filters-panel{padding:14px}.operator-scroll{margin-right:-14px}.balls span{width:46px;height:46px}.card-bottom{flex-direction:column}.results-head{margin-top:24px}}
</style>

</Layout>
