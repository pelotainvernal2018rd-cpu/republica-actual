/* =========================================================
   TARJETAS COMPACTAS - LOTERÍAS RD 3 POR FILA
   ========================================================= */

.country-rd .country-cards-wrap{
  padding:18px;
}

.country-rd .cards-grid-country{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  align-items:stretch;
}

.country-rd .result-card{
  padding:13px;
  border-radius:12px;
  min-width:0;
}

.country-rd .card-operator{
  font-size:10px;
  margin-bottom:6px;
}

.country-rd .card-top{
  gap:7px;
}

.country-rd .card-top h3{
  font-size:14px;
  line-height:1.2;
  margin:0 0 4px;
}

.country-rd .meta{
  font-size:11px;
}

.country-rd .state{
  padding:4px 7px;
  font-size:10px;
  white-space:nowrap;
}

.country-rd .balls{
  display:flex;
  gap:7px;
  margin:14px 0;
  flex-wrap:nowrap;
}

.country-rd .balls span{
  width:42px;
  height:42px;
  min-width:42px;
  font-size:17px;
}

.country-rd .card-bottom{
  padding-top:9px;
  font-size:10px;
  gap:6px;
}

/* TABLET */
@media(max-width:900px){

  .country-rd .cards-grid-country{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

}

/* MÓVIL */
@media(max-width:600px){

  .country-rd .country-cards-wrap{
    padding:12px;
  }

  .country-rd .cards-grid-country{
    grid-template-columns:1fr;
    gap:12px;
  }

  .country-rd .result-card{
    padding:14px;
  }

  .country-rd .balls span{
    width:44px;
    height:44px;
    min-width:44px;
    font-size:18px;
  }

}