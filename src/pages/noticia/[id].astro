---
// ============================================================
// REPÚBLICA ACTUAL
// NOTICIA INDIVIDUAL RENDERIZADA POR ASTRO
// Ruta: /noticia/ID/
// ============================================================




// ============================================================
// GENERAR TODAS LAS RUTAS DE NOTICIAS PUBLICADAS
// ============================================================

export async function getStaticPaths() {
const SUPABASE_URL = 'https://kbghquvejqteiawdotqd.supabase.co';
const SUPABASE_KEY = 'sb_publishable_ld7ydSagUVERw0yphWzjvg_yeSPpKfi';
  try {

    const endpoint =
      `${SUPABASE_URL}/rest/v1/noticias?select=*&publicado=eq.true&order=created_at.desc`;

    const respuesta = await fetch(endpoint, {
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
        Accept: 'application/json'
      }
    });

    if (!respuesta.ok) {
      console.error(
        'Error Supabase getStaticPaths:',
        respuesta.status
      );

      return [];
    }

    const noticias = await respuesta.json();

    return noticias.map((noticia) => ({
      params: {
        id: String(noticia.id)
      },

      props: {
        noticia
      }
    }));

  } catch (error) {

    console.error(
      'Error generando noticias:',
      error
    );

    return [];
  }
}


// ============================================================
// DATOS DE LA NOTICIA
// ============================================================

const { noticia } = Astro.props;


// ============================================================
// FUNCIONES
// ============================================================

function limpiarHTML(html = '') {

  return html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}


function limpiarImagenesContenido(html = '') {

  return html
    .replace(/<img[^>]*>/gi, '');
}


function crearDescripcion(noticia) {

  const descripcion =
    noticia.descripcion ||
    noticia.resumen ||
    limpiarHTML(noticia.contenido || '');

  if (!descripcion) {
    return 'Noticias de República Dominicana y el mundo en República Actual.';
  }

  return descripcion
    .substring(0, 160)
    .trim();
}


// ============================================================
// SEO
// ============================================================

const titulo =
  noticia.titulo || 'República Actual';

const descripcion =
  crearDescripcion(noticia);

const imagen =
  noticia.imagen || '';

const contenido =
  limpiarImagenesContenido(
    noticia.contenido || ''
  );

const canonical =
  `https://republicaactual.net/noticia/${noticia.id}/`;

const fechaPublicacion =
  noticia.created_at || '';

const categoria =
  noticia.categoria ||
  (
    Array.isArray(noticia.etiquetas) &&
    noticia.etiquetas.length
      ? noticia.etiquetas[0]
      : 'Actualidad'
  );


// ============================================================
// DATOS ESTRUCTURADOS PARA GOOGLE
// ============================================================

const schema = {

  '@context': 'https://schema.org',

  '@type': 'NewsArticle',

  headline: titulo,

  description: descripcion,

  mainEntityOfPage: canonical,

  datePublished: fechaPublicacion,

  dateModified: fechaPublicacion,

  publisher: {
    '@type': 'Organization',
    name: 'República Actual',
    url: 'https://republicaactual.net/'
  },

  ...(imagen
    ? {
        image: [imagen]
      }
    : {})
};
---

<!doctype html>

<html lang="es">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />


  <!-- SEO PRINCIPAL -->

  <title>{titulo} | República Actual</title>

  <meta
    name="description"
    content={descripcion}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={canonical}
  />


  <!-- OPEN GRAPH -->

  <meta
    property="og:type"
    content="article"
  />

  <meta
    property="og:site_name"
    content="República Actual"
  />

  <meta
    property="og:title"
    content={titulo}
  />

  <meta
    property="og:description"
    content={descripcion}
  />

  <meta
    property="og:url"
    content={canonical}
  />

  {
    imagen && (
      <meta
        property="og:image"
        content={imagen}
      />
    )
  }


  <!-- TWITTER -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={titulo}
  />

  <meta
    name="twitter:description"
    content={descripcion}
  />

  {
    imagen && (
      <meta
        name="twitter:image"
        content={imagen}
      />
    )
  }


  <!-- GOOGLE NEWS / DATOS ESTRUCTURADOS -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />


  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #102d47;
    }


    /* =========================================
       BARRA SUPERIOR
    ========================================= */

    .barra {
      background: #102d47;
      color: #ffffff;
      text-align: center;
      padding: 9px;
      font-size: 12px;
      font-weight: bold;
    }


    /* =========================================
       HEADER
    ========================================= */

    header {
      max-width: 1080px;
      margin: auto;
      padding: 32px 20px 25px;
    }

    .logo {
      margin: 0;
      font-size: 38px;
      font-weight: 900;
      letter-spacing: -2px;
      text-decoration: none;
      color: #102d47;
    }

    .logo span {
      color: #d71920;
    }

    .slogan {
      margin-top: 5px;
      color: #718297;
      font-size: 13px;
      letter-spacing: 2px;
    }


    /* =========================================
       MENÚ
    ========================================= */

    nav {
      border-top: 1px solid #e1e5e8;
      border-bottom: 3px solid #102d47;
      overflow-x: auto;
    }

    nav div {
      max-width: 1080px;
      margin: auto;
      display: flex;
      gap: 30px;
      padding: 15px 20px;
    }

    nav a {
      color: #102d47;
      text-decoration: none;
      font-size: 14px;
      font-weight: bold;
      white-space: nowrap;
    }

    nav a:hover {
      color: #d71920;
    }


    /* =========================================
       NOTICIA
    ========================================= */

    main {
      max-width: 850px;
      min-height: 500px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .volver {
      display: inline-block;
      margin-bottom: 30px;
      color: #d71920;
      text-decoration: none;
      font-weight: bold;
    }

    .categoria {
      margin-bottom: 12px;
      color: #d71920;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 25px;
      color: #102d47;
      font-size: 40px;
      line-height: 1.12;
    }

    .imagen-principal {
      width: 100%;
      max-height: 520px;
      object-fit: cover;
      display: block;
      margin: 0 0 30px;
    }

    .contenido {
      color: #333333;
      font-size: 18px;
      line-height: 1.75;
    }

    .contenido :global(p) {
      margin: 0 0 22px;
    }


    /* =========================================
       FOOTER
    ========================================= */

    footer {
      margin-top: 50px;
      padding: 30px 20px;
      background: #102d47;
      color: #ffffff;
      text-align: center;
      font-size: 14px;
    }


    /* =========================================
       MÓVIL
    ========================================= */

    @media (max-width: 700px) {

      .logo {
        font-size: 30px;
      }

      h1 {
        font-size: 30px;
      }

      .contenido {
        font-size: 17px;
      }

    }

  </style>

</head>


<body>

  <div class="barra">
    INFORMACIÓN CON CONTEXTO Y CLARIDAD
  </div>


  <header>

    <a
      class="logo"
      href="/"
    >
      REPÚBLICA<span>·</span>ACTUAL
    </a>

    <div class="slogan">
      LO QUE PASA. LO QUE IMPORTA.
    </div>

  </header>


  <nav>

    <div>

      <a href="/">
        INICIO
      </a>

      <a href="/categoria/nacionales/">
        NACIONALES
      </a>

      <a href="/categoria/politica/">
        POLÍTICA
      </a>

      <a href="/categoria/economia/">
        ECONOMÍA
      </a>

      <a href="/categoria/deportes/">
        DEPORTES
      </a>

      <a href="/categoria/entretenimiento/">
        ENTRETENIMIENTO
      </a>

      <a href="/categoria/mundo/">
        MUNDO
      </a>

      <a href="/categoria/tecnologia/">
        TECNOLOGÍA
      </a>

    </div>

  </nav>


  <main>

    <a
      class="volver"
      href="/"
    >
      ← Volver a inicio
    </a>


    <article>

      <div class="categoria">
        {categoria}
      </div>


      <h1>
        {titulo}
      </h1>


      {
        imagen && (

          <img
            class="imagen-principal"
            src={imagen}
            alt={titulo}
          />

        )
      }


      <div
        class="contenido"
        set:html={contenido}
      />

    </article>

  </main>


  <footer>
    © {new Date().getFullYear()} República Actual
  </footer>

</body>

</html>