---
// ============================================================
// REPÚBLICA ACTUAL
// NOTICIA INDIVIDUAL RENDERIZADA POR ASTRO
// Ruta: /noticia/ID/
// ============================================================




// ============================================================
// GENERAR TODAS LAS RUTAS DE NOTICIAS PUBLICADAS
// ============================================================

export async function getStaticPaths() {
const SUPABASE_URL = 'https://kbghquvejqteiawdotqd.supabase.co';
const SUPABASE_KEY = 'sb_publishable_ld7ydSagUVERw0yphWzjvg_yeSPpKfi';
  try {

    const endpoint =
      `${SUPABASE_URL}/rest/v1/noticias?select=*&publicado=eq.true&order=created_at.desc`;

    const respuesta = await fetch(endpoint, {
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
        Accept: 'application/json'
      }
    });

    if (!respuesta.ok) {
      console.error(
        'Error Supabase getStaticPaths:',
        respuesta.status
      );

      return [];
    }

    const noticias = await respuesta.json();

   return noticias.map((noticia) => ({
  params: {
    id: noticia.slug || String(noticia.id)
  },

  props: {
    noticia
  }
}));
  } catch (error) {

    console.error(
      'Error generando noticias:',
      error
    );

    return [];
  }
}


// ============================================================
// DATOS DE LA NOTICIA
// ============================================================

const { noticia } = Astro.props;


// ============================================================
// FUNCIONES
// ============================================================

function limpiarHTML(html = '') {

  return html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}


function limpiarImagenesContenido(html = '') {

  return html
    .replace(/<img[^>]*>/gi, '');
}

// Optimiza la imagen principal con Cloudflare y conserva la original como respaldo.
function imagenCloudflare(url = '', ancho = 1100) {
  if (!/^https?:\/\//i.test(url)) return url;
  return `/cdn-cgi/image/width=${ancho},quality=78,format=auto,fit=scale-down/${url}`;
}


function crearDescripcion(noticia) {

  const descripcion =
    noticia.descripcion ||
    noticia.resumen ||
    limpiarHTML(noticia.contenido || '');

  if (!descripcion) {
    return 'Noticias de República Dominicana y el mundo en República Actual.';
  }

  return descripcion
    .substring(0, 160)
    .trim();
}


// ============================================================
// SEO
// ============================================================

const titulo =
  noticia.titulo || 'República Actual';

const descripcion =
  crearDescripcion(noticia);

const imagen =
  noticia.imagen || '';

const contenido =
  limpiarImagenesContenido(
    noticia.contenido || ''
  );

const canonical =
  `https://republicaactual.net/noticia/${noticia.slug || noticia.id}/`;

const fechaPublicacion =
  noticia.created_at || '';

const categoria =
  noticia.categoria ||
  (
    Array.isArray(noticia.etiquetas) &&
    noticia.etiquetas.length
      ? noticia.etiquetas[0]
      : 'Actualidad'
  );


// ============================================================
// DATOS ESTRUCTURADOS PARA GOOGLE
// ============================================================

const schema = {

  '@context': 'https://schema.org',

  '@type': 'NewsArticle',

  headline: titulo,

  description: descripcion,

  mainEntityOfPage: canonical,

  datePublished: fechaPublicacion,

  dateModified: fechaPublicacion,

  publisher: {
    '@type': 'Organization',
    name: 'República Actual',
    url: 'https://republicaactual.net/'
  },

  ...(imagen
    ? {
        image: [imagen]
      }
    : {})
};
---

<!doctype html>

<html lang="es">

<head>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8706713311488194"
