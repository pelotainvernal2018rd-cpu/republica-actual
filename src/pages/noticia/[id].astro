// ============================================================
// REPÚBLICA ACTUAL
// NOTICIA INDIVIDUAL RENDERIZADA POR ASTRO
// FIRESTORE
// Ruta principal: /noticia/SLUG/
// Ruta antigua: /noticia/ID/ -> 301 al slug
// ============================================================

export async function getStaticPaths() {
  const FIREBASE_PROJECT_ID =
    import.meta.env.FIREBASE_PROJECT_ID || 'republica-actual';

  function valorFirestore(field = {}) {
    if ('stringValue' in field) return field.stringValue;
    if ('integerValue' in field) return Number(field.integerValue);
    if ('doubleValue' in field) return Number(field.doubleValue);
    if ('booleanValue' in field) return field.booleanValue;
    if ('timestampValue' in field) return field.timestampValue;
    if ('nullValue' in field) return null;

    if ('arrayValue' in field) {
      return (field.arrayValue.values || []).map(valorFirestore);
    }

    if ('mapValue' in field) {
      return Object.fromEntries(
        Object.entries(field.mapValue.fields || {}).map(
          ([clave, valor]) => [clave, valorFirestore(valor)]
        )
      );
    }

    return '';
  }

  function documentoFirestore(doc = {}) {
    const datos = Object.fromEntries(
      Object.entries(doc.fields || {}).map(
        ([clave, valor]) => [clave, valorFirestore(valor)]
      )
    );

    if (!datos.id && doc.name) {
      datos.id = doc.name.split('/').pop();
    }

    return datos;
  }

  try {
    const endpoint =
      `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents:runQuery`;

    const respuesta = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        structuredQuery: {
          from: [{ collectionId: 'noticias' }],
          where: {
            fieldFilter: {
              field: { fieldPath: 'publicado' },
              op: 'EQUAL',
              value: { booleanValue: true }
            }
          }
        }
      })
    });

    if (!respuesta.ok) {
      console.error(
        'Error Firestore getStaticPaths:',
        respuesta.status,
        await respuesta.text()
      );
      return [];
    }

    const resultado = await respuesta.json();

    const noticias = resultado
      .filter((fila) => fila.document)
      .map((fila) => documentoFirestore(fila.document))
      .sort(
        (a, b) =>
          (Date.parse(b.created_at || '') || 0) -
          (Date.parse(a.created_at || '') || 0)
      );

    console.log(
      `Firestore: ${noticias.length} noticias publicadas para rutas individuales`
    );

    return noticias.flatMap((noticia) => {
      const categoriaActual =
        noticia.categoria ||
        (
          Array.isArray(noticia.etiquetas) &&
          noticia.etiquetas.length
            ? noticia.etiquetas[0]
            : 'Actualidad'
        );

      const relacionadas = noticias
        .filter((otra) => {
          if (String(otra.id) === String(noticia.id)) {
            return false;
          }

          const categoriaOtra =
            otra.categoria ||
            (
              Array.isArray(otra.etiquetas) &&
              otra.etiquetas.length
                ? otra.etiquetas[0]
                : 'Actualidad'
            );

          return categoriaOtra === categoriaActual;
        })
        .slice(0, 4);

      const rutaPrincipal = {
        params: {
          id: noticia.slug || String(noticia.id)
        },
        props: {
          noticia,
          relacionadas,
          redirigirA: null
        }
      };

      const rutaAntigua =
        noticia.slug &&
        String(noticia.id) !== String(noticia.slug)
          ? {
              params: {
                id: String(noticia.id)
              },
              props: {
                noticia,
                relacionadas,
                redirigirA: `/noticia/${noticia.slug}/`
              }
            }
          : null;

      return rutaAntigua
        ? [rutaPrincipal, rutaAntigua]
        : [rutaPrincipal];
    });

  } catch (error) {
    console.error(
      'Error generando noticias desde Firestore:',
      error
    );

    return [];
  }
}


// ============================================================
// DATOS DE LA NOTICIA
// ============================================================

const {
  noticia,
  relacionadas = [],
  redirigirA = null
} = Astro.props;


// ============================================================
// REDIRECCIÓN DE URL ANTIGUA
// ============================================================

if (redirigirA) {
  return Astro.redirect(redirigirA, 301);
}


// ============================================================
// FUNCIONES
// ============================================================

function limpiarHTML(html = '') {
  return html
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}


function limpiarImagenesContenido(html = '') {
  return html
    .replace(/<img[^>]*>/gi, '');
}


// Optimiza la imagen principal con Cloudflare
// y conserva la original como respaldo.

function imagenCloudflare(url = '', ancho = 1100) {
  if (!/^https?:\/\//i.test(url)) {
    return url;
  }

  return `/cdn-cgi/image/width=${ancho},quality=78,format=auto,fit=scale-down/${url}`;
}


function crearDescripcion(noticia) {
  const descripcion =
    noticia.descripcion ||
    noticia.resumen ||
    limpiarHTML(noticia.contenido || '');

  if (!descripcion) {
    return 'Noticias de República Dominicana y el mundo en República Actual.';
  }

  return descripcion
    .substring(0, 160)
    .trim();
}


// ============================================================
// SEO
// ============================================================

const titulo =
  noticia.titulo || 'República Actual';

const descripcion =
  crearDescripcion(noticia);

const imagen =
  noticia.imagen || '';

const contenido =
  limpiarImagenesContenido(
    noticia.contenido || ''
  );

const canonical =
  `https://republicaactual.net/noticia/${noticia.slug || noticia.id}/`;

const fechaPublicacion =
  noticia.created_at || '';

const fechaModificacion =
  noticia.updated_at ||
  noticia.modified_at ||
  fechaPublicacion;

const autorNombre =
  noticia.autor ||
  noticia.author ||
  '';

const categoria =
  noticia.categoria ||
  (
    Array.isArray(noticia.etiquetas) &&
    noticia.etiquetas.length
      ? noticia.etiquetas[0]
      : 'Actualidad'
  );

const palabrasClave = Array.from(
  new Set([
    categoria,
    ...(
      Array.isArray(noticia.etiquetas)
        ? noticia.etiquetas
        : []
    )
  ].filter(Boolean))
).join(', ');


// ============================================================
// DATOS ESTRUCTURADOS PARA GOOGLE
// ============================================================

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',

  headline: titulo,

  description: descripcion,

  url: canonical,

  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical
  },

  datePublished: fechaPublicacion,

  dateModified: fechaModificacion,

  articleSection: categoria,

  ...(palabrasClave
    ? {
        keywords: palabrasClave
      }
    : {}),

  author: autorNombre
    ? {
        '@type': 'Person',
        name: autorNombre
      }
    : {
        '@type': 'Organization',
        name: 'República Actual',
        url: 'https://republicaactual.net/'
      },

  publisher: {
    '@type': 'Organization',
    name: 'República Actual',
    url: 'https://republicaactual.net/'
  },

  ...(imagen
    ? {
        image: [imagen]
      }
    : {})
};
---

<!doctype html>

<html lang="es">

<head>

  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8706713311488194"
    crossorigin="anonymous">
  </script>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />


  <!-- ===================================================== -->
  <!-- SEO PRINCIPAL -->
  <!-- ===================================================== -->

  <title>{titulo} | República Actual</title>

  <meta
    name="description"
    content={descripcion}
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={canonical}
  />


  {
    palabrasClave && (
      <meta
        name="keywords"
        content={palabrasClave}
      />
    )
  }


  {
    fechaPublicacion && (
      <meta
        property="article:published_time"
        content={fechaPublicacion}
      />
    )
  }


  {
    fechaModificacion && (
      <meta
        property="article:modified_time"
        content={fechaModificacion}
      />
    )
  }


  <meta
    property="article:section"
    content={categoria}
  />


  <!-- ===================================================== -->
  <!-- OPEN GRAPH -->
  <!-- ===================================================== -->

  <meta
    property="og:type"
    content="article"
  />

  <meta
    property="og:site_name"
    content="República Actual"
  />

  <meta
    property="og:title"
    content={titulo}
  />

  <meta
    property="og:description"
    content={descripcion}
  />

  <meta
    property="og:url"
    content={canonical}
  />


  {
    imagen && (
      <meta
        property="og:image"
        content={imagen}
      />
    )
  }


  <!-- ===================================================== -->
  <!-- TWITTER / X -->
  <!-- ===================================================== -->

  <meta
    name="twitter:card"
    content="summary"
  />

  <meta
    name="twitter:title"
    content={titulo}
  />

  <meta
    name="twitter:description"
    content={descripcion}
  />


  {
    imagen && (
      <meta
        name="twitter:image"
        content={imagen}
      />
    )
  }


  <!-- ===================================================== -->
  <!-- GOOGLE NEWS / DATOS ESTRUCTURADOS -->
  <!-- ===================================================== -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />


  <style>

    * {
      box-sizing: border-box;
    }


    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #102d47;
    }


    /* =========================================
       BARRA SUPERIOR
    ========================================= */

    .barra {
      background: #102d47;
      color: #ffffff;
      text-align: center;
      padding: 9px;
      font-size: 12px;
      font-weight: bold;
    }


    /* =========================================
       HEADER
    ========================================= */

    header {
      max-width: 1080px;
      margin: auto;
      padding: 32px 20px 25px;
    }


    .logo {
      margin: 0;
      font-size: 38px;
      font-weight: 900;
      letter-spacing: -2px;
      text-decoration: none;
      color: #102d47;
    }


    .logo span {
      color: #d71920;
    }


    .slogan {
      margin-top: 5px;
      color: #718297;
      font-size: 13px;
      letter-spacing: 2px;
    }


    /* =========================================
       MENÚ
    ========================================= */

    nav {
      border-top: 1px solid #e1e5e8;
      border-bottom: 3px solid #102d47;
      overflow-x: auto;
    }


    nav div {
      max-width: 1080px;
      margin: auto;
      display: flex;
      gap: 30px;
      padding: 15px 20px;
    }


    nav a {
      color: #102d47;
      text-decoration: none;
      font-size: 14px;
      font-weight: bold;
      white-space: nowrap;
    }


    nav a:hover {
      color: #d71920;
    }


    /* =========================================
       NOTICIA
    ========================================= */

    main {
      max-width: 850px;
      min-height: 500px;
      margin: 40px auto;
      padding: 0 20px;
    }


    .volver {
      display: inline-block;
      margin-bottom: 30px;
      color: #d71920;
      text-decoration: none;
      font-weight: bold;
    }


    .categoria {
      margin-bottom: 12px;
      color: #d71920;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }


    h1 {
      margin: 0 0 25px;
      color: #102d47;
      font-size: 40px;
      line-height: 1.12;
    }


    .imagen-principal {
      width: 100%;
      max-height: 520px;
      object-fit: cover;
      display: block;
      margin: 0 0 30px;
    }


    .contenido {
      color: #333333;
      font-size: 18px;
      line-height: 1.75;
    }


    .contenido :global(p) {
      margin: 0 0 22px;
    }


    /* =========================================
       NOTICIAS RELACIONADAS
    ========================================= */

    .relacionadas {
      margin-top: 38px;
      padding-top: 28px;
      border-top: 1px solid #e5e7eb;
    }


    .relacionadas h2 {
      margin: 0 0 18px;
      color: #102d47;
      font-size: 24px;
    }


    .relacionadas-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }


    .relacionada {
      display: block;
      padding: 16px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      color: #102d47;
      text-decoration: none;
      background: #fff;
    }


    .relacionada:hover {
      border-color: #d71920;
    }


    .relacionada-titulo {
      display: block;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.35;
    }


    /* =========================================
       COMPARTIR
    ========================================= */

    .compartir-noticia {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 30px 0 15px;
      padding-top: 18px;
      border-top: 1px solid #e5e7eb;
    }


    .compartir-noticia > span {
      font-size: 14px;
      font-weight: 600;
      margin-right: 4px;
    }


    .share {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition:
        transform .15s ease,
        opacity .15s ease;
    }


    .share:hover {
      transform: translateY(-2px);
      opacity: .88;
    }


    .share svg {
      width: 21px;
      height: 21px;
      fill: white;
    }


    .share strong {
      font-size: 20px;
      line-height: 1;
    }


    .whatsapp {
      background: #25D366;
    }


    .x {
      background: #000;
      color: #fff;
    }


    .facebook {
      background: #1877F2;
      color: #fff;
    }


    .facebook strong {
      font-family: Arial, sans-serif;
      font-size: 24px;
    }


    /* =========================================
       FOOTER
    ========================================= */

    footer {
      margin-top: 50px;
      padding: 30px 20px;
      background: #102d47;
      color: #ffffff;
      text-align: center;
      font-size: 14px;
    }


    /* =========================================
       MÓVIL
    ========================================= */

    @media (max-width: 700px) {

      .logo {
        font-size: 30px;
      }


      h1 {
        font-size: 30px;
      }


      .contenido {
        font-size: 17px;
      }


      .relacionadas-grid {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 600px) {

      .compartir-noticia {
        margin-top: 24px;
      }


      .share {
        width: 40px;
        height: 40px;
      }

    }

  </style>

</head>


<body>


  <!-- ===================================================== -->
  <!-- BARRA SUPERIOR -->
  <!-- ===================================================== -->

  <div class="barra">
    INFORMACIÓN CON CONTEXTO Y CLARIDAD
  </div>


  <!-- ===================================================== -->
  <!-- HEADER -->
  <!-- ===================================================== -->

  <header>

    <a
      class="logo"
      href="/"
    >
      REPÚBLICA<span>·</span>ACTUAL
    </a>


    <div class="slogan">
      LO QUE PASA. LO QUE IMPORTA.
    </div>

  </header>


  <!-- ===================================================== -->
  <!-- MENÚ -->
  <!-- ===================================================== -->

  <nav>

    <div>

      <a href="/">
        INICIO
      </a>


      <a href="/categoria/nacionales/">
        NACIONALES
      </a>


      <a href="/categoria/politica/">
        POLÍTICA
      </a>


      <a href="/categoria/economia/">
        ECONOMÍA
      </a>


      <a href="/categoria/deportes/">
        DEPORTES
      </a>


      <a href="/categoria/entretenimiento/">
        ENTRETENIMIENTO
      </a>


      <a href="/categoria/mundo/">
        MUNDO
      </a>


      <a href="/categoria/tecnologia/">
        TECNOLOGÍA
      </a>

    </div>

  </nav>


  <!-- ===================================================== -->
  <!-- CONTENIDO -->
  <!-- ===================================================== -->

  <main>


    <a
      class="volver"
      href="/"
    >
      ← Volver a inicio
    </a>


    <article>


      <!-- CATEGORÍA -->

      <div class="categoria">
        {categoria}
      </div>


      <!-- TÍTULO -->

      <h1>
        {titulo}
      </h1>


      <!-- IMAGEN PRINCIPAL -->

      {
        imagen && (

          <img
            class="imagen-principal"
            src={imagenCloudflare(imagen, 1100)}
            alt={titulo}
            width="1100"
            height="620"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            referrerpolicy="no-referrer"
            data-original={imagen}
            onerror="if(this.dataset.fallbackStage!=='original'){this.dataset.fallbackStage='original';this.src=this.dataset.original;}else{this.onerror=null;this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221100%22 height=%22620%22 viewBox=%220 0 1100 620%22%3E%3Crect width=%221100%22 height=%22620%22 fill=%22%23eef1f4%22/%3E%3Ctext x=%22550%22 y=%22310%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22 font-family=%22Arial%22 font-size=%2238%22 fill=%22%23102d47%22%3EREPÚBLICA ACTUAL%3C/text%3E%3C/svg%3E';}"
          />

        )
      }


      <!-- CONTENIDO DE LA NOTICIA -->

      <div
        class="contenido"
        set:html={contenido}
      />


      <!-- ================================================= -->
      <!-- NOTICIAS RELACIONADAS -->
      <!-- ================================================= -->

      {
        relacionadas.length > 0 && (

          <section
            class="relacionadas"
            aria-labelledby="relacionadas-titulo"
          >

            <h2 id="relacionadas-titulo">
              Noticias relacionadas
            </h2>


            <div class="relacionadas-grid">

              {
                relacionadas.map((relacionada) => (

                  <a
                    class="relacionada"
                    href={`/noticia/${relacionada.slug || relacionada.id}/`}
                  >

                    <span class="relacionada-titulo">
                      {relacionada.titulo}
                    </span>

