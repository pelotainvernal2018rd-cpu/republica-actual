---
import Layout from "../layouts/Layout.astro";

const deportes = [
  { id: "todos", nombre: "Todos", icono: "🏆" },
  { id: "mlb", nombre: "MLB", icono: "⚾" },
  { id: "lidom", nombre: "LIDOM", icono: "⚾" },
  { id: "nba", nombre: "NBA", icono: "🏀" },
  { id: "nfl", nombre: "NFL", icono: "🏈" },
  { id: "futbol", nombre: "Fútbol", icono: "⚽" },
];

const partidos = [
  {
    deporte: "mlb",
    liga: "MLB",
    estado: "EN VIVO",
    detalle: "7.º inning",
    visitante: "New York Yankees",
    local: "Boston Red Sox",
    visitanteCorto: "NYY",
    localCorto: "BOS",
    marcadorVisitante: 4,
    marcadorLocal: 3,
    hora: "En vivo",
    video: false
  },
  {
    deporte: "nba",
    liga: "NBA",
    estado: "PRÓXIMO",
    detalle: "8:00 PM",
    visitante: "Los Angeles Lakers",
    local: "Boston Celtics",
    visitanteCorto: "LAL",
    localCorto: "BOS",
    marcadorVisitante: "-",
    marcadorLocal: "-",
    hora: "8:00 PM",
    video: false
  },
  {
    deporte: "futbol",
    liga: "FÚTBOL",
    estado: "PRÓXIMO",
    detalle: "9:00 PM",
    visitante: "Real Madrid",
    local: "Barcelona",
    visitanteCorto: "RMA",
    localCorto: "BAR",
    marcadorVisitante: "-",
    marcadorLocal: "-",
    hora: "9:00 PM",
    video: false
  }
];
---

<Layout title="Deportes en Vivo | República Actual">

<main class="sports-page">

  <!-- HERO -->
  <section class="sports-hero">
    <div class="hero-inner">

      <div>
        <span class="section-label">REPÚBLICA ACTUAL</span>

        <h1>
          Deportes
          <span>EN VIVO</span>
        </h1>

        <p>
          Marcadores, partidos, resultados y transmisiones deportivas
          desde un solo lugar.
        </p>
      </div>

      <div class="live-indicator">
        <span class="live-dot"></span>
        ACTUALIZACIÓN EN VIVO
      </div>

    </div>
  </section>


  <!-- NAVEGACIÓN DEPORTES -->
  <section class="sports-nav">

    <div class="nav-scroll">

      {deportes.map((deporte) => (
        <button
          class:list={[
            "sport-filter",
            deporte.id === "todos" && "active"
          ]}
          data-sport={deporte.id}
        >
          <span>{deporte.icono}</span>
          {deporte.nombre}
        </button>
      ))}

    </div>

  </section>


  <!-- CONTENIDO -->
  <div class="sports-container">

    <!-- PARTIDO DESTACADO -->
    <section class="featured-section">

      <div class="section-heading">

        <div>
          <span class="live-dot"></span>
          EN VIVO AHORA
        </div>

        <span class="update-text">
          Marcadores actualizados automáticamente
        </span>

      </div>


      <article class="featured-game" data-sport="mlb">

        <div class="game-top">

          <div class="league">
            ⚾ MLB
          </div>

          <div class="live-badge">
            <span></span>
            EN VIVO
          </div>

        </div>


        <div class="game-main">

          <div class="team">

            <div class="team-logo">
              NY
            </div>

            <div class="team-name">
              <strong>New York Yankees</strong>
              <span>NYY</span>
            </div>

          </div>


          <div class="score-center">

            <div class="inning">
              7.º INNING
            </div>

            <div class="score">
              <strong>4</strong>
              <span>—</span>
              <strong>3</strong>
            </div>

            <div class="game-status">
              Partido en progreso
            </div>

          </div>


          <div class="team team-right">

            <div class="team-logo">
              BOS
            </div>

            <div class="team-name">
              <strong>Boston Red Sox</strong>
              <span>BOS</span>
            </div>

          </div>

        </div>


        <!-- REPRODUCTOR -->
        <div class="player-area">

          <div class="player-placeholder">

            <div class="player-icon">
              ▶
            </div>

            <h3>Transmisión del partido</h3>

            <p>
              El reproductor aparecerá aquí cuando exista
              una señal disponible para este encuentro.
            </p>

          </div>

        </div>


        <div class="game-footer">

          <div>
            <span>●</span>
            Marcador en vivo
          </div>

          <div>
            República Actual Deportes
          </div>

        </div>

      </article>

    </section>


    <!-- PARTIDOS -->
    <section class="games-section">

      <div class="games-title">

        <div>
          <span>📅</span>

          <div>
            <h2>Partidos de hoy</h2>
            <p>Calendario deportivo</p>
          </div>

        </div>


        <div class="status-tabs">

          <button class="status-active">
            Todos
          </button>

          <button>
            En vivo
          </button>

          <button>
            Próximos
          </button>

          <button>
            Finalizados
          </button>

        </div>

      </div>


      <div class="games-grid">

        {partidos.map((partido) => (

          <article
            class="game-card"
            data-sport={partido.deporte}
          >

            <div class="card-header">

              <span class="league-small">
                {partido.liga}
              </span>

              <span
                class:list={[
                  "game-state",
                  partido.estado === "EN VIVO" && "is-live"
                ]}
              >
                {partido.estado}
              </span>

            </div>


            <div class="card-teams">

              <div class="small-team">

                <div class="mini-logo">
                  {partido.visitanteCorto}
                </div>

                <span>
                  {partido.visitante}
                </span>

                <strong>
                  {partido.marcadorVisitante}
                </strong>

              </div>


              <div class="small-team">

                <div class="mini-logo">
                  {partido.localCorto}
                </div>

                <span>
                  {partido.local}
                </span>

                <strong>
                  {partido.marcadorLocal}
                </strong>

              </div>

            </div>


            <div class="card-footer">

              <span>
                {partido.detalle}
              </span>

              {
                partido.estado === "EN VIVO"
                ? (
                  <button class="watch-button">
                    ▶ Ver partido
                  </button>
                )
                : (
                  <span class="game-time">
                    {partido.hora}
                  </span>
                )
              }

            </div>

          </article>

        ))}

      </div>

    </section>


    <!-- PRÓXIMAMENTE -->
    <section class="coming-section">

      <div class="coming-icon">
        📺
      </div>

      <div>
        <h2>Más deportes, más acción</h2>

        <p>
          República Actual Deportes incorporará nuevos partidos,
          resultados y competiciones automáticamente.
        </p>
      </div>

    </section>

  </div>

</main>


<script>

const filtros = document.querySelectorAll(".sport-filter");
const tarjetas = document.querySelectorAll(".game-card");

filtros.forEach((boton) => {

  boton.addEventListener("click", () => {

    filtros.forEach((b) => b.classList.remove("active"));

    boton.classList.add("active");

    const deporte = boton.getAttribute("data-sport");

    tarjetas.forEach((tarjeta) => {

      const tipo = tarjeta.getAttribute("data-sport");

      if (deporte === "todos" || deporte === tipo) {
        tarjeta.style.display = "";
      } else {
        tarjeta.style.display = "none";
      }

    });

  });

});

</script>


<style>

:global(body) {
  background: #f4f6f8;
}


/* =========================
   HERO
========================= */

.sports-hero {
  background:
    radial-gradient(circle at 85% 20%, rgba(24, 119, 242, .22), transparent 30%),
    linear-gradient(135deg, #07101e, #0b1d36 60%, #07101e);

  color: white;
  padding: 52px 20px;
}

.hero-inner {
  max-width: 1200px;
  margin: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}

.section-label {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  opacity: .7;
}

.sports-hero h1 {
  margin: 8px 0 10px;

  font-size: clamp(38px, 6vw, 68px);
  line-height: .95;

  font-weight: 900;
}

.sports-hero h1 span {
  color: #2f80ff;
}

.sports-hero p {
  max-width: 620px;

  color: #b9c5d6;

  font-size: 16px;
  line-height: 1.6;
}

.live-indicator {
  display: flex;
  align-items: center;
  gap: 9px;

  background: rgba(255,255,255,.08);

  border: 1px solid rgba(255,255,255,.12);

  padding: 12px 17px;

  border-radius: 30px;

  font-size: 11px;
  font-weight: 800;

  white-space: nowrap;
}

.live-dot {
  width: 8px;
  height: 8px;

  display: inline-block;

  border-radius: 50%;

  background: #ff2d2d;

  box-shadow: 0 0 0 5px rgba(255,45,45,.15);

  animation: pulse 1.4s infinite;
}

@keyframes pulse {

  0% {
    box-shadow: 0 0 0 0 rgba(255,45,45,.45);
  }

  70% {
    box-shadow: 0 0 0 8px rgba(255,45,45,0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(255,45,45,0);
  }

}


/* =========================
   FILTROS
========================= */

.sports-nav {
  background: white;

  border-bottom: 1px solid #e5e7eb;

  position: sticky;
  top: 0;

  z-index: 20;
}

.nav-scroll {
  max-width: 1200px;
  margin: auto;

  display: flex;
  gap: 5px;

  padding: 10px 15px;

  overflow-x: auto;
}

.sport-filter {
  border: 0;

  background: transparent;

  color: #5d6673;

  font-size: 14px;
  font-weight: 700;

  padding: 11px 16px;

  border-radius: 8px;

  cursor: pointer;

  white-space: nowrap;

  transition: .2s;
}

.sport-filter:hover {
  background: #f1f4f8;
}

.sport-filter.active {
  background: #0b1d36;
  color: white;
}


/* =========================
   CONTAINER
========================= */

.sports-container {
  max-width: 1200px;

  margin: auto;

  padding: 35px 20px 60px;
}


/* =========================
   DESTACADO
========================= */

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 14px;

  font-size: 13px;
  font-weight: 900;
}

.section-heading > div {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #e11d2e;
}

.update-text {
  color: #8993a2;

  font-size: 11px;
  font-weight: 600;
}


.featured-game {
  background: #081525;

  color: white;

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 15px 45px rgba(9, 22, 41, .18);
}

.game-top {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 17px 22px;

  border-bottom: 1px solid rgba(255,255,255,.08);
}

.league {
  font-weight: 900;
  font-size: 14px;
}

.live-badge {
  display: flex;
  align-items: center;
  gap: 7px;

  background: #e51f31;

  padding: 7px 12px;

  border-radius: 20px;

  font-size: 10px;
  font-weight: 900;
}

.live-badge span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: white;
}


.game-main {
  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  gap: 30px;

  padding: 34px 40px;
}

.team {
  display: flex;
  align-items: center;
  gap: 17px;
}

.team-right {
  flex-direction: row-reverse;
  text-align: right;
}

.team-logo {
  width: 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: rgba(255,255,255,.09);

  border: 1px solid rgba(255,255,255,.1);

  font-size: 18px;
  font-weight: 900;
}

.team-name {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.team-name strong {
  font-size: 17px;
}

.team-name span {
  font-size: 11px;
  color: #8494a9;
}


.score-center {
  text-align: center;
}

.inning {
  color: #f5b942;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1px;

  margin-bottom: 6px;
}

.score {
  display: flex;
  align-items: center;

  gap: 15px;

  font-size: 38px;
}

.score strong {
  font-size: 48px;
}

.score span {
  color: #66768c;

  font-size: 25px;
}

.game-status {
  color: #8796a9;

  font-size: 11px;

  margin-top: 4px;
}


/* =========================
   PLAYER
========================= */

.player-area {
  padding: 0 22px 22px;
}

.player-placeholder {
  min-height: 390px;

  background:
    radial-gradient(circle at center, #172d48, #050d17 65%);

  border-radius: 12px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 30px;
}

.player-icon {
  width: 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding-left: 5px;

  border-radius: 50%;

  background: white;

  color: #081525;

  font-size: 27px;

  margin-bottom: 18px;

  box-shadow: 0 10px 35px rgba(0,0,0,.35);
}

.player-placeholder h3 {
  margin: 0 0 8px;

  font-size: 20px;
}

.player-placeholder p {
  margin: 0;

  color: #8291a4;

  max-width: 430px;

  font-size: 13px;

  line-height: 1.5;
}

.game-footer {
  display: flex;
  justify-content: space-between;

  padding: 14px 22px;

  background: rgba(255,255,255,.035);

  color: #8291a4;

  font-size: 11px;
}

.game-footer span {
  color: #21d07a;
}


/* =========================
   PARTIDOS
========================= */

.games-section {
  margin-top: 42px;
}

.games-title {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;

  margin-bottom: 18px;
}

.games-title > div:first-child {
  display: flex;
  align-items: center;
  gap: 12px;
}

.games-title h2 {
  margin: 0;

  color: #111827;

  font-size: 21px;
}

.games-title p {
  margin: 3px 0 0;

  color: #8a94a3;

  font-size: 12px;
}

.status-tabs {
  display: flex;

  background: #e9edf2;

  padding: 4px;

  border-radius: 8px;
}

.status-tabs button {
  border: 0;

  background: transparent;

  padding: 8px 12px;

  font-size: 11px;
  font-weight: 700;

  color: #657080;

  border-radius: 6px;

  cursor: pointer;
}

.status-tabs .status-active {
  background: white;

  color: #101828;

  box-shadow: 0 2px 7px rgba(0,0,0,.07);
}


.games-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;
}


.game-card {
  background: white;

  border: 1px solid #e6e9ed;

  border-radius: 13px;

  padding: 17px;

  transition: .2s;

  box-shadow: 0 3px 12px rgba(0,0,0,.025);
}

.game-card:hover {
  transform: translateY(-2px);

  box-shadow: 0 10px 25px rgba(0,0,0,.07);
}


.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 13px;

  border-bottom: 1px solid #edf0f3;
}

.league-small {
  font-size: 11px;
  font-weight: 900;

  color: #354052;
}

.game-state {
  font-size: 9px;
  font-weight: 900;

  background: #f0f2f5;

  color: #667085;

  padding: 5px 8px;

  border-radius: 20px;
}

.game-state.is-live {
  background: #ffe7ea;
  color: #d81f32;
}


.card-teams {
  padding: 16px 0 12px;
}

.small-team {
  display: grid;

  grid-template-columns: 34px 1fr auto;

  align-items: center;

  gap: 10px;

  margin: 8px 0;
}

.mini-logo {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #f0f3f7;

  font-size: 9px;
  font-weight: 900;
}

.small-team span {
  color: #293343;

  font-size: 12px;
  font-weight: 700;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.small-team strong {
  font-size: 20px;
}


.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-top: 12px;

  border-top: 1px solid #edf0f3;

  color: #778291;

  font-size: 10px;
}

.watch-button {
  border: 0;

  background: #e51f31;

  color: white;

  padding: 8px 11px;

  border-radius: 6px;

  font-size: 10px;
  font-weight: 900;

  cursor: pointer;
}

.game-time {
  color: #27364a;

  font-weight: 800;
}


/* =========================
   COMING
========================= */

.coming-section {
  margin-top: 35px;

  display: flex;
  align-items: center;

  gap: 18px;

  padding: 24px;

  background: white;

  border: 1px solid #e4e8ed;

  border-radius: 13px;
}

.coming-icon {
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #edf3ff;

  border-radius: 12px;

  font-size: 22px;
}

.coming-section h2 {
  margin: 0 0 4px;

  font-size: 16px;

  color: #182230;
}

.coming-section p {
  margin: 0;

  color: #7a8594;

  font-size: 12px;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

  .games-grid {
    grid-template-columns:
      repeat(2, minmax(0,1fr));
  }

  .game-main {
    padding: 30px 20px;

    gap: 15px;
  }

  .team-name strong {
    font-size: 14px;
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {

  .sports-hero {
    padding: 36px 18px;
  }

  .hero-inner {
    display: block;
  }

  .live-indicator {
    margin-top: 20px;

    width: fit-content;
  }

  .sports-container {
    padding:
      25px 12px 45px;
  }

  .update-text {
    display: none;
  }

  .game-main {
    grid-template-columns:
      1fr auto 1fr;

    padding: 24px 12px;

    gap: 7px;
  }

  .team,
  .team-right {
    flex-direction: column;

    text-align: center;

    gap: 8px;
  }

  .team-logo {
    width: 52px;
    height: 52px;

    font-size: 13px;
  }

  .team-name strong {
    font-size: 11px;
  }

  .team-name span {
    font-size: 9px;
  }

  .score {
    gap: 7px;
  }

  .score strong {
    font-size: 35px;
  }

  .player-area {
    padding:
      0 10px 10px;
  }

  .player-placeholder {
    min-height: 230px;
  }

  .game-footer {
    padding: 12px;

    font-size: 9px;
  }

  .games-title {
    display: block;
  }

  .status-tabs {
    margin-top: 15px;

    overflow-x: auto;
  }

  .games-grid {
    grid-template-columns: 1fr;
  }

}

</style>

</Layout>