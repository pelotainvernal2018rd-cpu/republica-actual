---
import Layout from "../layouts/Layout.astro";

const deportes = [
  { id: "todos", nombre: "Todos", icono: "🏆" },
  { id: "mlb", nombre: "MLB", icono: "⚾" },
  { id: "lidom", nombre: "LIDOM", icono: "⚾" },
  { id: "nba", nombre: "NBA", icono: "🏀" },
  { id: "nfl", nombre: "NFL", icono: "🏈" },
  { id: "futbol", nombre: "Fútbol", icono: "⚽" },
];
---

<Layout title="Deportes en Vivo | República Actual">
<main class="sports-page">
  <section class="sports-hero">
    <div class="hero-inner">
      <div>
        <span class="section-label">REPÚBLICA ACTUAL</span>
        <h1>Deportes <span>EN VIVO</span></h1>
        <p>Marcadores, partidos y resultados de MLB, LIDOM, NBA, NFL y fútbol desde un solo lugar.</p>
      </div>
      <div class="live-indicator"><span class="live-dot"></span> ACTUALIZACIÓN EN VIVO</div>
    </div>
  </section>

  <section class="sports-nav">
    <div class="nav-scroll">
      {deportes.map((deporte) => (
        <button class:list={["sport-filter", deporte.id === "todos" && "active"]} data-sport={deporte.id}>
          <span>{deporte.icono}</span> {deporte.nombre}
        </button>
      ))}
    </div>
  </section>

  <div class="sports-container">
    <section class="featured-section" id="featured-section" hidden>
      <div class="section-heading">
        <div><span class="live-dot"></span> EN VIVO AHORA</div>
        <span class="update-text">Marcadores actualizados automáticamente</span>
      </div>

      <article class="featured-game">
        <div class="game-top">
          <div class="league" id="featured-league">DEPORTE</div>
          <div class="live-badge"><span></span> EN VIVO</div>
        </div>
        <div class="game-main">
          <div class="team">
            <div class="team-logo" id="featured-away-logo"></div>
            <div class="team-name"><strong id="featured-away"></strong><span id="featured-away-abbr"></span></div>
          </div>
          <div class="score-center">
            <div class="inning" id="featured-detail"></div>
            <div class="score"><strong id="featured-away-score">-</strong><span>—</span><strong id="featured-home-score">-</strong></div>
            <div class="game-status">Partido en progreso</div>
          </div>
          <div class="team team-right">
            <div class="team-logo" id="featured-home-logo"></div>
            <div class="team-name"><strong id="featured-home"></strong><span id="featured-home-abbr"></span></div>
          </div>
        </div>

        <div class="player-area">
          <div class="player-placeholder">
            <div class="player-icon">▶</div>
            <h3>Transmisión del partido</h3>
            <p>El reproductor aparecerá aquí cuando exista una transmisión autorizada disponible para este encuentro.</p>
          </div>
        </div>

        <div class="game-footer">
          <div><span>●</span> Marcador en vivo</div>
          <div>República Actual Deportes</div>
        </div>
      </article>
    </section>

    <section class="games-section">
      <div class="games-title">
        <div><span>📅</span><div><h2>Partidos de hoy</h2><p id="sports-date">Calendario deportivo</p></div></div>
        <div class="status-tabs">
          <button class="status-active" data-status="todos">Todos</button>
          <button data-status="live">En vivo</button>
          <button data-status="pre">Próximos</button>
          <button data-status="post">Finalizados</button>
        </div>
      </div>
      <div class="games-grid" id="games-grid">
        <div class="loading-sports">Cargando marcadores deportivos…</div>
      </div>
      <p class="source-note">Los datos se actualizan automáticamente. Los horarios se muestran en hora de República Dominicana.</p>
    </section>

    <section class="coming-section">
      <div class="coming-icon">📺</div>
      <div><h2>Más deportes, más acción</h2><p>MLB, LIDOM, NBA, NFL y las principales competiciones de fútbol en una sola sección.</p></div>
    </section>
  </div>
</main>

<script>
  const grid = document.getElementById("games-grid");
  const filtros = document.querySelectorAll(".sport-filter");
  const statusButtons = document.querySelectorAll(".status-tabs button");
  const featured = document.getElementById("featured-section");
  let juegos = [];
  let deporteActivo = "todos";
  let estadoActivo = "todos";

  const esc = (v = "") => String(v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const logo = (url, abbr) => url ? `<img src="${esc(url)}" alt="" loading="lazy">` : esc(abbr || "—");

  function horaRD(fecha) {
    if (!fecha) return "";
    return new Intl.DateTimeFormat("es-DO", {timeZone:"America/Santo_Domingo", hour:"numeric", minute:"2-digit"}).format(new Date(fecha));
  }

  function estadoTexto(j) {
    if (j.state === "live") return "EN VIVO";
    if (j.state === "post") return "FINAL";
    return "PRÓXIMO";
  }

  function render() {
    const visibles = juegos.filter(j =>
      (deporteActivo === "todos" || j.deporte === deporteActivo) &&
      (estadoActivo === "todos" || j.state === estadoActivo)
    );

    if (!visibles.length) {
      grid.innerHTML = `<div class="empty-sports">No hay partidos para este filtro en este momento.</div>`;
    } else {
      grid.innerHTML = visibles.map(j => `
        <article class="game-card" data-sport="${esc(j.deporte)}">
          <div class="card-header">
            <span class="league-small">${esc(j.liga)}</span>
            <span class="game-state ${j.state === "live" ? "is-live" : ""}">${estadoTexto(j)}</span>
          </div>
          <div class="card-teams">
            <div class="small-team">
              <div class="mini-logo">${logo(j.visitante.logo, j.visitante.abbr)}</div>
              <span>${esc(j.visitante.nombre)}</span><strong>${esc(j.visitante.score ?? "-")}</strong>
            </div>
            <div class="small-team">
              <div class="mini-logo">${logo(j.local.logo, j.local.abbr)}</div>
              <span>${esc(j.local.nombre)}</span><strong>${esc(j.local.score ?? "-")}</strong>
            </div>
          </div>
          <div class="card-footer">
            <span>${esc(j.detalle || (j.state === "pre" ? horaRD(j.fecha) : estadoTexto(j)))}</span>
            <span class="game-time">${j.state === "pre" ? horaRD(j.fecha) : estadoTexto(j)}</span>
          </div>
        </article>`).join("");
    }

    const enVivo = juegos.find(j => j.state === "live" && (deporteActivo === "todos" || j.deporte === deporteActivo));
    if (!enVivo) {
      featured.hidden = true;
      return;
    }
    featured.hidden = false;
    document.getElementById("featured-league").textContent = `${enVivo.icono || "🏆"} ${enVivo.liga}`;
    document.getElementById("featured-away").textContent = enVivo.visitante.nombre;
    document.getElementById("featured-home").textContent = enVivo.local.nombre;
    document.getElementById("featured-away-abbr").textContent = enVivo.visitante.abbr || "";
    document.getElementById("featured-home-abbr").textContent = enVivo.local.abbr || "";
    document.getElementById("featured-away-score").textContent = enVivo.visitante.score ?? "-";
    document.getElementById("featured-home-score").textContent = enVivo.local.score ?? "-";
    document.getElementById("featured-detail").textContent = enVivo.detalle || "EN VIVO";
    document.getElementById("featured-away-logo").innerHTML = logo(enVivo.visitante.logo, enVivo.visitante.abbr);
    document.getElementById("featured-home-logo").innerHTML = logo(enVivo.local.logo, enVivo.local.abbr);
  }

  async function cargar() {
    try {
      const r = await fetch("/api/deportes", {cache:"no-store"});
      if (!r.ok) throw new Error("No se pudieron cargar los deportes");
      const data = await r.json();
      juegos = Array.isArray(data.juegos) ? data.juegos : [];
      document.getElementById("sports-date").textContent =
        new Intl.DateTimeFormat("es-DO",{timeZone:"America/Santo_Domingo",weekday:"long",day:"numeric",month:"long"}).format(new Date());
      render();
    } catch (e) {
      grid.innerHTML = `<div class="error-sports">No fue posible actualizar los marcadores. Intentaremos nuevamente automáticamente.</div>`;
    }
  }

  filtros.forEach(b => b.addEventListener("click", () => {
    filtros.forEach(x => x.classList.remove("active")); b.classList.add("active");
    deporteActivo = b.dataset.sport || "todos"; render();
  }));

  statusButtons.forEach(b => b.addEventListener("click", () => {
    statusButtons.forEach(x => x.classList.remove("status-active")); b.classList.add("status-active");
    estadoActivo = b.dataset.status || "todos"; render();
  }));

  cargar();
  setInterval(cargar, 60000);
</script>

<style>

:global(body) {
  background: #f4f6f8;
}


/* =========================
   HERO
========================= */

.sports-hero {
  background:
    radial-gradient(circle at 85% 20%, rgba(24, 119, 242, .22), transparent 30%),
    linear-gradient(135deg, #07101e, #0b1d36 60%, #07101e);

  color: white;
  padding: 52px 20px;
}

.hero-inner {
  max-width: 1200px;
  margin: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}

.section-label {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  opacity: .7;
}

.sports-hero h1 {
  margin: 8px 0 10px;

  font-size: clamp(38px, 6vw, 68px);
  line-height: .95;

  font-weight: 900;
}

.sports-hero h1 span {
  color: #2f80ff;
}

.sports-hero p {
  max-width: 620px;

  color: #b9c5d6;

  font-size: 16px;
  line-height: 1.6;
}

.live-indicator {
  display: flex;
  align-items: center;
  gap: 9px;

  background: rgba(255,255,255,.08);

  border: 1px solid rgba(255,255,255,.12);

  padding: 12px 17px;

  border-radius: 30px;

  font-size: 11px;
  font-weight: 800;

  white-space: nowrap;
}

.live-dot {
  width: 8px;
  height: 8px;

  display: inline-block;

  border-radius: 50%;

  background: #ff2d2d;

  box-shadow: 0 0 0 5px rgba(255,45,45,.15);

  animation: pulse 1.4s infinite;
}

@keyframes pulse {

  0% {
    box-shadow: 0 0 0 0 rgba(255,45,45,.45);
  }

  70% {
    box-shadow: 0 0 0 8px rgba(255,45,45,0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(255,45,45,0);
  }

}


/* =========================
   FILTROS
========================= */

.sports-nav {
  background: white;

  border-bottom: 1px solid #e5e7eb;

  position: sticky;
  top: 0;

  z-index: 20;
}

.nav-scroll {
  max-width: 1200px;
  margin: auto;

  display: flex;
  gap: 5px;

  padding: 10px 15px;

  overflow-x: auto;
}

.sport-filter {
  border: 0;

  background: transparent;

  color: #5d6673;

  font-size: 14px;
  font-weight: 700;

  padding: 11px 16px;

  border-radius: 8px;

  cursor: pointer;

  white-space: nowrap;

  transition: .2s;
}

.sport-filter:hover {
  background: #f1f4f8;
}

.sport-filter.active {
  background: #0b1d36;
  color: white;
}


/* =========================
   CONTAINER
========================= */

.sports-container {
  max-width: 1200px;

  margin: auto;

  padding: 35px 20px 60px;
}


/* =========================
   DESTACADO
========================= */

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 14px;

  font-size: 13px;
  font-weight: 900;
}

.section-heading > div {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #e11d2e;
}

.update-text {
  color: #8993a2;

  font-size: 11px;
  font-weight: 600;
}


.featured-game {
  background: #081525;

  color: white;

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 15px 45px rgba(9, 22, 41, .18);
}

.game-top {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 17px 22px;

  border-bottom: 1px solid rgba(255,255,255,.08);
}

.league {
  font-weight: 900;
  font-size: 14px;
}

.live-badge {
  display: flex;
  align-items: center;
  gap: 7px;

  background: #e51f31;

  padding: 7px 12px;

  border-radius: 20px;

  font-size: 10px;
  font-weight: 900;
}

.live-badge span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: white;
}


.game-main {
  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  gap: 30px;

  padding: 34px 40px;
}

.team {
  display: flex;
  align-items: center;
  gap: 17px;
}

.team-right {
  flex-direction: row-reverse;
  text-align: right;
}

.team-logo {
  width: 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: rgba(255,255,255,.09);

  border: 1px solid rgba(255,255,255,.1);

  font-size: 18px;
  font-weight: 900;
}

.team-name {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.team-name strong {
  font-size: 17px;
}

.team-name span {
  font-size: 11px;
  color: #8494a9;
}


.score-center {
  text-align: center;
}

.inning {
  color: #f5b942;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1px;

  margin-bottom: 6px;
}

.score {
  display: flex;
  align-items: center;

  gap: 15px;

  font-size: 38px;
}

.score strong {
  font-size: 48px;
}

.score span {
  color: #66768c;

  font-size: 25px;
}

.game-status {
  color: #8796a9;

  font-size: 11px;

  margin-top: 4px;
}


/* =========================
   PLAYER
========================= */

.player-area {
  padding: 0 22px 22px;
}

.player-placeholder {
  min-height: 390px;

  background:
    radial-gradient(circle at center, #172d48, #050d17 65%);

  border-radius: 12px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 30px;
}

.player-icon {
  width: 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding-left: 5px;

  border-radius: 50%;

  background: white;

  color: #081525;

  font-size: 27px;

  margin-bottom: 18px;

  box-shadow: 0 10px 35px rgba(0,0,0,.35);
}

.player-placeholder h3 {
  margin: 0 0 8px;

  font-size: 20px;
}

.player-placeholder p {
  margin: 0;

  color: #8291a4;

  max-width: 430px;

  font-size: 13px;

  line-height: 1.5;
}

.game-footer {
  display: flex;
  justify-content: space-between;

  padding: 14px 22px;

  background: rgba(255,255,255,.035);

  color: #8291a4;

  font-size: 11px;
}

.game-footer span {
  color: #21d07a;
}


/* =========================
   PARTIDOS
========================= */

.games-section {
  margin-top: 42px;
}

.games-title {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;

  margin-bottom: 18px;
}

.games-title > div:first-child {
  display: flex;
  align-items: center;
  gap: 12px;
}

.games-title h2 {
  margin: 0;

  color: #111827;

  font-size: 21px;
}

.games-title p {
  margin: 3px 0 0;

  color: #8a94a3;

  font-size: 12px;
}

.status-tabs {
  display: flex;

  background: #e9edf2;

  padding: 4px;

  border-radius: 8px;
}

.status-tabs button {
  border: 0;

  background: transparent;

  padding: 8px 12px;

  font-size: 11px;
  font-weight: 700;

  color: #657080;

  border-radius: 6px;

  cursor: pointer;
}

.status-tabs .status-active {
  background: white;

  color: #101828;

  box-shadow: 0 2px 7px rgba(0,0,0,.07);
}


.games-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;
}


.game-card {
  background: white;

  border: 1px solid #e6e9ed;

  border-radius: 13px;

  padding: 17px;

  transition: .2s;

  box-shadow: 0 3px 12px rgba(0,0,0,.025);
}

.game-card:hover {
  transform: translateY(-2px);

  box-shadow: 0 10px 25px rgba(0,0,0,.07);
}


.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 13px;

  border-bottom: 1px solid #edf0f3;
}

.league-small {
  font-size: 11px;
  font-weight: 900;

  color: #354052;
}

.game-state {
  font-size: 9px;
  font-weight: 900;

  background: #f0f2f5;

  color: #667085;

  padding: 5px 8px;

  border-radius: 20px;
}

.game-state.is-live {
  background: #ffe7ea;
  color: #d81f32;
}


.card-teams {
  padding: 16px 0 12px;
}

.small-team {
  display: grid;

  grid-template-columns: 34px 1fr auto;

  align-items: center;

  gap: 10px;

  margin: 8px 0;
}

.mini-logo {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #f0f3f7;

  font-size: 9px;
  font-weight: 900;
}

.small-team span {
  color: #293343;

  font-size: 12px;
  font-weight: 700;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.small-team strong {
  font-size: 20px;
}


.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-top: 12px;

  border-top: 1px solid #edf0f3;

  color: #778291;

  font-size: 10px;
}

.watch-button {
  border: 0;

  background: #e51f31;

  color: white;

  padding: 8px 11px;

  border-radius: 6px;

  font-size: 10px;
  font-weight: 900;

  cursor: pointer;
}

.game-time {
  color: #27364a;

  font-weight: 800;
}


/* =========================
   COMING
========================= */

.coming-section {
  margin-top: 35px;

  display: flex;
  align-items: center;

  gap: 18px;

  padding: 24px;

  background: white;

  border: 1px solid #e4e8ed;

  border-radius: 13px;
}

.coming-icon {
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #edf3ff;

  border-radius: 12px;

  font-size: 22px;
}

.coming-section h2 {
  margin: 0 0 4px;

  font-size: 16px;

  color: #182230;
}

.coming-section p {
  margin: 0;

  color: #7a8594;

  font-size: 12px;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

  .games-grid {
    grid-template-columns:
      repeat(2, minmax(0,1fr));
  }

  .game-main {
    padding: 30px 20px;

    gap: 15px;
  }

  .team-name strong {
    font-size: 14px;
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {

  .sports-hero {
    padding: 36px 18px;
  }

  .hero-inner {
    display: block;
  }

  .live-indicator {
    margin-top: 20px;

    width: fit-content;
  }

  .sports-container {
    padding:
      25px 12px 45px;
  }

  .update-text {
    display: none;
  }

  .game-main {
    grid-template-columns:
      1fr auto 1fr;

    padding: 24px 12px;

    gap: 7px;
  }

  .team,
  .team-right {
    flex-direction: column;

    text-align: center;

    gap: 8px;
  }

  .team-logo {
    width: 52px;
    height: 52px;

    font-size: 13px;
  }

  .team-name strong {
    font-size: 11px;
  }

  .team-name span {
    font-size: 9px;
  }

  .score {
    gap: 7px;
  }

  .score strong {
    font-size: 35px;
  }

  .player-area {
    padding:
      0 10px 10px;
  }

  .player-placeholder {
    min-height: 230px;
  }

  .game-footer {
    padding: 12px;

    font-size: 9px;
  }

  .games-title {
    display: block;
  }

  .status-tabs {
    margin-top: 15px;

    overflow-x: auto;
  }

  .games-grid {
    grid-template-columns: 1fr;
  }

}

</style>

<style>
  .loading-sports,.empty-sports,.error-sports{grid-column:1/-1;padding:28px;text-align:center;background:#fff;border:1px solid #e6e9ed;border-radius:13px;color:#657080}
  .team-logo img,.mini-logo img{width:100%;height:100%;object-fit:contain}
  .team-logo,.mini-logo{overflow:hidden;padding:5px}
  .featured-section[hidden]{display:none}
  .game-card[hidden]{display:none}
  .source-note{margin-top:18px;color:#8a94a3;font-size:11px;text-align:center}
  .date-line{font-size:11px;color:#8993a2;margin-top:4px}
</style>

</Layout>
