---
import Layout from "../layouts/Layout.astro";

const deportes = [
  { id: "todos", nombre: "Todos", icono: "🏆" },
  { id: "mlb", nombre: "MLB", icono: "⚾" },
  { id: "lidom", nombre: "LIDOM", icono: "⚾" },
  { id: "nba", nombre: "NBA", icono: "🏀" },
  { id: "nfl", nombre: "NFL", icono: "🏈" },
  { id: "futbol", nombre: "Fútbol", icono: "⚽" },
];
---

<Layout title="Deportes en Vivo | República Actual">
<main class="sports-page">
  <section class="hero">
    <div class="hero-in">
      <div>
        <span class="eyebrow">REPÚBLICA ACTUAL DEPORTES</span>
        <h1>El juego se vive <span>EN VIVO</span></h1>
        <p>Marcadores, calendario, resultados y seguimiento de MLB, LIDOM, NBA, NFL y fútbol.</p>
      </div>
      <div class="live-pill"><i></i> ACTUALIZACIÓN EN VIVO</div>
    </div>
  </section>

  <nav class="league-nav">
    <div class="league-scroll">
      {deportes.map(d => (
        <button class:list={["league-btn", d.id === "todos" && "active"]} data-sport={d.id}>
          <span>{d.icono}</span>{d.nombre}
        </button>
      ))}
    </div>
  </nav>

  <div class="wrap">
    <section class="score-strip">
      <div class="section-head compact">
        <div><b>Partidos de hoy</b><span id="fecha-hoy"></span></div>
        <div class="status-tabs">
          <button class="active" data-status="todos">Todos</button>
          <button data-status="live">En vivo</button>
          <button data-status="pre">Próximos</button>
          <button data-status="post">Finalizados</button>
        </div>
      </div>
      <div id="score-carousel" class="score-carousel">
        <div class="loading">Cargando marcadores…</div>
      </div>
    </section>

    <section id="featured-wrap" class="featured-wrap" hidden>
      <div class="section-title"><span class="red-dot"></span> PARTIDO DESTACADO</div>
      <article class="featured">
        <div class="featured-top">
          <span id="f-league">DEPORTE</span>
          <span id="f-state" class="state live">EN VIVO</span>
        </div>
        <div class="featured-main">
          <div class="big-team">
            <div id="f-away-logo" class="big-logo"></div>
            <strong id="f-away"></strong>
            <small id="f-away-abbr"></small>
          </div>
          <div class="center-score">
            <span id="f-detail"></span>
            <div><b id="f-away-score">-</b><em>—</em><b id="f-home-score">-</b></div>
            <small id="f-time"></small>
          </div>
          <div class="big-team right">
            <div id="f-home-logo" class="big-logo"></div>
            <strong id="f-home"></strong>
            <small id="f-home-abbr"></small>
          </div>
        </div>
        <div class="player">
          <div class="play">▶</div>
          <h3>Centro de transmisión</h3>
          <p>Cuando exista una señal autorizada para este encuentro, podrá mostrarse aquí.</p>
        </div>
        <div class="featured-bottom"><span>● Datos actualizados automáticamente</span><span>República Actual Deportes</span></div>
      </article>
    </section>

    <section class="dashboard">
      <div class="main-column">
        <div class="section-head">
          <div><h2>Agenda deportiva</h2><p>Todos los encuentros disponibles para hoy</p></div>
        </div>
        <div id="games-grid" class="games-grid"></div>
      </div>

      <aside class="side-column">
        <div class="side-card">
          <div class="side-title">🔥 En vivo ahora</div>
          <div id="live-list" class="side-list"></div>
        </div>
        <div class="side-card">
          <div class="side-title">⏱ Próximos partidos</div>
          <div id="next-list" class="side-list"></div>
        </div>
        <div class="side-card leagues-card">
          <div class="side-title">🏆 Competiciones</div>
          <div class="league-list">
            <button data-jump="mlb">⚾ <span>MLB</span></button>
            <button data-jump="lidom">⚾ <span>LIDOM</span></button>
            <button data-jump="nba">🏀 <span>NBA</span></button>
            <button data-jump="nfl">🏈 <span>NFL</span></button>
            <button data-jump="futbol">⚽ <span>Fútbol</span></button>
          </div>
        </div>
      </aside>
    </section>

    <section class="results-block">
      <div class="section-head">
        <div><h2>Últimos resultados</h2><p>Partidos finalizados disponibles</p></div>
      </div>
      <div id="results-grid" class="results-grid"></div>
    </section>
  </div>
</main>

<script>
  const $ = (s) => document.querySelector(s);
  const $$ = (s) => [...document.querySelectorAll(s)];
  let games = [];
  let sport = "todos";
  let status = "todos";

  const escapeHTML = (v="") => String(v).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  const timeRD = (d) => d ? new Intl.DateTimeFormat("es-DO",{timeZone:"America/Santo_Domingo",hour:"numeric",minute:"2-digit"}).format(new Date(d)) : "";
  const stateText = s => s === "live" ? "EN VIVO" : s === "post" ? "FINAL" : "PRÓXIMO";
  const logo = t => t?.logo ? `<img src="${escapeHTML(t.logo)}" alt="" loading="lazy">` : `<span>${escapeHTML(t?.abbr || "—")}</span>`;

  function filtered(){
    return games.filter(g => (sport==="todos" || g.deporte===sport) && (status==="todos" || g.state===status));
  }

  function miniCard(g){
    return `<article class="score-card ${g.state==="live"?"is-live":""}">
      <div class="score-card-top"><b>${escapeHTML(g.liga)}</b><span class="badge ${g.state}">${stateText(g.state)}</span></div>
      <div class="score-row"><div class="tiny-logo">${logo(g.visitante)}</div><span>${escapeHTML(g.visitante.nombre)}</span><b>${escapeHTML(g.visitante.score ?? "-")}</b></div>
      <div class="score-row"><div class="tiny-logo">${logo(g.local)}</div><span>${escapeHTML(g.local.nombre)}</span><b>${escapeHTML(g.local.score ?? "-")}</b></div>
      <div class="score-meta">${escapeHTML(g.detalle || (g.state==="pre" ? timeRD(g.fecha) : stateText(g.state)))}</div>
    </article>`;
  }

  function gameCard(g){
    return `<article class="game-card">
      <div class="game-head"><b>${escapeHTML(g.liga)}</b><span class="badge ${g.state}">${stateText(g.state)}</span></div>
      <div class="team-line"><div class="team-icon">${logo(g.visitante)}</div><div><strong>${escapeHTML(g.visitante.nombre)}</strong><small>${escapeHTML(g.visitante.abbr || "")}</small></div><b>${escapeHTML(g.visitante.score ?? "-")}</b></div>
      <div class="team-line"><div class="team-icon">${logo(g.local)}</div><div><strong>${escapeHTML(g.local.nombre)}</strong><small>${escapeHTML(g.local.abbr || "")}</small></div><b>${escapeHTML(g.local.score ?? "-")}</b></div>
      <div class="game-foot"><span>${escapeHTML(g.detalle || stateText(g.state))}</span><strong>${g.state==="pre"?timeRD(g.fecha):stateText(g.state)}</strong></div>
    </article>`;
  }

  function sideItem(g){
    return `<div class="side-item"><div><b>${escapeHTML(g.visitante.abbr || g.visitante.nombre)}</b><span>vs</span><b>${escapeHTML(g.local.abbr || g.local.nombre)}</b></div><small>${g.state==="pre"?timeRD(g.fecha):(g.detalle || stateText(g.state))}</small></div>`;
  }

  function renderFeatured(){
    const pool = games.filter(g => sport==="todos" || g.deporte===sport);
    const g = pool.find(g=>g.state==="live") || pool.find(g=>g.state==="pre") || pool[0];
    const box = $("#featured-wrap");
    if(!g){ box.hidden=true; return; }
    box.hidden=false;
    $("#f-league").textContent = `${g.icono || "🏆"} ${g.liga}`;
    $("#f-state").textContent = stateText(g.state);
    $("#f-state").className = `state ${g.state}`;
    $("#f-away").textContent = g.visitante.nombre;
    $("#f-home").textContent = g.local.nombre;
    $("#f-away-abbr").textContent = g.visitante.abbr || "";
    $("#f-home-abbr").textContent = g.local.abbr || "";
    $("#f-away-score").textContent = g.visitante.score ?? "-";
    $("#f-home-score").textContent = g.local.score ?? "-";
    $("#f-detail").textContent = g.detalle || stateText(g.state);
    $("#f-time").textContent = g.state==="pre" ? timeRD(g.fecha) : "";
    $("#f-away-logo").innerHTML = logo(g.visitante);
    $("#f-home-logo").innerHTML = logo(g.local);
  }

  function render(){
    const list=filtered();
    $("#score-carousel").innerHTML = list.length ? list.slice(0,10).map(miniCard).join("") : `<div class="empty">No hay partidos para este filtro.</div>`;
    $("#games-grid").innerHTML = list.length ? list.map(gameCard).join("") : `<div class="empty">No hay encuentros disponibles.</div>`;

    const live=games.filter(g=>g.state==="live" && (sport==="todos"||g.deporte===sport)).slice(0,6);
    $("#live-list").innerHTML = live.length ? live.map(sideItem).join("") : `<p class="muted">No hay partidos en vivo ahora.</p>`;

    const next=games.filter(g=>g.state==="pre" && (sport==="todos"||g.deporte===sport)).slice(0,6);
    $("#next-list").innerHTML = next.length ? next.map(sideItem).join("") : `<p class="muted">No hay próximos partidos disponibles.</p>`;

    const done=games.filter(g=>g.state==="post" && (sport==="todos"||g.deporte===sport)).slice(0,6);
    $("#results-grid").innerHTML = done.length ? done.map(gameCard).join("") : `<div class="empty">No hay resultados finalizados disponibles.</div>`;
    renderFeatured();
  }

  async function load(){
    try{
      const r=await fetch("/api/deportes",{cache:"no-store"});
      if(!r.ok) throw new Error("API");
      const data=await r.json();
      games=Array.isArray(data.juegos)?data.juegos:[];
      $("#fecha-hoy").textContent=new Intl.DateTimeFormat("es-DO",{timeZone:"America/Santo_Domingo",weekday:"long",day:"numeric",month:"long"}).format(new Date());
      render();
    }catch(e){
      $("#score-carousel").innerHTML=`<div class="empty">No fue posible actualizar los marcadores. Se intentará nuevamente.</div>`;
      $("#games-grid").innerHTML=`<div class="empty">Marcadores temporalmente no disponibles.</div>`;
    }
  }

  $$(".league-btn").forEach(b=>b.addEventListener("click",()=>{
    $$(".league-btn").forEach(x=>x.classList.remove("active")); b.classList.add("active");
    sport=b.dataset.sport||"todos"; render();
  }));
  $$(".status-tabs button").forEach(b=>b.addEventListener("click",()=>{
    $$(".status-tabs button").forEach(x=>x.classList.remove("active")); b.classList.add("active");
    status=b.dataset.status||"todos"; render();
  }));
  $$("[data-jump]").forEach(b=>b.addEventListener("click",()=>{
    const target=b.dataset.jump; const btn=$(`.league-btn[data-sport="${target}"]`);
    if(btn) btn.click(); window.scrollTo({top:0,behavior:"smooth"});
  }));

  load();
  setInterval(load,60000);
</script>

<style is:global>
:root{--navy:#07172c;--navy2:#0d2747;--red:#e52336;--blue:#2f80ff;--ink:#172033;--muted:#7d8999;--line:#e5eaf0;--bg:#f4f7fa}
.sports-page{background:var(--bg);min-height:100vh;color:var(--ink)}
.hero{background:radial-gradient(circle at 85% 15%,rgba(47,128,255,.25),transparent 28%),linear-gradient(135deg,#06101f,#0b2340 65%,#071426);color:#fff;padding:52px 20px}
.hero-in{max-width:1200px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:30px}
.eyebrow{font-size:11px;font-weight:900;letter-spacing:2px;color:#9fb2ca}
.hero h1{margin:7px 0 10px;font-size:clamp(38px,6vw,66px);line-height:.98;font-weight:950}.hero h1 span{color:#4590ff}.hero p{margin:0;max-width:680px;color:#bac6d5;font-size:15px;line-height:1.6}
.live-pill{display:flex;align-items:center;gap:9px;border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.07);padding:11px 15px;border-radius:30px;font-size:10px;font-weight:900;white-space:nowrap}.live-pill i,.red-dot{width:8px;height:8px;background:#ff3347;border-radius:50%;box-shadow:0 0 0 5px rgba(255,51,71,.14)}
.league-nav{position:sticky;top:0;z-index:30;background:#fff;border-bottom:1px solid var(--line)}.league-scroll{max-width:1200px;margin:auto;display:flex;gap:5px;padding:10px 15px;overflow:auto}
.league-btn{border:0;background:transparent;color:#5e6877;font-weight:800;padding:11px 16px;border-radius:9px;white-space:nowrap;cursor:pointer}.league-btn.active{background:var(--navy2);color:#fff}
.wrap{max-width:1200px;margin:auto;padding:30px 18px 60px}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:15px}.section-head.compact>div:first-child{display:flex;flex-direction:column}.section-head h2{margin:0;font-size:21px}.section-head p,.section-head span{margin:3px 0 0;color:var(--muted);font-size:11px}
.status-tabs{display:flex;background:#e9eef4;padding:4px;border-radius:9px;overflow:auto}.status-tabs button{border:0;background:transparent;padding:8px 11px;border-radius:7px;color:#667284;font-size:10px;font-weight:800;white-space:nowrap}.status-tabs button.active{background:#fff;color:#142033;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.score-carousel{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:12px;overflow-x:auto;padding-bottom:5px}.score-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px;box-shadow:0 3px 12px rgba(15,35,60,.035)}.score-card.is-live{border-top:3px solid var(--red)}
.score-card-top,.game-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:10px;border-bottom:1px solid #edf1f5}.score-card-top b,.game-head b{font-size:10px}.badge,.state{padding:5px 8px;border-radius:999px;background:#f0f3f6;color:#697486;font-size:8px;font-weight:950}.badge.live,.state.live{background:#ffe5e9;color:#d51d32}.badge.post,.state.post{background:#eaf7ef;color:#23794a}
.score-row{display:grid;grid-template-columns:28px minmax(0,1fr) 24px;align-items:center;gap:8px;margin:10px 0}.score-row>span{font-size:11px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.score-row>b{text-align:right;font-size:16px}.tiny-logo,.team-icon{display:flex;align-items:center;justify-content:center;overflow:hidden;background:#f2f5f8;border-radius:50%}.tiny-logo{width:28px;height:28px;padding:3px}.tiny-logo img{width:22px!important;height:22px!important;max-width:22px!important;max-height:22px!important;object-fit:contain!important}.score-meta{padding-top:9px;border-top:1px solid #edf1f5;color:var(--muted);font-size:9px}
.featured-wrap{margin-top:34px}.section-title{display:flex;align-items:center;gap:10px;margin-bottom:12px;color:#d61f33;font-size:11px;font-weight:950;letter-spacing:.5px}.featured{overflow:hidden;background:var(--navy);color:#fff;border-radius:18px;box-shadow:0 18px 45px rgba(7,23,44,.16)}.featured-top{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-bottom:1px solid rgba(255,255,255,.08);font-size:12px;font-weight:900}
.featured-main{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:30px;padding:30px 40px}.big-team{display:flex;align-items:center;gap:16px}.big-team.right{flex-direction:row-reverse;text-align:right}.big-team strong{font-size:17px}.big-team small{display:block;color:#8495aa;margin-top:4px}.big-logo{width:72px;height:72px;flex:0 0 72px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.08);padding:8px;overflow:hidden}.big-logo img{width:56px!important;height:56px!important;max-width:56px!important;max-height:56px!important;object-fit:contain!important}
.center-score{text-align:center}.center-score>span{color:#f5ba43;font-size:9px;font-weight:950;letter-spacing:.7px}.center-score>div{display:flex;align-items:center;gap:14px;margin:5px 0}.center-score b{font-size:46px}.center-score em{font-style:normal;color:#64758b;font-size:24px}.center-score small{color:#8b9aab}
.player{margin:0 22px 20px;min-height:280px;border-radius:13px;background:radial-gradient(circle,#18304e,#050d17 67%);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:25px}.player .play{width:62px;height:62px;border-radius:50%;background:#fff;color:#07172c;display:flex;align-items:center;justify-content:center;padding-left:4px;font-size:22px;box-shadow:0 10px 30px rgba(0,0,0,.3)}.player h3{margin:14px 0 6px}.player p{margin:0;max-width:470px;color:#8494a8;font-size:12px}.featured-bottom{display:flex;justify-content:space-between;padding:13px 22px;background:rgba(255,255,255,.035);color:#8494a8;font-size:10px}.featured-bottom span:first-child{color:#52cf8b}
.dashboard{display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,.8fr);gap:22px;margin-top:38px}.games-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.game-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:0 4px 15px rgba(15,35,60,.04)}.team-line{display:grid;grid-template-columns:38px minmax(0,1fr) 34px;align-items:center;gap:10px;margin:13px 0}.team-icon{width:34px;height:34px;padding:4px}.team-icon img{width:26px!important;height:26px!important;max-width:26px!important;max-height:26px!important;object-fit:contain!important}.team-line strong{display:block;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.team-line small{display:block;margin-top:2px;color:#8a94a2;font-size:8px}.team-line>b{text-align:right;font-size:20px}.game-foot{display:flex;justify-content:space-between;gap:8px;padding-top:11px;border-top:1px solid #edf1f5;color:#788393;font-size:9px}.game-foot strong{color:#26364a}
.side-column{display:flex;flex-direction:column;gap:14px}.side-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px}.side-title{font-size:12px;font-weight:950;padding-bottom:12px;border-bottom:1px solid #edf1f5}.side-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid #f0f2f5}.side-item:last-child{border-bottom:0}.side-item>div{display:flex;align-items:center;gap:6px;font-size:10px}.side-item span{color:#a0a8b3}.side-item small{color:#667284;font-size:9px;white-space:nowrap}.muted{color:#8b95a2;font-size:10px}
.league-list{display:grid;gap:7px;padding-top:12px}.league-list button{display:flex;align-items:center;gap:10px;border:0;background:#f5f7fa;padding:10px;border-radius:9px;text-align:left;font-weight:800;color:#344054;cursor:pointer}.league-list button:hover{background:#edf2f8}
.results-block{margin-top:38px}.results-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.empty,.loading{grid-column:1/-1;background:#fff;border:1px solid var(--line);border-radius:13px;padding:25px;text-align:center;color:#7e8998;font-size:11px}
[hidden]{display:none!important}
@media(max-width:900px){.score-carousel{grid-template-columns:repeat(4,240px)}.dashboard{grid-template-columns:1fr}.games-grid,.results-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.side-column{display:grid;grid-template-columns:repeat(2,1fr)}.leagues-card{grid-column:1/-1}.featured-main{padding:28px 20px;gap:15px}}
@media(max-width:650px){.hero{padding:36px 18px}.hero-in{display:block}.live-pill{width:max-content;margin-top:18px}.wrap{padding:24px 12px 45px}.section-head{display:block}.status-tabs{margin-top:12px}.score-carousel{grid-template-columns:repeat(4,220px)}.featured-main{grid-template-columns:1fr auto 1fr;padding:22px 10px;gap:6px}.big-team,.big-team.right{flex-direction:column;text-align:center;gap:7px}.big-logo{width:50px;height:50px;flex-basis:50px;padding:5px}.big-logo img{width:40px!important;height:40px!important;max-width:40px!important;max-height:40px!important}.big-team strong{font-size:10px}.center-score b{font-size:32px}.player{margin:0 10px 10px;min-height:220px}.featured-bottom{padding:11px;font-size:8px}.games-grid,.results-grid,.side-column{grid-template-columns:1fr}.leagues-card{grid-column:auto}}
</style>
</Layout>
