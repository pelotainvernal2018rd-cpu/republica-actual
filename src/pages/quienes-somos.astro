
---
const siteUrl = 'https://republicaactual.net';
const canonical = `${siteUrl}/quienes-somos/`;

const titulo = 'Quiénes somos | República Actual';
const descripcion =
  'Conoce República Actual, medio digital de noticias de República Dominicana. Nuestra misión, compromiso editorial y canales de contacto.';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonical}#aboutpage`,
  url: canonical,
  name: titulo,
  description: descripcion,
  inLanguage: 'es-DO',
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
  about: {
    '@id': `${siteUrl}/#organization`,
  },
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
};
---

<!doctype html>
<html lang="es-DO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Código oficial de Google AdSense: NO CAMBIAR -->
    <meta
      name="google-adsense-account"
      content="ca-pub-3370737258151824"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:site_name" content="República Actual" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(aboutSchema)}
    />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="República Actual, inicio">
          República <span>Actual</span>
        </a>
        <nav aria-label="Navegación principal">
          <a href="/">Inicio</a>
          <a href="/contacto/">Contacto</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <article>
        <p class="eyebrow">CONOCE NUESTRO MEDIO</p>

        <h1>Quiénes somos: República Actual</h1>

        <p class="intro">
          <strong>República Actual</strong> es un medio digital de
          noticias enfocado en ofrecer información de interés para
          los lectores de República Dominicana y la comunidad
          dominicana en el exterior.
        </p>

        <section aria-labelledby="sobre-nosotros">
          <h2 id="sobre-nosotros">Sobre República Actual</h2>
          <p>
            En República Actual trabajamos para acercar a nuestros
            lectores a los acontecimientos de actualidad, con
            información organizada, accesible y fácil de consultar.
          </p>
          <p>
            Nuestro portal reúne contenidos sobre noticias nacionales,
            internacionales, deportes, economía, entretenimiento y
            otros temas de interés general.
          </p>
        </section>

        <section aria-labelledby="mision">
          <h2 id="mision">Nuestra misión</h2>
          <p>
            Nuestra misión es facilitar el acceso a información
            relevante y útil para que nuestros lectores puedan
            mantenerse al tanto de los acontecimientos que afectan
            su entorno y su vida cotidiana.
          </p>
        </section>

        <section aria-labelledby="compromiso">
          <h2 id="compromiso">Nuestro compromiso editorial</h2>
          <p>
            Aspiramos a publicar contenidos claros, responsables y
            comprensibles, diferenciando la información de las
            opiniones cuando corresponda.
          </p>
          <p>
            Reconocemos la importancia de verificar los datos,
            consultar fuentes identificables y actualizar o corregir
            los contenidos cuando se detecten errores.
          </p>
        </section>

        <section aria-labelledby="contenidos">
          <h2 id="contenidos">¿Qué encontrarás en nuestro portal?</h2>

          <ul>
            <li>
              <strong>Noticias nacionales:</strong> acontecimientos
              relevantes de República Dominicana.
            </li>
            <li>
              <strong>Noticias internacionales:</strong> hechos de
              interés mundial.
            </li>
            <li>
              <strong>Deportes:</strong> información y actualidad
              deportiva.
            </li>
            <li>
              <strong>Economía:</strong> temas económicos y financieros
              de interés público.
            </li>
            <li>
              <strong>República Útil:</strong> guías prácticas y
              contenidos informativos de consulta.
            </li>
            <li>
              <strong>Empleos:</strong> información sobre oportunidades
              laborales.
            </li>
          </ul>
        </section>

        <section aria-labelledby="correcciones">
          <h2 id="correcciones">Correcciones y actualizaciones</h2>
          <p>
            Si identificas información incorrecta, desactualizada
            o que requiera aclaración, puedes comunicarlo a través
            de nuestra página de contacto para su revisión.
          </p>
        </section>

        <section aria-labelledby="contacto">
          <h2 id="contacto">Contacto</h2>
          <p>
            Para consultas, sugerencias o solicitudes relacionadas
            con nuestros contenidos, visita nuestra página de contacto.
          </p>
          <a class="contact-button" href="/contacto/">
            Contactar con República Actual
          </a>
        </section>
      </article>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} República Actual.</p>
      <div class="footer-links">
        <a href="/">Inicio</a>
        <a href="/politica-de-privacidad/">Privacidad</a>
        <a href="/terminos-y-condiciones/">Términos</a>
        <a href="/contacto/">Contacto</a>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fa;
    color: #202938;
    line-height: 1.75;
  }

  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }

  .header-inner {
    max-width: 1100px;
    margin: auto;
    padding: 18px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .brand {
    font-size: 25px;
    font-weight: 800;
    color: #172b4d;
    text-decoration: none;
  }

  .brand span {
    color: #e32732;
  }

  nav {
    display: flex;
    gap: 18px;
  }

  nav a,
  .footer-links a {
    color: inherit;
    text-decoration: none;
  }

  nav a:hover,
  .footer-links a:hover {
    text-decoration: underline;
  }

  .container {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 18px;
  }

  article {
    background: #ffffff;
    padding: 45px;
    border: 1px solid #e6eaf0;
    border-radius: 14px;
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.04);
  }

  .eyebrow {
    color: #d72332;
    font-weight: 800;
    letter-spacing: 1.4px;
    font-size: 12px;
  }

  h1 {
    font-size: clamp(30px, 5vw, 43px);
    line-height: 1.2;
    color: #132744;
    margin: 12px 0 24px;
  }

  h2 {
    font-size: 23px;
    line-height: 1.35;
    color: #172b4d;
    margin: 0 0 15px;
  }

  .intro {
    font-size: 19px;
    color: #3c4a5c;
    padding-bottom: 26px;
    border-bottom: 1px solid #e6eaf0;
  }

  section {
    margin-top: 34px;
  }

  p {
    margin: 0 0 15px;
  }

  ul {
    padding-left: 23px;
  }

  li {
    margin-bottom: 12px;
  }

  .contact-button {
    display: inline-block;
    background: #d92332;
    color: white;
    padding: 12px 22px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: 700;
  }

  .contact-button:hover {
    background: #b91c2b;
  }

  footer {
    background: #14243c;
    color: white;
    text-align: center;
    padding: 28px 20px;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-direction: column;
      gap: 8px;
    }

    article {
      padding: 25px 20px;
    }

    .container {
      margin: 20px auto;
    }

    h2 {
      font-size: 21px;
    }
  }
</style>
