---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Deportes en Vivo | República Actual">

  <main class="watch-page">

    <a class="back" href="/deportes-en-vivo/">
      ← Volver a Deportes en Vivo
    </a>

    <section class="watch-grid">

      <div>

        <!-- REPRODUCTOR -->
        <div class="player-shell" id="player-shell">

          <div class="waiting" id="waiting">

            <span class="eyebrow" id="player-status">
              PARTIDO PROGRAMADO
            </span>

            <h1 id="player-title">
              EL JUEGO COMENZARÁ PRONTO
            </h1>

            <p id="player-message">
              El reproductor estará disponible cuando exista una transmisión autorizada para este encuentro.
            </p>

            <small>
              Tiempo hasta el inicio
            </small>

            <div class="countdown" id="countdown">
              --:--:--
            </div>

          </div>

          <div class="media" id="media" hidden></div>

        </div>


        <!-- INFORMACIÓN DEBAJO -->
        <div class="match-heading">

          <div>

            <span class="league-red" id="league-bottom">
              DEPORTE
            </span>

            <h2 id="match-title">
              Cargando partido...
            </h2>

            <p id="match-date"></p>

          </div>

          <span class="state-pill" id="state-pill">
            CARGANDO
          </span>

        </div>

      </div>


      <!-- INFORMACIÓN DEL JUEGO -->
      <aside class="info-card">

        <span class="brand">
          REPÚBLICA ACTUAL
        </span>

        <h2>
          Información del juego
        </h2>

        <dl>

          <div>
            <dt>Liga</dt>
            <dd id="info-league">—</dd>
          </div>

          <div>
            <dt>Visitante</dt>
            <dd id="info-away">—</dd>
          </div>

          <div>
            <dt>Local</dt>
            <dd id="info-home">—</dd>
          </div>

          <div>
            <dt>Estado</dt>
            <dd id="info-state">—</dd>
          </div>

          <div>
            <dt>Hora RD</dt>
            <dd id="info-time">—</dd>
          </div>

        </dl>

      </aside>

    </section>

  </main>

</Layout>


<script is:inline>

(() => {

  const $ = (id) =>
    document.getElementById(id);

  const id =
    new URLSearchParams(
      location.search
    ).get("id");

  let timer = null;


  /* =========================================
     ESTADOS
  ========================================== */

  const stateText = (s) =>
    s === "live"
      ? "EN VIVO"
      : s === "post"
        ? "FINALIZADO"
        : "PROGRAMADO";


  /* =========================================
     FECHA RD
  ========================================== */

  const dateRD = (iso) =>

    iso
      ? new Intl.DateTimeFormat(
          "es-DO",
          {
            timeZone:
              "America/Santo_Domingo",

            weekday:
              "long",

            day:
              "numeric",

            month:
              "long",

            hour:
              "numeric",

            minute:
              "2-digit"
          }
        ).format(
          new Date(iso)
        )

      : "—";


  /* =========================================
     HORA RD
  ========================================== */

  const timeRD = (iso) =>

    iso
      ? new Intl.DateTimeFormat(
          "es-DO",
          {
            timeZone:
              "America/Santo_Domingo",

            hour:
              "numeric",

            minute:
              "2-digit"
          }
        ).format(
          new Date(iso)
        )

      : "—";


  /* =========================================
     CUENTA REGRESIVA
  ========================================== */

  function countdown(
    iso,
    state
  ) {

    if (timer) {
      clearInterval(timer);
    }

    if (
      !iso ||
      state !== "pre"
    ) {

      $("countdown").textContent =
        state === "live"
          ? "EN VIVO"
          : "FINALIZADO";

      return;
    }

    const tick = () => {

      const d =
        new Date(iso).getTime() -
        Date.now();

      if (d <= 0) {

        $("countdown").textContent =
          "00:00:00";

        clearInterval(timer);

        return;
      }

      const h =
        Math.floor(
          d / 3600000
        );

      const m =
        Math.floor(
          (d % 3600000) /
          60000
        );

      const s =
        Math.floor(
          (d % 60000) /
          1000
        );

      $("countdown").textContent =
        `${String(h).padStart(2,"0")}:` +
        `${String(m).padStart(2,"0")}:` +
        `${String(s).padStart(2,"0")}`;

    };

    tick();

    timer =
      setInterval(
        tick,
        1000
      );

  }


  /* =========================================
     REPRODUCTOR
  ========================================== */

  function loadPlayer(g) {

    if (!g.stream_url) {
      return;
    }

    const media =
      $("media");

    const waiting =
      $("waiting");

    const url =
      String(
        g.stream_url
      );

    /*
      OCULTAMOS LA CUENTA REGRESIVA
      CUANDO EXISTE UNA TRANSMISIÓN
    */

    waiting.hidden =
      true;

    media.hidden =
      false;


    /* =========================================
       MP4 / WEBM
    ========================================== */

    if (
      /\.(mp4|webm)(\?|$)/i.test(
        url
      )
    ) {

      media.innerHTML =
        `<video
          controls
          autoplay
          playsinline
          src="${url.replace(/"/g,"&quot;")}"
        ></video>`;

      return;
    }


    /* =========================================
       HLS
    ========================================== */

    if (
      /\.m3u8(\?|$)/i.test(
        url
      )
    ) {

      const video =
        document.createElement(
          "video"
        );

      video.controls =
        true;

      video.autoplay =
        true;

      video.playsInline =
        true;


      if (
        video.canPlayType(
          "application/vnd.apple.mpegurl"
        )
      ) {

        video.src =
          url;

        media.replaceChildren(
          video
        );

      }

      else {

        media.hidden =
          true;

        waiting.hidden =
          false;

        $("player-title").textContent =
          "TRANSMISIÓN NO COMPATIBLE";

        $("player-message").textContent =
          "Este navegador no puede reproducir directamente esta señal HLS.";

      }

      return;
    }


    /* =========================================
       IFRAME / DAILYMOTION / EMBED
    ========================================== */

    const iframe =
      document.createElement(
        "iframe"
      );

    iframe.src =
      url;

    iframe.allow =
      "autoplay; fullscreen; picture-in-picture";

    iframe.allowFullscreen =
      true;

    iframe.referrerPolicy =
      "strict-origin-when-cross-origin";

    iframe.setAttribute(
      "title",
      "Transmisión deportiva"
    );

    media.replaceChildren(
      iframe
    );

  }


  /* =========================================
     CARGAR PARTIDO
  ========================================== */

  async function init() {

    if (!id) {

      $("match-title").textContent =
        "Partido no especificado";

      return;

    }


    try {

      const response =
        await fetch(
          "/api/deportes",
          {
            cache:
              "no-store"
          }
        );


      if (!response.ok) {

        throw new Error(
          "Error cargando deportes"
        );

      }


      const data =
        await response.json();


      const g =
        (data.juegos || [])
          .find(
            (x) =>
              String(x.id) ===
              String(id)
          );


      if (!g) {

        throw new Error(
          "Partido no encontrado"
        );

      }


      const title =
        `${g.visitante.nombre} vs ${g.local.nombre}`;


      const st =
        stateText(
          g.state
        );


      /* =========================================
         INFORMACIÓN PRINCIPAL
      ========================================== */

      $("league-bottom").textContent =
        g.liga ||
        "DEPORTE";


      $("match-title").textContent =
        title;


      $("match-date").textContent =
        dateRD(
          g.fecha
        );


      /* =========================================
         ESTADO
      ========================================== */

      $("state-pill").textContent =
        st;


      $("state-pill")
        .classList
        .toggle(
          "live",
          g.state === "live"
        );


      /* =========================================
         TARJETA DERECHA
      ========================================== */

      $("info-league").textContent =
        g.liga ||
        "—";


      $("info-away").textContent =
        g.visitante.nombre;


      $("info-home").textContent =
        g.local.nombre;


      $("info-state").textContent =
        st;


      $("info-time").textContent =
        timeRD(
          g.fecha
        );


      /* =========================================
         TEXTO DEL PLAYER
      ========================================== */

      $("player-status").textContent =

        g.state === "live"

          ? "PARTIDO EN VIVO"

          : g.state === "post"

            ? "PARTIDO FINALIZADO"

            : "PARTIDO PROGRAMADO";


      $("player-title").textContent =

        g.state === "live"

          ? "TRANSMISIÓN EN VIVO"

          : g.state === "post"

            ? "EL PARTIDO HA FINALIZADO"

            : "EL JUEGO COMENZARÁ PRONTO";


      countdown(
        g.fecha,
        g.state
      );


      /* =========================================
         CAMBIO IMPORTANTE

         SI EXISTE STREAM_URL,
         ABRIMOS EL REPRODUCTOR INMEDIATAMENTE.

         NO ESPERAMOS A QUE MLB MARQUE "LIVE".
      ========================================== */

      if (
        g.stream_url
      ) {

        loadPlayer(g);

      }

    }


    catch(error) {

      console.error(
        error
      );


      $("match-title").textContent =
        "No pudimos cargar este partido";


      $("player-title").textContent =
        "PARTIDO NO DISPONIBLE";


      $("player-message").textContent =
        "Vuelve a Deportes en Vivo y selecciona otro encuentro.";

    }

  }


  init();

})();

</script>


<style is:global>


/* =========================================
   PÁGINA BLANCA
========================================= */

.watch-page {

  max-width:
    1280px;

  margin:
    auto;

  padding:
    28px 22px 60px;

  color:
    #111827;

  background:
    #ffffff;

}


.watch-page::before {

  content:
    "";

  position:
    fixed;

  inset:
    0;

  background:
    #ffffff;

  z-index:
    -1;

}


/* =========================================
   VOLVER
========================================= */

.watch-page .back {

  display:
    inline-block;

  margin-bottom:
    18px;

  color:
    #2563eb;

  text-decoration:
    none;

  font-weight:
    700;

}


.watch-page .back:hover {

  text-decoration:
    underline;

}


/* =========================================
   ESTRUCTURA
========================================= */

.watch-grid {

  display:
    grid;

  grid-template-columns:
    minmax(0,1fr) 320px;

  gap:
    26px;

}


/* =========================================
   REPRODUCTOR
========================================= */

.player-shell {

  aspect-ratio:
    16 / 9;

  background:
    #020305;

  border:
    1px solid #263c5a;

  border-radius:
    22px;

  overflow:
    hidden;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  color:
    #ffffff;

  box-shadow:
    0 10px 35px
    rgba(15,23,42,.14);

}


/* =========================================
   ESPERA
========================================= */

.waiting {

  width:
    100%;

  text-align:
    center;

  padding:
    30px;

  color:
    #ffffff;

}


.eyebrow,
.league-red,
.brand {

  color:
    #ff334f;

  font-size:
    12px;

  font-weight:
    900;

  letter-spacing:
    .16em;

}


.waiting h1 {

  color:
    #ffffff;

  font-size:
    clamp(
      30px,
      4vw,
      58px
    );

  line-height:
    1;

  margin:
    12px 0;

}


.waiting p {

  color:
    #9bb3d2;

}


.waiting small {

  display:
    block;

  margin-top:
    34px;

  color:
    #9bb3d2;

  font-weight:
    700;

}


.countdown {

  color:
    #ffffff;

  font-size:
    clamp(
      42px,
      6vw,
      76px
    );

  font-weight:
    900;

  margin-top:
    8px;

}


/* =========================================
   VIDEO / IFRAME
========================================= */

.media {

  width:
    100%;

  height:
    100%;

  background:
    #000000;

}


.media video,
.media iframe {

  display:
    block;

  width:
    100%;

  height:
    100%;

  border:
    0;

  background:
    #000000;

}


/* =========================================
   DATOS DEBAJO
========================================= */

.match-heading {

  display:
    flex;

  justify-content:
    space-between;

  gap:
    20px;

  align-items:
    flex-start;

  padding:
    28px 2px;

}


.match-heading h2 {

  color:
    #111827;

  font-size:
    clamp(
      28px,
      4vw,
      50px
    );

  line-height:
    1.08;

  margin:
    8px 0;

}


.match-heading p {

  color:
    #64748b;

  margin:
    0;

}


/* =========================================
   ESTADO
========================================= */

.state-pill {

  border:
    1px solid #d6a719;

  background:
    #fff8dc;

  color:
    #9a6700;

  padding:
    10px 15px;

  border-radius:
    999px;

  font-weight:
    900;

  font-size:
    12px;

  white-space:
    nowrap;

}


.state-pill.live {

  border-color:
    #ff334f;

  background:
    #fff0f2;

  color:
    #d81735;

}


/* =========================================
   INFORMACIÓN DEL JUEGO
========================================= */

.info-card {

  background:
    #ffffff;

  color:
    #111827;

  border:
    1px solid #e2e8f0;

  border-radius:
    22px;

  padding:
    28px;

  height:
    max-content;

  box-shadow:
    0 8px 30px
    rgba(15,23,42,.08);

}


.info-card h2 {

  color:
    #111827;

  font-size:
    25px;

  margin:
    12px 0 20px;

}


.info-card dl {

  margin:
    0;

}


.info-card dl div {

  padding:
    15px 0;

  border-bottom:
    1px solid #e2e8f0;

}


.info-card dl div:last-child {

  border-bottom:
    0;

}


.info-card dt {

  font-size:
    12px;

  color:
    #64748b;

  margin-bottom:
    7px;

}


.info-card dd {

  margin:
    0;

  color:
    #111827;

  font-size:
    16px;

  font-weight:
    900;

}


/* =========================================
   MÓVIL
========================================= */

@media(
  max-width:
    850px
) {

  .watch-grid {

    grid-template-columns:
      1fr;

  }


  .info-card {

    order:
      2;

  }


  .match-heading {

    flex-direction:
      column;

  }


  .watch-page {

    padding:
      18px 14px 45px;

  }


  .player-shell {

    border-radius:
      14px;

  }


  .waiting {

    padding:
      18px;

  }


  .waiting small {

    margin-top:
      22px;

  }

}

</style>