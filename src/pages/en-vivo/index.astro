---
import Layout from "../../layouts/Layout.astro";
import VisitantesEnVivo from "../../components/VisitantesEnVivo.astro";
---

<Layout title="Deportes en Vivo | República Actual">

  <main class="watch-page">

    <a class="back" href="/deportes-en-vivo/">
      ← Volver a Deportes en Vivo
    </a>

    <section class="watch-grid">

      <div>

        <!-- =====================================
             REPRODUCTOR
        ====================================== -->

        <div class="player-shell" id="player-shell">

          <!-- TRANSMISIÓN -->
          <div class="media" id="media" hidden></div>

          <!-- CONTADOR SOBRE LA TRANSMISIÓN -->
          <div class="countdown-overlay" id="countdown-overlay">

            <div class="countdown-content">

              <span class="eyebrow" id="player-status">
                PARTIDO PROGRAMADO
              </span>

              <h1 id="player-title">
                EL JUEGO COMENZARÁ PRONTO
              </h1>

              <p id="player-message">
                La transmisión estará disponible al comenzar el encuentro.
              </p>

              <small>
                Tiempo hasta el inicio
              </small>

              <div class="countdown" id="countdown">
                --:--:--
              </div>

            </div>

          </div>

        </div>


        <!-- =====================================
             INFORMACIÓN DEBAJO
        ====================================== -->

        <div class="match-heading">

          <div>

            <span class="league-red" id="league-bottom">
              DEPORTE
            </span>

            <h2 id="match-title">
              Cargando partido...
            </h2>

            <p id="match-date"></p>

          </div>

          <span class="state-pill" id="state-pill">
            CARGANDO
          </span>

        </div>

      </div>


      <!-- =====================================
           INFORMACIÓN DEL JUEGO
      ====================================== -->

      <aside class="info-card">

        <span class="brand">
          REPÚBLICA ACTUAL
        </span>

        <h2>
          Información del juego
        </h2>

        <dl>

          <div>
            <dt>Liga</dt>
            <dd id="info-league">—</dd>
          </div>

          <div>
            <dt>Visitante</dt>
            <dd id="info-away">—</dd>
          </div>

          <div>
            <dt>Local</dt>
            <dd id="info-home">—</dd>
          </div>

          <div>
            <dt>Estado</dt>
            <dd id="info-state">—</dd>
          </div>

          <div>
            <dt>Hora RD</dt>
            <dd id="info-time">—</dd>
          </div>

        </dl>

      </aside>

    </section>

    <!-- CONTADOR DE VISITANTES EN VIVO -->
    <div class="visitantes-en-vivo">
      <VisitantesEnVivo />
    </div>

  </main>

</Layout>


<script is:inline>

(() => {

  const $ = (id) =>
    document.getElementById(id);


  const id =
    new URLSearchParams(
      location.search
    ).get("id");


  let timer = null;


  /* =========================================
     ESTADOS
  ========================================== */

  const stateText = (state) => {

    if (state === "live") {
      return "EN VIVO";
    }

    if (state === "post") {
      return "FINALIZADO";
    }

    return "PROGRAMADO";

  };


  /* =========================================
     FECHA RD
  ========================================== */

  const dateRD = (iso) => {

    if (!iso) {
      return "—";
    }

    return new Intl.DateTimeFormat(
      "es-DO",
      {
        timeZone: "America/Santo_Domingo",
        weekday: "long",
        day: "numeric",
        month: "long",
        hour: "numeric",
        minute: "2-digit"
      }
    ).format(
      new Date(iso)
    );

  };


  /* =========================================
     HORA RD
  ========================================== */

  const timeRD = (iso) => {

    if (!iso) {
      return "—";
    }

    return new Intl.DateTimeFormat(
      "es-DO",
      {
        timeZone: "America/Santo_Domingo",
        hour: "numeric",
        minute: "2-digit"
      }
    ).format(
      new Date(iso)
    );

  };


  /* =========================================
     OCULTAR CONTADOR
  ========================================== */

  function hideCountdown() {

    const overlay =
      $("countdown-overlay");

    if (!overlay) {
      return;
    }

    overlay.classList.add(
      "hide"
    );

  }


  /* =========================================
     CUENTA REGRESIVA
  ========================================== */

  function countdown(
    iso,
    state
  ) {

    if (timer) {
      clearInterval(timer);
    }


    const overlay =
      $("countdown-overlay");


    const counter =
      $("countdown");


    if (!overlay || !counter) {
      return;
    }


    /*
      SI EL PARTIDO YA ESTÁ EN VIVO
      O FINALIZÓ, QUITAMOS EL OVERLAY
    */

    if (
      !iso ||
      state === "live" ||
      state === "post"
    ) {

      hideCountdown();

      return;

    }


    const start =
      new Date(iso).getTime();


    const tick = () => {

      const diff =
        start - Date.now();


      /*
        LLEGÓ LA HORA DEL PARTIDO
      */

      if (diff <= 0) {

        counter.textContent =
          "00:00:00";


        /*
          PEQUEÑA PAUSA PARA QUE
          SE VEA EL 00:00:00
        */

        setTimeout(
          () => {
            hideCountdown();
          },
          500
        );


        clearInterval(
          timer
        );


        return;

      }


      const hours =
        Math.floor(
          diff / 3600000
        );


      const minutes =
        Math.floor(
          (diff % 3600000) /
          60000
        );


      const seconds =
        Math.floor(
          (diff % 60000) /
          1000
        );


      counter.textContent =
        `${String(hours).padStart(2,"0")}:` +
        `${String(minutes).padStart(2,"0")}:` +
        `${String(seconds).padStart(2,"0")}`;

    };


    tick();


    timer =
      setInterval(
        tick,
        1000
      );

  }


  /* =========================================
     REPRODUCTOR
  ========================================== */

  function loadPlayer(g) {

    if (!g.stream_url) {
      return;
    }


    const media =
      $("media");


    if (!media) {
      return;
    }


    const url =
      String(
        g.stream_url
      );


    /*
      MOSTRAMOS LA TRANSMISIÓN.

      EL CONTADOR SE QUEDA ENCIMA
      MIENTRAS EL JUEGO NO HAYA
      COMENZADO.
    */

    media.hidden =
      false;


    /* =========================================
       MP4 / WEBM
    ========================================== */

    if (
      /\.(mp4|webm)(\?|$)/i.test(
        url
      )
    ) {

      media.innerHTML =
        `<video
          controls
          autoplay
          playsinline
          src="${url.replace(/"/g,"&quot;")}"
        ></video>`;

      return;

    }


    /* =========================================
       HLS
    ========================================== */

    if (
      /\.m3u8(\?|$)/i.test(
        url
      )
    ) {

      const video =
        document.createElement(
          "video"
        );


      video.controls =
        true;


      video.autoplay =
        true;


      video.playsInline =
        true;


      if (
        video.canPlayType(
          "application/vnd.apple.mpegurl"
        )
      ) {

        video.src =
          url;


        media.replaceChildren(
          video
        );

      }

      else {

        media.innerHTML =
          `
          <div class="player-error">
            Esta transmisión HLS necesita
            un reproductor compatible.
          </div>
          `;

      }


      return;

    }


    /* =========================================
       IFRAME / EMBED
    ========================================== */

    const iframe =
      document.createElement(
        "iframe"
      );


    iframe.src =
      url;


    iframe.allow =
      "autoplay; fullscreen; picture-in-picture";


    iframe.allowFullscreen =
      true;


    iframe.referrerPolicy =
      "strict-origin-when-cross-origin";


    iframe.setAttribute(
      "title",
      "Transmisión deportiva"
    );


    media.replaceChildren(
      iframe
    );

  }


  /* =========================================
     CARGAR PARTIDO
  ========================================== */

  async function init() {

    if (!id) {

      $("match-title").textContent =
        "Partido no especificado";


      $("player-title").textContent =
        "PARTIDO NO DISPONIBLE";


      return;

    }


    try {

      const response =
        await fetch(
          "/api/deportes",
          {
            cache:
              "no-store"
          }
        );


      if (!response.ok) {

        throw new Error(
          "Error cargando deportes"
        );

      }


      const data =
        await response.json();


      const games =
        data.juegos || [];


      const g =
        games.find(
          (game) =>
            String(game.id) ===
            String(id)
        );


      if (!g) {

        throw new Error(
          "Partido no encontrado"
        );

      }


      const title =
        `${g.visitante.nombre} vs ${g.local.nombre}`;


      const status =
        stateText(
          g.state
        );


      /* =========================================
         INFORMACIÓN PRINCIPAL
      ========================================== */

      $("league-bottom").textContent =
        g.liga ||
        "DEPORTE";


      $("match-title").textContent =
        title;


      $("match-date").textContent =
        dateRD(
          g.fecha
        );


      /* =========================================
         ESTADO
      ========================================== */

      $("state-pill").textContent =
        status;


      $("state-pill")
        .classList
        .toggle(
          "live",
          g.state === "live"
        );


      $("state-pill")
        .classList
        .toggle(
          "finished",
          g.state === "post"
        );


      /* =========================================
         INFORMACIÓN DERECHA
      ========================================== */

      $("info-league").textContent =
        g.liga ||
        "—";


      $("info-away").textContent =
        g.visitante?.nombre ||
        "—";


      $("info-home").textContent =
        g.local?.nombre ||
        "—";


      $("info-state").textContent =
        status;


      $("info-time").textContent =
        timeRD(
          g.fecha
        );


      /* =========================================
         TEXTO DEL CONTADOR
      ========================================== */

      if (g.state === "live") {

        $("player-status").textContent =
          "PARTIDO EN VIVO";


        $("player-title").textContent =
          "TRANSMISIÓN EN VIVO";

      }

      else if (
        g.state === "post"
      ) {

        $("player-status").textContent =
          "PARTIDO FINALIZADO";


        $("player-title").textContent =
          "EL PARTIDO HA FINALIZADO";

      }

      else {

        $("player-status").textContent =
          "PARTIDO PROGRAMADO";


        $("player-title").textContent =
          "EL JUEGO COMENZARÁ PRONTO";

      }


      /* =========================================
         CARGAMOS EL VIDEO DESDE AHORA
      ========================================== */

      if (
        g.stream_url
      ) {

        loadPlayer(g);

      }


      /* =========================================
         CONTADOR SOBRE EL VIDEO
      ========================================== */

      countdown(
        g.fecha,
        g.state
      );

    }


    catch(error) {

      console.error(
        error
      );


      $("match-title").textContent =
        "No pudimos cargar este partido";


      $("player-title").textContent =
        "PARTIDO NO DISPONIBLE";


      $("player-message").textContent =
        "Vuelve a Deportes en Vivo y selecciona otro encuentro.";

    }

  }


  init();

})();

</script>


<style is:global>


/* =========================================
   PÁGINA
========================================= */

.watch-page {

  max-width:
    1280px;

  margin:
    auto;

  padding:
    28px 22px 60px;

  color:
    #111827;

  background:
    #ffffff;

}


.watch-page::before {

  content:
    "";

  position:
    fixed;

  inset:
    0;

  background:
    #ffffff;

  z-index:
    -1;

}


/* =========================================
   VOLVER
========================================= */

.watch-page .back {

  display:
    inline-block;

  margin-bottom:
    18px;

  color:
    #2563eb;

  text-decoration:
    none;

  font-weight:
    700;

}


.watch-page .back:hover {

  text-decoration:
    underline;

}


/* =========================================
   ESTRUCTURA
========================================= */

.watch-grid {

  display:
    grid;

  grid-template-columns:
    minmax(0,1fr)
    320px;

  gap:
    26px;

}


/* =========================================
   REPRODUCTOR
========================================= */

.player-shell {

  position:
    relative;

  aspect-ratio:
    16 / 9;

  background:
    #000000;

  border:
    1px solid #263c5a;

  border-radius:
    22px;

  overflow:
    hidden;

  color:
    #ffffff;

  box-shadow:
    0 10px 35px
    rgba(15,23,42,.14);

}


/* =========================================
   VIDEO
========================================= */

.media {

  position:
    absolute;

  inset:
    0;

  width:
    100%;

  height:
    100%;

  background:
    #000000;

  z-index:
    1;

}


.media video,
.media iframe {

  display:
    block;

  width:
    100%;

  height:
    100%;

  border:
    0;

  background:
    #000000;

}


/* =========================================
   ERROR DEL PLAYER
========================================= */

.player-error {

  width:
    100%;

  height:
    100%;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    30px;

  text-align:
    center;

  color:
    #ffffff;

}


/* =========================================
   DEGRADADO + CONTADOR
========================================= */

.countdown-overlay {

  position:
    absolute;

  inset:
    0;

  z-index:
    20;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.25) 0%,
      rgba(0,0,0,.52) 35%,
      rgba(0,0,0,.78) 70%,
      rgba(0,0,0,.92) 100%
    );

  backdrop-filter:
    blur(1px);

  -webkit-backdrop-filter:
    blur(1px);

  opacity:
    1;

  visibility:
    visible;

  transition:
    opacity .8s ease,
    visibility .8s ease;

}


/* =========================================
   DESAPARECER AL COMENZAR
========================================= */

.countdown-overlay.hide {

  opacity:
    0;

  visibility:
    hidden;

  pointer-events:
    none;

}


/* =========================================
   CONTENIDO DEL CONTADOR
========================================= */

.countdown-content {

  width:
    100%;

  max-width:
    850px;

  padding:
    30px;

  text-align:
    center;

  color:
    #ffffff;

}


.countdown-content .eyebrow {

  display:
    inline-block;

  color:
    #ff334f;

  font-size:
    13px;

  font-weight:
    900;

  letter-spacing:
    .16em;

  text-shadow:
    0 2px 12px
    rgba(0,0,0,.8);

}


.countdown-content h1 {

  color:
    #ffffff;

  font-size:
    clamp(
      30px,
      4vw,
      58px
    );

  line-height:
    1;

  margin:
    14px 0 12px;

  text-shadow:
    0 4px 25px
    rgba(0,0,0,.9);

}


.countdown-content p {

  margin:
    0 auto;

  color:
    #dbeafe;

  font-size:
    15px;

  text-shadow:
    0 2px 12px
    rgba(0,0,0,.9);

}


.countdown-content small {

  display:
    block;

  margin-top:
    30px;

  margin-bottom:
    8px;

  color:
    #dbeafe;

  font-size:
    13px;

  font-weight:
    700;

  text-shadow:
    0 2px 12px
    rgba(0,0,0,.9);

}


/* =========================================
   NÚMEROS DEL CONTADOR
========================================= */

.countdown {

  color:
    #ffffff;

  font-size:
    clamp(
      45px,
      6vw,
      76px
    );

  font-weight:
    900;

  line-height:
    1;

  letter-spacing:
    .02em;

  font-variant-numeric:
    tabular-nums;

  text-shadow:
    0 5px 30px
    rgba(0,0,0,.95);

}


/* =========================================
   INFORMACIÓN DEBAJO
========================================= */

.match-heading {

  display:
    flex;

  justify-content:
    space-between;

  gap:
    20px;

  align-items:
    flex-start;

  padding:
    28px 2px;

}


.match-heading h2 {

  color:
    #111827;

  font-size:
    clamp(
      28px,
      4vw,
      50px
    );

  line-height:
    1.08;

  margin:
    8px 0;

}


.match-heading p {

  color:
    #64748b;

  margin:
    0;

}


/* =========================================
   TEXTOS ROJOS
========================================= */

.eyebrow,
.league-red,
.brand {

  color:
    #ff334f;

  font-size:
    12px;

  font-weight:
    900;

  letter-spacing:
    .16em;

}


/* =========================================
   ESTADO
========================================= */

.state-pill {

  border:
    1px solid #d6a719;

  background:
    #fff8dc;

  color:
    #9a6700;

  padding:
    10px 15px;

  border-radius:
    999px;

  font-weight:
    900;

  font-size:
    12px;

  white-space:
    nowrap;

}


.state-pill.live {

  border-color:
    #ff334f;

  background:
    #fff0f2;

  color:
    #d81735;

}


.state-pill.finished {

  border-color:
    #94a3b8;

  background:
    #f1f5f9;

  color:
    #475569;

}


/* =========================================
   INFORMACIÓN DEL JUEGO
========================================= */

.info-card {

  background:
    #ffffff;

  color:
    #111827;

  border:
    1px solid #e2e8f0;

  border-radius:
    22px;

  padding:
    28px;

  height:
    max-content;

  box-shadow:
    0 8px 30px
    rgba(15,23,42,.08);

}


.info-card h2 {

  color:
    #111827;

  font-size:
    25px;

  margin:
    12px 0 20px;

}


.info-card dl {

  margin:
    0;

}


.info-card dl div {

  padding:
    15px 0;

  border-bottom:
    1px solid #e2e8f0;

}


.info-card dl div:last-child {

  border-bottom:
    0;

}


.info-card dt {

  font-size:
    12px;

  color:
    #64748b;

  margin-bottom:
    7px;

}


.info-card dd {

  margin:
    0;

  color:
    #111827;

  font-size:
    16px;

  font-weight:
    900;

}


/* =========================================
   TABLET / MÓVIL
========================================= */

@media (
  max-width:
    850px
) {

  .watch-grid {

    grid-template-columns:
      1fr;

  }


  .info-card {

    order:
      2;

  }


  .match-heading {

    flex-direction:
      column;

  }


  .watch-page {

    padding:
      18px 14px 45px;

  }


  .player-shell {

    border-radius:
      14px;

  }


  .countdown-content {

    padding:
      18px;

  }


  .countdown-content p {

    display:
      none;

  }


  .countdown-content small {

    margin-top:
      18px;

  }

}


/* =========================================
   MÓVILES PEQUEÑOS
========================================= */

@media (
  max-width:
    520px
) {

  .countdown-content h1 {

    font-size:
      25px;

  }


  .countdown {

    font-size:
      42px;

  }


  .countdown-content small {

    font-size:
      11px;

  }


  .countdown-content .eyebrow {

    font-size:
      10px;

  }

}

</style>