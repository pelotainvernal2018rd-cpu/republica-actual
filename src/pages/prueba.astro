const secundarias = [
  {
    nombre: "MUNDO",
    clase: "morado",
    titulo: "Continúan las noticias que marcan la agenda internacional",
    imagen:
      "https://images.unsplash.com/photo-1495020689067-958852a7765e?auto=format&fit=crop&w=600&q=80",
  },
