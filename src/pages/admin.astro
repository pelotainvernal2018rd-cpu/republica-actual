    function obtenerNoticiasFiltradas() {

      const busqueda =
        (
          buscarNoticias?.value ||
          ''
        )
          .trim()
          .toLowerCase();

      const estado =
        filtrarEstado?.value ||
        'todas';

      return noticiasCache.filter(
        noticia => {

          const coincideBusqueda =
            !busqueda ||
            String(
              noticia.titulo || ''
            )
              .toLowerCase()
              .includes(busqueda);

          let coincideEstado =
            true;

          if (
            estado ===
            'publicadas'
          ) {

            coincideEstado =
              noticia.publicado ===
              true;

          }

          if (
            estado ===
            'borradores'
          ) {

            coincideEstado =
              noticia.publicado !==
              true;

          }

          if (
            estado ===
            'republica-util'
          ) {

            coincideEstado =
              noticia.republica_util ===
              true;

          }

          return (
            coincideBusqueda &&
            coincideEstado
          );

        }
      );

    }

