    async function comprimirImagenPrincipal(archivo) {

      if (!archivo?.type?.startsWith('image/')) {
        throw new Error('Selecciona un archivo de imagen válido.');
      }

      const dataUrl =
        await new Promise(
          (resolver, rechazar) => {

            const lector =
              new FileReader();

            lector.onload =
              () => resolver(lector.result);

            lector.onerror =
              () => rechazar(
                new Error('No se pudo leer la imagen.')
              );

            lector.readAsDataURL(archivo);

          }
        );

      const foto =
        await new Promise(
          (resolver, rechazar) => {

            const img =
              new Image();

            img.onload =
              () => resolver(img);

            img.onerror =
              () => rechazar(
                new Error('No se pudo procesar la imagen.')
              );

            img.src = dataUrl;

          }
        );

      const maxAncho = 1400;
      const maxAlto = 900;

      let ancho = foto.naturalWidth;
      let alto = foto.naturalHeight;

      const escala =
        Math.min(
          1,
          maxAncho / ancho,
          maxAlto / alto
        );

      ancho =
        Math.max(
          1,
          Math.round(ancho * escala)
        );

      alto =
        Math.max(
          1,
          Math.round(alto * escala)
        );

      const canvas =
        document.createElement('canvas');

      canvas.width = ancho;
      canvas.height = alto;

      const ctx =
        canvas.getContext('2d');

      ctx.drawImage(
        foto,
        0,
        0,
        ancho,
        alto
      );

      let calidad = 0.82;
      let salida =
        canvas.toDataURL(
          'image/webp',
          calidad
        );

      /*
       * Firestore limita el tamaño de cada documento.
       * Reducimos la calidad si la imagen todavía pesa demasiado.
       */
      while (
        salida.length > 430000 &&
        calidad > 0.42
      ) {

        calidad -= 0.08;

        salida =
          canvas.toDataURL(
            'image/webp',
            calidad
          );

      }

      if (salida.length > 520000) {
        throw new Error(
          'La imagen sigue siendo demasiado pesada. Usa una imagen más pequeña.'
        );
      }

      return salida;

    }

