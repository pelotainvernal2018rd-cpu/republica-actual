    function guardarSesion(data) {

      sesion = {
        idToken: data.idToken,
        refreshToken: data.refreshToken,
        email: data.email,
        localId: data.localId,
        expiresAt:
          Date.now() +
          Number(data.expiresIn || 3600) * 1000
      };

      sessionStorage.setItem(
        'ra_admin_session',
        JSON.stringify(sesion)
      );

    }

    function cargarSesion() {

      try {

        const guardada =
          sessionStorage.getItem(
            'ra_admin_session'
          );

        if (!guardada) {
          return null;
        }

        return JSON.parse(guardada);

      } catch {

        return null;

      }

    }

    function borrarSesion() {

      sesion = null;

      sessionStorage.removeItem(
        'ra_admin_session'
      );

    }

    async function iniciarSesion(
      email,
      password
    ) {

      const respuesta =
        await fetch(
          FIREBASE_AUTH_URL,
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json'
            },

            body: JSON.stringify({
              email,
              password,
              returnSecureToken: true
            })
          }
        );

      const data =
        await respuesta.json();

      if (!respuesta.ok) {

        throw new Error(
          data?.error?.message ||
          'No se pudo iniciar sesión'
        );

      }

      guardarSesion(data);

      return data;

    }

    async function refrescarSesion() {

      if (!sesion?.refreshToken) {
        throw new Error(
          'La sesión expiró'
        );
      }

      const url =
        `https://securetoken.googleapis.com/v1/token?key=${FIREBASE_API_KEY}`;

      const body =
        new URLSearchParams({
          grant_type:
            'refresh_token',

          refresh_token:
            sesion.refreshToken
        });

      const respuesta =
        await fetch(
          url,
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/x-www-form-urlencoded'
            },

            body
          }
        );

      const data =
        await respuesta.json();

      if (!respuesta.ok) {

        borrarSesion();

        throw new Error(
          'La sesión expiró'
        );

      }

      sesion.idToken =
        data.id_token;

      sesion.refreshToken =
        data.refresh_token;

      sesion.expiresAt =
        Date.now() +
        Number(
          data.expires_in || 3600
        ) * 1000;

      sessionStorage.setItem(
        'ra_admin_session',
        JSON.stringify(sesion)
      );

    }

    async function obtenerToken() {

      if (!sesion) {
        throw new Error(
          'No hay sesión activa'
        );
      }

      if (
        Date.now() >
        Number(sesion.expiresAt || 0) -
        60000
      ) {

        await refrescarSesion();

      }

      return sesion.idToken;

    }

    /* ======================================================
       FIRESTORE
       ====================================================== */

    function valorFirestore(valor) {

      if (valor === null ||
          valor === undefined) {

        return {
          nullValue: null
        };

      }

      if (
        Array.isArray(valor)
      ) {

        return {
          arrayValue: {
            values:
              valor.map(
                valorFirestore
              )
          }
        };

      }

      if (
        typeof valor ===
        'boolean'
      ) {

        return {
          booleanValue:
            valor
        };

      }

      if (
        typeof valor ===
        'number'
      ) {

        return Number.isInteger(valor)
          ? {
              integerValue:
                String(valor)
            }
          : {
              doubleValue:
                valor
            };

      }

      if (
        typeof valor ===
        'object'
      ) {

        const fields = {};

        for (
          const [clave, item]
          of Object.entries(valor)
        ) {

          fields[clave] =
            valorFirestore(item);

        }

        return {
          mapValue: {
            fields
          }
        };

      }

      return {
        stringValue:
          String(valor)
      };

    }

    function camposFirestore(objeto) {

      const fields = {};

      for (
        const [clave, valor]
        of Object.entries(objeto)
      ) {

        fields[clave] =
          valorFirestore(valor);

      }

      return fields;

    }

    function leerValorFirestore(valor) {

      if (!valor) {
        return null;
      }

      if (
        'stringValue'
        in valor
      ) {
        return valor.stringValue;
      }

      if (
        'integerValue'
        in valor
      ) {
        return Number(
          valor.integerValue
        );
      }

      if (
        'doubleValue'
        in valor
      ) {
        return Number(
          valor.doubleValue
        );
      }

      if (
        'booleanValue'
        in valor
      ) {
        return valor.booleanValue;
      }

      if (
        'timestampValue'
        in valor
      ) {
        return valor.timestampValue;
      }

      if (
        'nullValue'
        in valor
      ) {
        return null;
      }

      if (
        'arrayValue'
        in valor
      ) {

        return (
          valor.arrayValue.values ||
          []
        ).map(
          leerValorFirestore
        );

      }

      if (
        'mapValue'
        in valor
      ) {

        const salida = {};

        const fields =
          valor.mapValue.fields ||
          {};

        for (
          const [clave, item]
          of Object.entries(fields)
        ) {

          salida[clave] =
            leerValorFirestore(item);

        }

        return salida;

      }

      return null;

    }

    function documentoAObjeto(
      documento
    ) {

      const salida = {};

      const fields =
        documento.fields ||
        {};

      for (
        const [clave, valor]
        of Object.entries(fields)
      ) {

        salida[clave] =
          leerValorFirestore(valor);

      }

      salida.__documentName =
        documento.name;

      salida.__documentId =
        documento.name
          ?.split('/')
          .pop();

      return salida;

    }

