    async function esperarUrlPublicada(
      url,
      intentos = 30,
      pausaMs = 5000
    ) {

      for (
        let intento = 0;
        intento < intentos;
        intento++
      ) {

        try {

          const respuesta =
            await fetch(
              `${url}?verificacion=${Date.now()}`,
              {
                method: 'HEAD',
                cache: 'no-store'
              }
            );

          if (respuesta.ok) {
            return true;
          }

        } catch {
          // El despliegue todavía puede estar procesándose.
        }

        await new Promise(
          resolver =>
            setTimeout(
              resolver,
              pausaMs
            )
        );

      }

      return false;

    }

    function escaparHtml(texto) {

      return String(
        texto ?? ''
      )
        .replace(
          /&/g,
          '&amp;'
        )
        .replace(
          /</g,
          '&lt;'
        )
        .replace(
          />/g,
          '&gt;'
        )
        .replace(
          /"/g,
          '&quot;'
        )
        .replace(
          /'/g,
          '&#039;'
        );

    }

    function formatearFecha(fecha) {

      if (!fecha) {
        return '';
      }

      const d =
        new Date(fecha);

      if (
        Number.isNaN(
          d.getTime()
        )
      ) {
        return '';
      }

      return new Intl.DateTimeFormat(
        'es-DO',
        {
          dateStyle:
            'medium',

          timeStyle:
            'short'
        }
      ).format(d);

    }

