<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administración | República Actual</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6f9;
      color: #102d46;
    }

    button, input, select {
      font: inherit;
    }

    .oculto { display: none !important; }

    #login {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-box,
    .panel {
      background: white;
      border: 1px solid #e0e6ec;
      border-radius: 12px;
      box-shadow: 0 8px 28px rgba(0,0,0,.06);
    }

    .login-box {
      width: 100%;
      max-width: 420px;
      padding: 34px;
    }

    .logo {
      text-align: center;
      margin-bottom: 26px;
    }

    .logo h1 {
      margin: 0;
      font-size: 27px;
    }

    .logo span { color: #e52b32; }

    .logo p {
      color: #718096;
      font-size: 13px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .campo { margin-bottom: 17px; }

    input, select {
      width: 100%;
      border: 1px solid #d6dde5;
      border-radius: 7px;
      padding: 12px;
      background: white;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #102d46;
    }

    .btn {
      border: 0;
      border-radius: 7px;
      padding: 11px 16px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-principal {
      background: #102d46;
      color: white;
    }

    .btn-rojo {
      background: #e52b32;
      color: white;
    }

    .btn-gris {
      background: #e9eef3;
      color: #102d46;
    }

    .btn-verde {
      background: #16803c;
      color: white;
    }

    .mensaje {
      display: none;
      margin-top: 14px;
      padding: 11px;
      border-radius: 7px;
      font-size: 13px;
      text-align: center;
    }

    .mensaje.error {
      display: block;
      background: #fee2e2;
      color: #991b1b;
    }

    .mensaje.ok {
      display: block;
      background: #dcfce7;
      color: #166534;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 10;
      background: #102d46;
      color: white;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .topbar h1 {
      margin: 0;
      font-size: 20px;
    }

    .topbar small { color: #cbd8e4; }

    .contenedor {
      max-width: 1200px;
      margin: auto;
      padding: 25px;
    }

    .menu {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 22px;
    }

    .menu button {
      border: 1px solid #d6dde5;
      background: white;
      color: #102d46;
      padding: 10px 15px;
      border-radius: 7px;
      font-weight: 700;
      cursor: pointer;
    }

    .menu button.activo {
      background: #102d46;
      color: white;
    }

    .estadisticas {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }

    .stat {
      background: white;
      border: 1px solid #e0e6ec;
      border-radius: 10px;
      padding: 18px;
    }

    .stat b {
      display: block;
      font-size: 29px;
    }

    .stat span {
      font-size: 12px;
      color: #718096;
    }

    .panel {
      padding: 22px;
      margin-bottom: 20px;
    }

    .panel h2 {
      margin: 0 0 20px;
    }

    .fila {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .acciones {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .editor-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 10px;
      border: 1px solid #d6dde5;
      border-bottom: 0;
      border-radius: 7px 7px 0 0;
      background: #f8fafc;
    }

    .editor-toolbar button,
    .editor-toolbar select {
      width: auto;
      padding: 7px 9px;
      border: 1px solid #d6dde5;
      border-radius: 5px;
      background: white;
      cursor: pointer;
    }

    #contenido {
      min-height: 380px;
      border: 1px solid #d6dde5;
      border-radius: 0 0 7px 7px;
      padding: 18px;
      outline: none;
      font-size: 17px;
      line-height: 1.7;
      color: #111827;
      background: white;
    }

    #contenido img,
    #contenido video {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 18px auto;
      border-radius: 8px;
    }

    .checks {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 18px 0;
    }

    .check {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      border: 1px solid #d6dde5;
      border-radius: 9px;
      padding: 14px;
      background: #f8fafc;
    }

    .check input {
      width: auto;
      margin-top: 3px;
    }

    .check label { margin: 0; }

    .check small {
      display: block;
      color: #718096;
      margin-top: 4px;
      font-weight: normal;
    }

    .herramientas {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .herramientas input {
      flex: 1;
      min-width: 220px;
    }

    .herramientas select {
      width: auto;
      min-width: 170px;
    }

    .noticia {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      border: 1px solid #e0e6ec;
      border-radius: 9px;
      padding: 15px;
      margin-bottom: 10px;
    }

    .noticia h3 {
      margin: 0 0 6px;
      font-size: 16px;
    }

    .meta {
      font-size: 12px;
      color: #718096;
    }

    .badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 8px;
    }

    .badge {
      font-size: 10px;
      font-weight: 800;
      padding: 4px 7px;
      border-radius: 20px;
      background: #e9eef3;
    }

    .pub {
      background: #dcfce7;
      color: #166534;
    }

    .draft {
      background: #fef3c7;
      color: #92400e;
    }

    .util {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .portada {
      background: #fef3c7;
      color: #92400e;
    }

    .noticia-acciones {
      display: flex;
      gap: 7px;
      flex-shrink: 0;
    }

    .cargando {
      text-align: center;
      padding: 28px;
      color: #718096;
    }

    @media (max-width: 800px) {
      .estadisticas {
        grid-template-columns: 1fr 1fr;
      }

      .fila,
      .checks {
        grid-template-columns: 1fr;
      }

      .noticia {
        align-items: stretch;
        flex-direction: column;
      }

      .noticia-acciones {
        width: 100%;
      }

      .noticia-acciones button {
        flex: 1;
      }
    }
  </style>
</head>

<body>

