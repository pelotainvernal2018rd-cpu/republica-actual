    /* ======================================================
       PUBLICAR / GUARDAR
       ====================================================== */

    async function guardarNoticia(
      publicar
    ) {

      const tituloTexto =
        titulo.value.trim();

      seleccionarMedia(
        null
      );

      const contenidoTexto =
        contenido.innerHTML.trim();

      if (
        !tituloTexto ||
        !contenidoTexto
      ) {

        mostrarMensajeNoticia(
          'El título y el contenido son obligatorios.',
          'error'
        );

        return;

      }

      if (
        !feedPrincipal?.checked &&
        !republicaUtil?.checked
      ) {

        mostrarMensajeNoticia(
          'Selecciona Feed principal, República Útil o ambos.',
          'error'
        );

        return;

      }

      publicarButton.disabled =
        true;

      borradorButton.disabled =
        true;

      const textoBoton =
        publicarButton.textContent;

      publicarButton.textContent =
        publicar
          ? '⏳ PUBLICANDO...'
          : '⏳ GUARDANDO...';

      try {

        let id;

        if (
          noticiaId.value
        ) {

          id =
            String(
              noticiaId.value
            );

        } else {

          id =
            crearIdManualUnico();

        }

        const ahora =
          new Date()
            .toISOString();

        const etiquetas =
          obtenerEtiquetasSeo();

        const datos = {

          ...(
            noticiaEditando ||
            {}
          ),

          id:
            Number(id),

          titulo:
            tituloTexto,

          slug:
            noticiaEditando
              ?.slug ||
            crearSlug(
              tituloTexto
            ),

          url_definitiva:
            crearUrlDefinitiva(
              noticiaEditando
                ?.slug ||
              crearSlug(
                tituloTexto
              )
            ),

          origen_publicacion:
            noticiaEditando
              ?.origen_publicacion ||
            'manual',

          imagen:
            imagen.value
              .trim() ||
            null,

          contenido:
            contenidoTexto,

          categoria:
            categoria.value,

          publicado:
            publicar,

          feed_principal:
            feedPrincipal
              ? feedPrincipal.checked
              : true,

          republica_util:
            republicaUtil
              ? republicaUtil.checked
              : false,

          republica_util_portada:
            republicaUtilPortada
              ? republicaUtilPortada.checked
              : false,

          titulo_seo:
            tituloSeo
              ?.value
              .trim() ||
            tituloTexto,

          meta_descripcion:
            metaDescripcion
              ?.value
              .trim() ||
            '',

          keywords:
            etiquetas,

          etiquetas:
            etiquetas,

          created_at:
            noticiaEditando
              ?.created_at ||
            ahora,

          updated_at:
            ahora

        };

        /*
         * IMPORTANTE:
         * Solo hacemos UNA escritura a Firestore.
         * No volvemos a descargar toda la colección.
         */

        await guardarDocumento(
          id,
          datos
        );

        reemplazarEnCache(
          datos
        );

        renderNoticias();

        actualizarEstadisticas();

        if (publicar) {

          mostrarMensajeNoticia(
            '✅ Guardada en GitHub. Publicando en la web...',
            'ok'
          );

          try {

            await solicitarDespliegue();

            const disponible =
              await esperarUrlPublicada(
                datos.url_definitiva
              );

            if (disponible) {

              noticiaMensaje.className =
                'mensaje ok';

              noticiaMensaje.innerHTML =
                `✅ Publicada en la web. ` +
                `<a href="${escaparHtml(datos.url_definitiva)}" target="_blank" rel="noopener noreferrer">Ver noticia</a>`;

            } else {

              noticiaMensaje.className =
                'mensaje ok';

              noticiaMensaje.innerHTML =
                `✅ Publicación guardada y despliegue iniciado. ` +
                `La URL definitiva es: ` +
                `<a href="${escaparHtml(datos.url_definitiva)}" target="_blank" rel="noopener noreferrer">${escaparHtml(datos.url_definitiva)}</a>`;

            }

          } catch (errorDeploy) {

            console.error(
              'Error iniciando despliegue:',
              errorDeploy
            );

            noticiaMensaje.className =
              'mensaje error';

            noticiaMensaje.innerHTML =
              `⚠️ La noticia quedó guardada en GitHub, pero no se pudo iniciar el despliegue. ` +
              `URL reservada: ` +
              `<a href="${escaparHtml(datos.url_definitiva)}" target="_blank" rel="noopener noreferrer">${escaparHtml(datos.url_definitiva)}</a>`;

          }

        } else {

          mostrarMensajeNoticia(
            '✅ Borrador guardado correctamente.',
            'ok'
          );

          await new Promise(
            resolver =>
              setTimeout(
                resolver,
                350
              )
          );

          limpiarEditor();

          cambiarSeccion(
            'noticias'
          );

          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });

        }

      } catch (error) {

        console.error(
          error
        );

        mostrarMensajeNoticia(
          `No se pudo guardar: ${
            error?.message ||
            'error de GitHub'
          }`,
          'error'
        );

      } finally {

        publicarButton.disabled =
          false;

        borradorButton.disabled =
          false;

        publicarButton.textContent =
          noticiaEditando
            ? '🚀 ACTUALIZAR PUBLICACIÓN'
            : '🚀 PUBLICAR AHORA';

      }

    }

    noticiaForm
