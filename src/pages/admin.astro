    function crearSlug(texto) {

      return String(
        texto || ''
      )
        .normalize('NFD')
        .replace(
          /[\u0300-\u036f]/g,
          ''
        )
        .toLowerCase()
        .trim()
        .replace(
          /[^a-z0-9]+/g,
          '-'
        )
        .replace(
          /^-+|-+$/g,
          ''
        );

    }


    function crearIdManualUnico() {

      /*
       * Las automatizaciones usan IDs numéricos pequeños/secuenciales.
       * Las publicaciones manuales usan epoch en milisegundos.
       * Así evitamos que ambos flujos choquen por el mismo ID.
       */

      return String(Date.now());

    }

    function crearUrlDefinitiva(slug) {

      return `${SITE_BASE_URL}/noticia/${slug}/`;

    }

