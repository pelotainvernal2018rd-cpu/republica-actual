<script>

  /*
   * FIREBASE
   * Usamos directamente la configuración pública del proyecto.
   * Ya no dependemos de PUBLIC_FIREBASE_API_KEY en Cloudflare.
   */

  const FIREBASE_API_KEY =
    'AIzaSyDZ39oMmjrcQ64X6jKCBisDdicH5H0goW4';

  const FIREBASE_PROJECT_ID =
    'republica-actual';

  const AUTH_URL =
    `https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${FIREBASE_API_KEY}`;

  const REFRESH_URL =
    `https://securetoken.googleapis.com/v1/token?key=${FIREBASE_API_KEY}`;

  const FIRESTORE_BASE =
    `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents`;


  const $ = (id) =>
    document.getElementById(id);

  let sesion = null;
  let noticias = [];
  let editando = null;


  function mensaje(
    elemento,
    texto,
    tipo = 'error'
  ) {

    elemento.textContent = texto;
    elemento.className =
      `mensaje ${tipo}`;

  }


  function mostrarAdmin(activo) {

    $('login').classList.toggle(
      'oculto',
      activo
    );

    $('admin').classList.toggle(
      'oculto',
      !activo
    );

  }


  function guardarSesion(data) {

    sesion = {

      idToken:
        data.idToken,

      refreshToken:
        data.refreshToken,

      email:
        data.email || '',

      expiresAt:
        Date.now() +
        Number(data.expiresIn || 3600) *
        1000 -
        60000

    };

    sessionStorage.setItem(
      'ra_admin_session',
      JSON.stringify(sesion)
    );

  }


  async function renovarSesion() {

    if (!sesion?.refreshToken) {
      throw new Error(
        'Sesión vencida'
      );
    }

    const body =
      new URLSearchParams({

        grant_type:
          'refresh_token',

        refresh_token:
          sesion.refreshToken

      });


    const respuesta =
      await fetch(
        REFRESH_URL,
        {

          method: 'POST',

          headers: {
            'Content-Type':
              'application/x-www-form-urlencoded'
          },

          body

        }
      );


    const data =
      await respuesta.json();


    if (!respuesta.ok) {

      throw new Error(
        data?.error?.message ||
        'No se pudo renovar la sesión'
      );

    }


    sesion = {

      ...sesion,

      idToken:
        data.id_token,

      refreshToken:
        data.refresh_token ||
        sesion.refreshToken,

      expiresAt:
        Date.now() +
        Number(data.expires_in || 3600) *
        1000 -
        60000

    };


    sessionStorage.setItem(
      'ra_admin_session',
      JSON.stringify(sesion)
    );


    return sesion.idToken;

  }


  async function obtenerToken() {

    if (!sesion) {

      throw new Error(
        'Debes iniciar sesión'
      );

    }


    if (
      Date.now() >=
      sesion.expiresAt
    ) {

      return renovarSesion();

    }


    return sesion.idToken;

  }


  $('loginForm')
    .addEventListener(
      'submit',
      async (event) => {

        event.preventDefault();

        $('loginButton').disabled =
          true;

        $('loginButton').textContent =
          'Entrando...';


        try {

          const respuesta =
            await fetch(
              AUTH_URL,
              {

                method: 'POST',

                headers: {
                  'Content-Type':
                    'application/json'
                },

                body:
                  JSON.stringify({

                    email:
                      $('email')
                        .value
                        .trim(),

                    password:
                      $('password')
                        .value,

                    returnSecureToken:
                      true

                  })

              }
            );


          const data =
            await respuesta.json();


          if (!respuesta.ok) {

            throw new Error(
              data?.error?.message ||
              'LOGIN_ERROR'
            );

          }


          guardarSesion(data);

          $('usuarioAdmin')
            .textContent =
            data.email || '';

          mostrarAdmin(true);

          await cargarTodo();


        } catch (error) {

          console.error(error);

          mensaje(
            $('loginMensaje'),
            'No se pudo iniciar sesión. Revisa el correo y la contraseña.'
          );

        } finally {

          $('loginButton').disabled =
            false;

          $('loginButton').textContent =
            'Entrar al panel';

        }

      }
    );


  $('cerrarSesion').onclick =
    () => {

      sesion = null;

      sessionStorage.removeItem(
        'ra_admin_session'
      );

      mostrarAdmin(false);

    };


  function valorFirestore(v) {

    if (!v || typeof v !== 'object')
      return null;

    if ('nullValue' in v)
      return null;

    if ('stringValue' in v)
      return v.stringValue;

    if ('booleanValue' in v)
      return v.booleanValue;

    if ('integerValue' in v)
      return Number(v.integerValue);

    if ('doubleValue' in v)
      return Number(v.doubleValue);

    if ('timestampValue' in v)
      return v.timestampValue;

    if ('arrayValue' in v)
      return (
        v.arrayValue.values || []
      ).map(valorFirestore);

    if ('mapValue' in v) {

      return Object.fromEntries(

        Object.entries(
          v.mapValue.fields || {}
        ).map(
          ([key, value]) => [
            key,
            valorFirestore(value)
          ]
        )

      );

    }

    return null;

  }


  function convertirDocumento(doc) {

    const data = {};

    for (
      const [key, value]
      of Object.entries(
        doc.fields || {}
      )
    ) {

      data[key] =
        valorFirestore(value);

    }


    if (
      data.id == null &&
      doc.name
    ) {

      const id =
        doc.name
          .split('/')
          .pop();

      data.id =
        Number(id) || id;

    }


    return data;

  }


  function aValorFirestore(valor) {

    if (
      valor === null ||
      valor === undefined
    ) {

      return {
        nullValue: null
      };

    }


    if (
      typeof valor === 'boolean'
    ) {

      return {
        booleanValue: valor
      };

    }


    if (
      typeof valor === 'number'
    ) {

      if (
        Number.isInteger(valor)
      ) {

        return {
          integerValue:
            String(valor)
        };

      }

      return {
        doubleValue: valor
      };

    }


    if (
      Array.isArray(valor)
    ) {

      return {

        arrayValue: {

          values:
            valor.map(
              aValorFirestore
            )

        }

      };

    }


    if (
      typeof valor === 'object'
    ) {

      return {

        mapValue: {

          fields:
            Object.fromEntries(

              Object.entries(valor)
                .map(
                  ([key, value]) => [
                    key,
                    aValorFirestore(value)
                  ]
                )

            )

        }

      };

    }


    return {
      stringValue:
        String(valor)
    };

  }


  function crearDocumentoFirestore(
    datos
  ) {

    return {

      fields:
        Object.fromEntries(

          Object.entries(datos)
            .map(
              ([key, value]) => [
                key,
                aValorFirestore(value)
              ]
            )

        )

    };

  }


  async function firestoreFetch(
    url,
    options = {}
  ) {

    const token =
      await obtenerToken();


    const respuesta =
      await fetch(
        url,
        {

          ...options,

          headers: {

            'Content-Type':
              'application/json',

            Authorization:
              `Bearer ${token}`,

            ...(options.headers || {})

          }

        }
      );


    const texto =
      await respuesta.text();

    let data = null;


    if (texto) {

      try {

        data =
          JSON.parse(texto);

      } catch {

        data = texto;

      }

    }


    if (!respuesta.ok) {

      if (
        respuesta.status === 401
      ) {

        await renovarSesion();

        return firestoreFetch(
          url,
          options
        );

      }


      throw new Error(
        data?.error?.message ||
        `Firestore HTTP ${respuesta.status}`
      );

    }


    return data;

  }


  async function obtenerNoticias() {

    const todas = [];

    let pageToken = '';


    do {

      const params =
        new URLSearchParams({
          pageSize: '1000'
        });


      if (pageToken) {

        params.set(
          'pageToken',
          pageToken
        );

      }


      const data =
        await firestoreFetch(

          `${FIRESTORE_BASE}/noticias?${params}`

        );


      (
        data?.documents || []
      ).forEach(

        documento => {

          todas.push(
            convertirDocumento(
              documento
            )
          );

        }

      );


      pageToken =
        data?.nextPageToken || '';


    } while (pageToken);


    todas.sort(
      (a, b) =>

        (
          Date.parse(
            b.created_at || ''
          ) || 0
        )

        -

        (
          Date.parse(
            a.created_at || ''
          ) || 0
        )
    );


    noticias = todas;

    return todas;

  }


  async function guardarDocumento(
    id,
    datos
  ) {

    return firestoreFetch(

      `${FIRESTORE_BASE}/noticias/${encodeURIComponent(String(id))}`,

      {

        method: 'PATCH',

        body:
          JSON.stringify(
            crearDocumentoFirestore(
              datos
            )
          )

      }

    );

  }


  async function borrarDocumento(id) {

    return firestoreFetch(

      `${FIRESTORE_BASE}/noticias/${encodeURIComponent(String(id))}`,

      {
        method: 'DELETE'
      }

    );

  }


  function crearSlug(texto) {

    return String(texto || '')

      .normalize('NFD')

      .replace(
        /[\u0300-\u036f]/g,
        ''
      )

      .toLowerCase()

      .trim()

      .replace(
        /[^a-z0-9]+/g,
        '-'
      )

      .replace(
        /^-+|-+$/g,
        ''
      );

  }


  document
    .querySelectorAll(
      '.menu button'
    )
    .forEach(

      boton => {

        boton.onclick =
          () => {

            cambiarSeccion(
              boton.dataset.seccion
            );

          };

      }

    );


  function cambiarSeccion(
    seccion
  ) {

    [
      'inicio',
      'crear',
      'noticias'
    ].forEach(

      nombre => {

        $(
          `seccion-${nombre}`
        ).classList.toggle(
          'oculto',
          nombre !== seccion
        );

      }

    );


    document
      .querySelectorAll(
        '.menu button'
      )
      .forEach(

        boton => {

          boton.classList.toggle(

            'activo',

            boton.dataset.seccion ===
            seccion

          );

        }

      );


    if (
      seccion === 'noticias'
    ) {

      renderizarNoticias();

    }

  }


  $('irCrear').onclick =
    () => {

      limpiarEditor();

      cambiarSeccion(
        'crear'
      );

    };


  $('irNoticias').onclick =
    () => {

      cambiarSeccion(
        'noticias'
      );

    };


  $('cancelar').onclick =
    () => {

      limpiarEditor();

      cambiarSeccion(
        'inicio'
      );

    };


  $('republicaUtil')
    .onchange =
    () => {

      const activo =
        $('republicaUtil')
          .checked;


      $('republicaUtilPortada')
        .disabled =
        !activo;


      if (!activo) {

        $('republicaUtilPortada')
          .checked =
          false;

      }

    };


  function limpiarEditor() {

    editando = null;

    $('noticiaId').value = '';

    $('titulo').value = '';

    $('categoria').value =
      'Nacionales';

    $('imagen').value = '';

    $('contenido').innerHTML = '';

    $('republicaUtil')
      .checked =
      false;

    $('republicaUtilPortada')
      .checked =
      false;

    $('republicaUtilPortada')
      .disabled =
      true;

    $('tituloEditor')
      .textContent =
      '📝 Nueva entrada';

    $('noticiaMensaje')
      .className =
      'mensaje';

  }


  function editarNoticia(
    noticia
  ) {

    editando = {
      ...noticia
    };


    $('noticiaId').value =
      noticia.id || '';

    $('titulo').value =
      noticia.titulo || '';

    $('categoria').value =
      noticia.categoria ||
      'Nacionales';

    $('imagen').value =
      noticia.imagen || '';

    $('contenido').innerHTML =
      noticia.contenido || '';


    $('republicaUtil')
      .checked =
      noticia.republica_util ===
      true;


    $('republicaUtilPortada')
      .checked =
      noticia.republica_util_portada ===
      true;


    $('republicaUtilPortada')
      .disabled =
      !$('republicaUtil').checked;


    $('tituloEditor')
      .textContent =
      '✏️ Editar entrada';


    cambiarSeccion(
      'crear'
    );


    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });

  }


  document
    .querySelectorAll(
      '[data-cmd]'
    )
    .forEach(

      boton => {

        boton.onclick =
          () => {

            $('contenido')
              .focus();

            document.execCommand(
              boton.dataset.cmd,
              false,
              null
            );

          };

      }

    );


  $('formato').onchange =
    event => {

      $('contenido').focus();

      document.execCommand(
        'formatBlock',
        false,
        event.target.value
      );

      event.target.value =
        'p';

    };


  $('enlace').onclick =
    () => {

      const url =
        prompt(
          'Pega la URL del enlace:'
        );

      if (!url) return;

      $('contenido').focus();

      document.execCommand(
        'createLink',
        false,
        url
      );

    };


  $('imagenEditor').onclick =
    () => {

      const url =
        prompt(
          'Pega la URL de la imagen:'
        );

      if (!url) return;


      $('contenido').focus();


      const segura =
        url.replace(
          /"/g,
          '&quot;'
        );


      document.execCommand(

        'insertHTML',

        false,

        `<img src="${segura}" alt="" style="width:100%;max-width:100%;height:auto;margin:18px auto;display:block;">`

      );

    };


  $('videoEditor').onclick =
    () => {

      const url =
        prompt(
          'Pega la URL del video:'
        );

      if (!url) return;


      $('contenido').focus();


      const segura =
        url.replace(
          /"/g,
          '&quot;'
        );


      document.execCommand(

        'insertHTML',

        false,

        `<video src="${segura}" controls playsinline style="width:100%;max-width:100%;height:auto;margin:18px auto;display:block;"></video>`

      );

    };


  async function guardarEntrada(
    publicado
  ) {

    const titulo =
      $('titulo')
        .value
        .trim();


    const contenido =
      $('contenido')
        .innerHTML
        .trim();


    if (
      !titulo ||
      !contenido
    ) {

      mensaje(
        $('noticiaMensaje'),
        'Título y contenido son obligatorios.'
      );

      return;

    }


    $('publicarButton')
      .disabled =
      true;

    $('borradorButton')
      .disabled =
      true;


    try {

      let id =
        $('noticiaId').value;


      if (!id) {

        const ids =
          noticias

            .map(
              noticia =>
                Number(
                  noticia.id
                )
            )

            .filter(
              Number.isFinite
            );


        id =
          String(

            (
              ids.length
                ? Math.max(...ids)
                : 0
            ) + 1

          );

      }


      const datos = {

        ...(editando || {}),

        id:
          Number(id),

        titulo,

        slug:
          crearSlug(titulo),

        imagen:
          $('imagen')
            .value
            .trim() ||
          null,

        contenido,

        categoria:
          $('categoria').value,

        publicado,

        republica_util:
          $('republicaUtil')
            .checked,

        republica_util_portada:
          $('republicaUtil')
            .checked &&
          $('republicaUtilPortada')
            .checked,

        created_at:
          editando?.created_at ||
          new Date()
            .toISOString()

      };


      await guardarDocumento(
        id,
        datos
      );


      mensaje(

        $('noticiaMensaje'),

        publicado
          ? 'Entrada publicada correctamente.'
          : 'Borrador guardado correctamente.',

        'ok'

      );


      await obtenerNoticias();


      setTimeout(
        () => {

          limpiarEditor();

          actualizarEstadisticas();

          cambiarSeccion(
            'noticias'
          );

        },
        500
      );


    } catch (error) {

      console.error(error);


      mensaje(

        $('noticiaMensaje'),

        `No se pudo guardar: ${error.message}`

      );


    } finally {

      $('publicarButton')
        .disabled =
        false;

      $('borradorButton')
        .disabled =
        false;

    }

  }


  $('noticiaForm')
    .onsubmit =
    event => {

      event.preventDefault();

      guardarEntrada(true);

    };


  $('borradorButton')
    .onclick =
    () => {

      guardarEntrada(false);

    };


  function renderizarNoticias() {

    const busqueda =
      $('buscar')
        .value
        .trim()
        .toLowerCase();


    const filtro =
      $('filtro').value;


    const resultados =
      noticias.filter(

        noticia => {

          const coincideTexto =

            !busqueda ||

            String(
              noticia.titulo || ''
            )
              .toLowerCase()
              .includes(
                busqueda
              );


          let coincideFiltro =
            true;


          if (
            filtro ===
            'publicadas'
          ) {

            coincideFiltro =
              noticia.publicado ===
              true;

          }


          if (
            filtro ===
            'borradores'
          ) {

            coincideFiltro =
              noticia.publicado !==
              true;

          }


          if (
            filtro ===
            'util'
          ) {

            coincideFiltro =
              noticia.republica_util ===
              true;

          }


          return (
            coincideTexto &&
            coincideFiltro
          );

        }

      );


    $('listaNoticias')
      .innerHTML =
      '';


    if (
      !resultados.length
    ) {

      $('listaNoticias')
        .innerHTML =
        '<div class="cargando">No se encontraron entradas.</div>';

      return;

    }


    resultados.forEach(

      noticia => {

        const contenedor =
          document.createElement(
            'div'
          );

        contenedor.className =
          'noticia';


        const izquierda =
          document.createElement(
            'div'
          );


        const titulo =
          document.createElement(
            'h3'
          );

        titulo.textContent =
          noticia.titulo ||
          'Sin título';


        const meta =
          document.createElement(
            'div'
          );

        meta.className =
          'meta';

        meta.textContent =
          `${noticia.categoria || 'Sin categoría'} · ${noticia.slug || ''}`;


        const badges =
          document.createElement(
            'div'
          );

        badges.className =
          'badges';


        const estado =
          document.createElement(
            'span'
          );

        estado.className =
          `badge ${
            noticia.publicado
              ? 'pub'
              : 'draft'
          }`;

        estado.textContent =
          noticia.publicado
            ? 'PUBLICADA'
            : 'BORRADOR';


        badges.append(
          estado
        );


        if (
          noticia.republica_util
        ) {

          const badge =
            document.createElement(
              'span'
            );

          badge.className =
            'badge util';

          badge.textContent =
            'REPÚBLICA ÚTIL';

          badges.append(
            badge
          );

        }


        if (
          noticia.republica_util_portada
        ) {

          const badge =
            document.createElement(
              'span'
            );

          badge.className =
            'badge portada';

          badge.textContent =
            '⭐ PORTADA';

          badges.append(
            badge
          );

        }


        izquierda.append(
          titulo,
          meta,
          badges
        );


        const acciones =
          document.createElement(
            'div'
          );

        acciones.className =
          'noticia-acciones';


        const editar =
          document.createElement(
            'button'
          );

        editar.className =
          'btn btn-gris';

        editar.textContent =
          '✏️ Editar';

        editar.onclick =
          () => {

            editarNoticia(
              noticia
            );

          };


        const eliminar =
          document.createElement(
            'button'
          );

        eliminar.className =
          'btn btn-rojo';

        eliminar.textContent =
          '🗑️ Eliminar';


        eliminar.onclick =
          async () => {

            if (

              !confirm(
                `¿Eliminar esta entrada?\n\n${noticia.titulo}`
              )

            ) {

              return;

            }


            try {

              await borrarDocumento(
                noticia.id
              );

              await cargarTodo();


            } catch (error) {

              console.error(
                error
              );

              alert(
                `No se pudo eliminar: ${error.message}`
              );

            }

          };


        acciones.append(
          editar,
          eliminar
        );


        contenedor.append(
          izquierda,
          acciones
        );


        $('listaNoticias')
          .append(
            contenedor
          );

      }

    );

  }


  $('buscar').oninput =
    renderizarNoticias;


  $('filtro').onchange =
    renderizarNoticias;


  $('actualizar').onclick =
    cargarTodo;


  function actualizarEstadisticas() {

    $('totalNoticias')
      .textContent =
      noticias.length;


    $('totalPublicadas')
      .textContent =
      noticias.filter(
        noticia =>
          noticia.publicado ===
          true
      ).length;


    $('totalBorradores')
      .textContent =
      noticias.filter(
        noticia =>
          noticia.publicado !==
          true
      ).length;


    $('totalUtil')
      .textContent =
      noticias.filter(
        noticia =>
          noticia.republica_util ===
          true
      ).length;

  }


  async function cargarTodo() {

    await obtenerNoticias();

    actualizarEstadisticas();

    renderizarNoticias();

  }


  async function iniciar() {

    try {

      const guardada =
        sessionStorage.getItem(
          'ra_admin_session'
        );


      if (!guardada) {

        mostrarAdmin(false);

        return;

      }


      sesion =
        JSON.parse(
          guardada
        );


      await obtenerToken();


      $('usuarioAdmin')
        .textContent =
        sesion.email || '';


      mostrarAdmin(true);


      await cargarTodo();


    } catch (error) {

      console.error(error);

      sesion = null;

      sessionStorage.removeItem(
        'ra_admin_session'
      );

      mostrarAdmin(false);

    }

  }


  iniciar();

</script>

</body>
</html>