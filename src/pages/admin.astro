    function reemplazarEnCache(
      noticia
    ) {

      const id =
        String(noticia.id);

      const indice =
        noticiasCache.findIndex(
          item =>
            String(item.id) === id
        );

      if (indice >= 0) {

        noticiasCache[indice] =
          noticia;

      } else {

        noticiasCache.unshift(
          noticia
        );

      }

      noticiasCache.sort(
        (a, b) =>
          (
            Date.parse(
              b.created_at || ''
            ) || 0
          ) -
          (
            Date.parse(
              a.created_at || ''
            ) || 0
          )
      );

    }

    function quitarDeCache(id) {

      noticiasCache =
        noticiasCache.filter(
          noticia =>
            String(noticia.id) !==
            String(id)
        );

    }

