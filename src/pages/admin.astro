      )
      ?.addEventListener(
        'input',
        evento => {

          ejecutarComando(
            'foreColor',
            evento.target.value
          );

        }
      );

    document
      .getElementById(
        'limpiarFormato'
      )
      ?.addEventListener(
        'click',
        () => {

          ejecutarComando(
            'removeFormat'
          );

        }
      );

    document
      .getElementById(
        'deshacer'
      )
      ?.addEventListener(
        'click',
        () => {

          ejecutarComando(
            'undo'
          );

        }
      );

    document
      .getElementById(
        'rehacer'
      )
      ?.addEventListener(
        'click',
        () => {

          ejecutarComando(
            'redo'
          );

        }
      );

    /* ======================================================
       ENLACES
       ====================================================== */

    document
      .getElementById(
        'insertarEnlace'
      )
      ?.addEventListener(
        'click',
        () => {

          const url =
            window.prompt(
              'Pega la dirección del enlace:'
            );

          if (!url) {
            return;
          }

          ejecutarComando(
            'createLink',
            url
          );

          contenido
            .querySelectorAll(
              'a'
            )
            .forEach(
              enlace => {

                enlace.target =
                  '_blank';

                enlace.rel =
                  'noopener noreferrer';

              }
            );

        }
      );

    /* ======================================================
       INSERTAR IMAGEN
       ====================================================== */

    document
      .getElementById(
        'insertarImagenEditor'
      )
      ?.addEventListener(
        'click',
        () => {

          const url =
            window.prompt(
              'Pega la URL de la imagen:'
            );

          if (!url) {
            return;
          }

          contenido.focus();

          const html =
            `
              <img
                src="${escaparHtml(url)}"
                alt=""
                loading="lazy"
                style="
                  width:75%;
                  max-width:100%;
                  height:auto;
                  display:block;
                  margin:18px auto;
                "
              >
              <p><br></p>
            `;

          document.execCommand(
            'insertHTML',
            false,
            html
          );

        }
      );

    /* ======================================================
       INSERTAR VIDEO
       ====================================================== */

    document
      .getElementById(
        'insertarVideoEditor'
      )
      ?.addEventListener(
        'click',
        () => {

          const url =
            window.prompt(
              'Pega la URL del video o de YouTube:'
            );

          if (!url) {
            return;
          }

          contenido.focus();

          let html = '';

          const youtube =
            url.match(
              /(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{6,})/
            );

          if (youtube) {

            const id =
              youtube[1];

            html =
              `
                <div
                  style="
                    position:relative;
                    width:100%;
                    padding-top:56.25%;
                    margin:20px auto;
                  "
                >
                  <iframe
                    src="https://www.youtube.com/embed/${escaparHtml(id)}"
                    title="Video"
                    loading="lazy"
                    allowfullscreen
                    style="
                      position:absolute;
                      inset:0;
                      width:100%;
                      height:100%;
                      border:0;
                      border-radius:8px;
                    "
                  ></iframe>
                </div>
                <p><br></p>
              `;

          } else {

            html =
              `
                <video
                  controls
                  preload="metadata"
                  style="
                    width:100%;
                    max-width:100%;
                    display:block;
                    margin:20px auto;
                  "
                >
                  <source
                    src="${escaparHtml(url)}"
                  >
                </video>
                <p><br></p>
              `;

          }

          document.execCommand(
            'insertHTML',
            false,
            html
          );

        }
      );

    /* ======================================================
       SELECCIÓN DE IMÁGENES Y VIDEOS
       ====================================================== */

    function seleccionarMedia(
      elemento
    ) {

      if (
        mediaSeleccionado
      ) {

        mediaSeleccionado
          .classList
          .remove(
            'media-seleccionado'
          );

      }

      mediaSeleccionado =
        elemento;

      if (!elemento) {

        mediaControls
          ?.classList
          .remove(
            'activo'
          );

        return;

      }

      elemento
        .classList
        .add(
          'media-seleccionado'
        );

      mediaControls
        ?.classList
        .add(
          'activo'
        );

      const ancho =
        elemento.style.width ||
        '100%';

      const opciones =
        [
          '25%',
          '50%',
          '75%',
          '100%'
        ];

      if (
        opciones.includes(
          ancho
        )
      ) {

        mediaTamano.value =
          ancho;

      }

    }

    contenido.addEventListener(
      'click',
      evento => {

        const objetivo =
          evento.target;

        if (
          objetivo instanceof
            HTMLImageElement ||
          objetivo instanceof
            HTMLVideoElement
        ) {

          seleccionarMedia(
            objetivo
          );

          return;

        }

        if (
          objetivo.closest(
            'iframe'
          )
        ) {

          return;

        }

        seleccionarMedia(
          null
        );

      }
    );

    mediaTamano
      ?.addEventListener(
        'change',
        () => {

          if (
            !mediaSeleccionado
          ) {
            return;
          }

          mediaSeleccionado
            .style
            .width =
              mediaTamano.value;

          mediaSeleccionado
            .style
            .maxWidth =
              '100%';

          mediaSeleccionado
            .style
            .height =
              'auto';

        }
      );

    document
      .getElementById(
        'mediaIzquierda'
      )
      ?.addEventListener(
        'click',
        () => {

          if (
            !mediaSeleccionado
          ) {
            return;
          }

          mediaSeleccionado
            .style
            .display =
              'block';

          mediaSeleccionado
            .style
            .marginLeft =
              '0';

          mediaSeleccionado
            .style
            .marginRight =
              'auto';

        }
      );

    document
      .getElementById(
        'mediaCentro'
      )
      ?.addEventListener(
        'click',
        () => {

          if (
            !mediaSeleccionado
          ) {
            return;
          }

          mediaSeleccionado
            .style
            .display =
              'block';

          mediaSeleccionado
            .style
            .marginLeft =
              'auto';

          mediaSeleccionado
            .style
            .marginRight =
              'auto';

        }
      );

    document
      .getElementById(
        'mediaDerecha'
      )
      ?.addEventListener(
        'click',
        () => {

          if (
            !mediaSeleccionado
          ) {
            return;
          }

          mediaSeleccionado
            .style
            .display =
              'block';

          mediaSeleccionado
            .style
            .marginLeft =
              'auto';

          mediaSeleccionado
            .style
            .marginRight =
              '0';

        }
      );

    document
      .getElementById(
        'mediaEliminar'
      )
      ?.addEventListener(
        'click',
        () => {

          if (
            !mediaSeleccionado
          ) {
            return;
          }

          const elemento =
            mediaSeleccionado;

          seleccionarMedia(
            null
          );

          elemento.remove();

        }
      );

    /* ======================================================
       ATAJOS DEL EDITOR
       ====================================================== */

    contenido.addEventListener(
      'keydown',
      evento => {

        if (
          evento.ctrlKey &&
          evento.key.toLowerCase() ===
            'b'
        ) {

          evento.preventDefault();

          ejecutarComando(
            'bold'
          );

        }

        if (
          evento.ctrlKey &&
          evento.key.toLowerCase() ===
            'i'
        ) {

          evento.preventDefault();

          ejecutarComando(
            'italic'
          );

        }

        if (
          evento.ctrlKey &&
          evento.key.toLowerCase() ===
            'u'
        ) {

          evento.preventDefault();

          ejecutarComando(
            'underline'
          );

        }

      }
    );

    /* ======================================================
       PEGADO LIMPIO
       ====================================================== */

    contenido.addEventListener(
      'paste',
      evento => {

        const html =
          evento.clipboardData
            ?.getData(
              'text/html'
            );

        const texto =
          evento.clipboardData
            ?.getData(
              'text/plain'
            );

        if (!html) {

          if (!texto) {
            return;
          }

          evento.preventDefault();

          const seguro =
            escaparHtml(
              texto
            )
              .replace(
                /\n\n+/g,
                '</p><p>'
              )
              .replace(
                /\n/g,
                '<br>'
              );

          document.execCommand(
            'insertHTML',
            false,
            `<p>${seguro}</p>`
          );

          return;

        }

        evento.preventDefault();

        const temporal =
          document.createElement(
            'div'
          );

        temporal.innerHTML =
          html;

        temporal
          .querySelectorAll(
            'script,style,link,meta,object,embed'
          )
          .forEach(
            elemento =>
              elemento.remove()
          );

        temporal
          .querySelectorAll(
            '*'
          )
          .forEach(
            elemento => {

              [
                'onclick',
                'onload',
                'onerror',
                'onmouseover'
              ].forEach(
                atributo =>
                  elemento.removeAttribute(
                    atributo
                  )
              );

            }
          );

        document.execCommand(
          'insertHTML',
          false,
          temporal.innerHTML
        );

      }
    );

    /* ======================================================
       VISITANTES SIMPLES
       ====================================================== */

    function actualizarVisitantes() {

      /*
       * Este número es solamente visual mientras
       * conectamos Analytics/estadísticas reales.
       */

      const actual =
        Number(
          document
            .getElementById(
              'visitantesNumero'
            )
            ?.textContent ||
          1
        );

      document
        .getElementById(
          'visitantesNumero'
        )
        .textContent =
          String(
            Math.max(
              1,
              actual
            )
          );

      document
        .getElementById(
          'totalVisitantes'
        )
        .textContent =
          String(
            Math.max(
              1,
              actual
            )
          );

    }

    actualizarVisitantes();

    /* ======================================================
       RESTAURAR SESIÓN
       ====================================================== */

    (async function iniciar() {

      sesion =
        cargarSesion();

      if (!sesion) {

        login.classList.remove(
          'oculto'
        );

        admin.classList.add(
          'oculto'
        );

        return;

      }

      try {

        await obtenerToken();

        await entrarAdmin();

      } catch (error) {

        console.error(
          error
        );

        borrarSesion();

        admin.classList.add(
          'oculto'
        );

        login.classList.remove(
          'oculto'
        );

      }

    })();

  </script>

</body>
