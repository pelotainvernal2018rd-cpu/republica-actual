    /* ======================================================
       BORRAR RÁPIDO
       ====================================================== */

    async function eliminarNoticia(
      noticia,
      tarjeta
    ) {

      const confirmar =
        window.confirm(
          `¿Eliminar definitivamente "${noticia.titulo || 'esta noticia'}"?`
        );

      if (!confirmar) {
        return;
      }

      tarjeta?.style.setProperty(
        'opacity',
        '.45'
      );

      tarjeta?.style.setProperty(
        'pointer-events',
        'none'
      );

      try {

        await borrarDocumento(
          noticia.id
        );

        quitarDeCache(
          noticia.id
        );

        tarjeta?.remove();

        actualizarEstadisticas();

        if (
          !obtenerNoticiasFiltradas()
            .length
        ) {

          resultadoVacio
            .classList
            .remove(
              'oculto'
            );

        }

      } catch (error) {

        console.error(
          error
        );

        tarjeta?.style.removeProperty(
          'opacity'
        );

        tarjeta?.style.removeProperty(
          'pointer-events'
        );

        alert(
          `No se pudo eliminar: ${
            error?.message ||
            'error de GitHub'
          }`
        );

      }

    }

