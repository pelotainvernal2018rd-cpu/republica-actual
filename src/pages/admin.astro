---
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administración | República Actual</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6f9;
      color: #102d46;
    }

    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }

    .oculto {
      display: none !important;
    }

    /* LOGIN */

    #login {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-box {
      width: 100%;
      max-width: 420px;
      background: white;
      padding: 35px;
      border-radius: 12px;
      box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .logo {
      text-align: center;
      margin-bottom: 28px;
    }

    .logo h1 {
      margin: 0;
      font-size: 27px;
      font-weight: 800;
      color: #102d46;
    }

    .logo h1 span {
      color: #e52b32;
    }

    .logo p {
      margin: 8px 0 0;
      color: #718096;
      font-size: 13px;
    }

    .login-box h2 {
      margin: 0 0 20px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 700;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #d6dde5;
      border-radius: 7px;
      padding: 12px;
      font-size: 14px;
      outline: none;
      background: white;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #102d46;
    }

    textarea {
      min-height: 220px;
      resize: vertical;
    }

    .campo {
      margin-bottom: 17px;
    }

    .btn {
      border: 0;
      border-radius: 7px;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-principal {
      background: #102d46;
      color: white;
    }

    .btn-principal:hover {
      background: #173d5d;
    }

    .btn-rojo {
      background: #e52b32;
      color: white;
    }

    .btn-gris {
      background: #e9eef3;
      color: #102d46;
    }

    .btn-verde {
      background: #16803c;
      color: white;
    }

    .mensaje {
      margin-top: 14px;
      padding: 11px;
      border-radius: 6px;
      font-size: 13px;
      text-align: center;
      display: none;
    }

    .mensaje.error {
      display: block;
      background: #fee2e2;
      color: #991b1b;
    }

    .mensaje.ok {
      display: block;
      background: #dcfce7;
      color: #166534;
    }

    /* ADMIN */

    #admin {
      min-height: 100vh;
    }

    .topbar {
      background: #102d46;
      color: white;
      padding: 16px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .topbar h1 {
      margin: 0;
      font-size: 20px;
    }

    .topbar small {
      color: #cbd8e4;
    }

    .contenedor {
      max-width: 1200px;
      margin: auto;
      padding: 25px;
    }

    /* MENU */

    .menu {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 25px;
    }

    .menu button {
      border: 1px solid #d6dde5;
      background: white;
      color: #102d46;
      padding: 10px 16px;
      border-radius: 7px;
      cursor: pointer;
      font-weight: 700;
    }

    .menu button.activo {
      background: #102d46;
      color: white;
    }

    /* ESTADISTICAS */

    .estadisticas {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat {
      background: white;
      border: 1px solid #e0e6ec;
      border-radius: 10px;
      padding: 20px;
    }

    .stat .numero {
      display: block;
      font-size: 30px;
      font-weight: 800;
      margin-bottom: 5px;
    }

    .stat .texto {
      color: #718096;
      font-size: 13px;
    }

    /* TARJETAS */

    .panel {
      background: white;
      border: 1px solid #e0e6ec;
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 20px;
    }

    .panel h2 {
      margin-top: 0;
      font-size: 20px;
    }

    .fila {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .acciones {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    /* NOTICIAS */

    .noticia-admin {
      border: 1px solid #e0e6ec;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
    }

    .noticia-info {
      min-width: 0;
    }

    .noticia-info h3 {
      margin: 0 0 7px;
      font-size: 16px;
    }

    .noticia-info p {
      margin: 0;
      color: #718096;
      font-size: 12px;
    }

    .estado {
      display: inline-block;
      margin-top: 8px;
      padding: 4px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .estado-publicado {
      background: #dcfce7;
      color: #166534;
    }

    .estado-borrador {
      background: #fef3c7;
      color: #92400e;
    }

    .acciones-noticia {
      display: flex;
      gap: 7px;
      flex-shrink: 0;
    }

    /* VISITANTES */

    .visitantes {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #f3f5f7;
      border-left: 4px solid #16a34a;
      padding: 18px;
      border-radius: 7px;
    }

    .punto {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #16a34a;
      animation: pulsar 1.5s infinite;
    }

    @keyframes pulsar {
      0%, 100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: .4;
        transform: scale(.8);
      }
    }

    .visitantes strong {
      font-size: 25px;
    }

    .cargando {
      text-align: center;
      padding: 30px;
      color: #718096;
    }

    #herramientasNoticias input,
    #herramientasNoticias select {
      margin: 0;
    }

    #resultadoVacio {
      border: 1px dashed #d6dde5;
      border-radius: 8px;
    }

    /* EDITOR */

    .editor-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 10px;
      border: 1px solid #d6dde5;
      border-bottom: 0;
      border-radius: 7px 7px 0 0;
      background: #f8fafc;
    }

    .editor-toolbar button,
    .editor-toolbar select,
    .editor-toolbar input[type="color"] {
      width: auto;
      min-width: 38px;
      height: 36px;
      padding: 6px 9px;
      border: 1px solid #d6dde5;
      border-radius: 5px;
      background: white;
      cursor: pointer;
      font-weight: 700;
    }

    .editor-toolbar input[type="color"] {
      padding: 3px;
    }

    #contenido {
      min-height: 520px;
      border: 1px solid #d8e0ea;
      border-radius: 0 0 14px 14px;
      padding: 28px;
      outline: none;
      background: white;
      color: #172033;
      font-size: 17px;
      line-height: 1.75;
    }

    #contenido:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }

    #contenido h2 {
      color: #102d46;
      font-size: 25px;
      margin: 28px 0 10px;
    }

    #contenido h3 {
      color: #102d46;
      font-size: 21px;
      margin: 24px 0 8px;
    }

    #contenido p {
      margin: 0 0 16px;
    }

    #contenido ul,
    #contenido ol {
      padding-left: 28px;
    }

    #contenido blockquote {
      margin: 18px 0;
      padding: 12px 16px;
      border-left: 4px solid #102d46;
      background: #f3f6f9;
    }

    /* MULTIMEDIA */

    .media-box {
      border: 1px solid #d6dde5;
      border-radius: 8px;
      padding: 14px;
      background: #f8fafc;
    }

    .media-box input[type="file"] {
      background: white;
    }

    .media-ayuda {
      margin: 7px 0 0;
      color: #718096;
      font-size: 12px;
    }

    .media-preview {
      margin-top: 12px;
      display: none;
    }

    .media-preview img,
    .media-preview video {
      display: block;
      max-width: 100%;
      max-height: 320px;
      border-radius: 8px;
      background: #0f172a;
    }

    #contenido img,
    #contenido video {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      cursor: pointer;
      display: block;
      margin: 18px auto;
    }

    #contenido .media-seleccionado {
      outline: 3px solid #2563eb;
      outline-offset: 3px;
    }

    .media-controls {
      display: none;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 8px;
      padding: 10px;
      border: 1px solid #d6dde5;
      border-radius: 7px;
      background: #f8fafc;
    }

    .media-controls.activo {
      display: flex;
    }

    .media-controls button,
    .media-controls select {
      width: auto;
      min-width: 70px;
      padding: 8px 10px;
    }

    /* ADMIN PRO */

    #seccion-crear .panel {
      max-width: 1180px;
      margin: 0 auto;
      border-radius: 18px;
      box-shadow: 0 14px 40px rgba(15,23,42,.08);
    }

    #tituloEditor {
      font-size: 24px;
      letter-spacing: -.02em;
      margin-bottom: 22px;
    }

    .editor-toolbar {
      position: sticky;
      top: 8px;
      z-index: 20;
      border-radius: 14px 14px 0 0;
      background: rgba(248,250,252,.97);
      backdrop-filter: blur(10px);
      box-shadow: 0 5px 18px rgba(15,23,42,.06);
    }

    .seo-panel,
    .destino-panel {
      margin: 18px 0;
      padding: 18px;
      border: 1px solid #dbe4ee;
      border-radius: 14px;
      background: linear-gradient(180deg,#fbfdff 0%,#f7faff 100%);
    }

    .seo-panel-title,
    .destino-titulo {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
    }

    .seo-panel-title strong,
    .destino-titulo strong {
      display: block;
      font-size: 16px;
      color: #10213d;
    }

    .seo-panel-title span,
    .destino-titulo span {
      display: block;
      margin-top: 3px;
      font-size: 12px;
      color: #718096;
    }

    .contador-seo,
    .ayuda-seo {
      display: block;
      margin-top: 6px;
      color: #718096;
      font-size: 11px;
      text-align: right;
    }

    #metaDescripcion {
      resize: vertical;
      min-height: 88px;
    }

    .opcion-feed {
      border-left: 4px solid #2563eb !important;
    }

    .opcion-util {
      border-left: 4px solid #dc2626 !important;
    }

    .opcion-portada {
      border-left: 4px solid #f59e0b !important;
    }

    .acciones {
      position: sticky;
      bottom: 10px;
      z-index: 18;
      padding: 12px;
      border: 1px solid #dbe4ee;
      border-radius: 14px;
      background: rgba(255,255,255,.96);
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 28px rgba(15,23,42,.12);
    }

    #publicarButton {
      font-weight: 900;
      font-size: 15px;
    }

    .btn:disabled {
      opacity: .6;
      cursor: wait;
    }

    /* DESTINOS */

    .opciones-especiales {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin: 6px 0 18px;
    }

    .opcion-check {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 14px;
      border: 1px solid #d6dde5;
      border-radius: 8px;
      background: #f8fafc;
      cursor: pointer;
      margin: 0;
    }

    .opcion-check input {
      width: 18px;
      height: 18px;
      margin: 2px 0 0;
      flex: 0 0 auto;
    }

    .opcion-check strong {
      display: block;
      margin-bottom: 3px;
    }

    .opcion-check span {
      color: #718096;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.4;
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .estadisticas {
        grid-template-columns: repeat(2,1fr);
      }
    }

    @media (max-width: 700px) {
      .contenedor {
        padding: 15px;
      }

      .fila {
        grid-template-columns: 1fr;
      }

      .estadisticas {
        grid-template-columns: 1fr 1fr;
      }

      .opciones-especiales {
        grid-template-columns: 1fr;
      }

      .noticia-admin {
        flex-direction: column;
        align-items: stretch;
      }

      .acciones-noticia {
        width: 100%;
      }

      .acciones-noticia button {
        flex: 1;
      }

      .topbar {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <!-- LOGIN -->

  <section id="login">

    <div class="login-box">

      <div class="logo">
        <h1>REPÚBLICA<span>•</span>ACTUAL</h1>
        <p>Panel de administración</p>
      </div>

      <h2>Iniciar sesión</h2>

      <form id="loginForm">

        <div class="campo">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            type="email"
            placeholder="admin@republicaactual.net"
            required
          />
        </div>

        <div class="campo">
          <label for="password">Contraseña</label>
          <input
            id="password"
            type="password"
            required
          />
        </div>

        <button
          class="btn btn-principal"
          id="loginButton"
          type="submit"
          style="width:100%;"
        >
          Entrar al panel
        </button>

        <div id="loginMensaje" class="mensaje"></div>

      </form>

    </div>

  </section>

  <!-- ADMIN -->

  <section id="admin" class="oculto">

    <header class="topbar">

      <div>
        <h1>República Actual — Administración</h1>
        <small id="usuarioAdmin"></small>
      </div>

      <button
        class="btn btn-rojo"
        id="cerrarSesion"
      >
        Cerrar sesión
      </button>

    </header>

    <div class="contenedor">

      <nav class="menu">

        <button class="activo" data-seccion="inicio">
          📊 Resumen
        </button>

        <button data-seccion="crear">
          📝 Publicar noticia
        </button>

        <button data-seccion="noticias">
          📰 Noticias
        </button>

      </nav>

      <!-- RESUMEN -->

      <div id="seccion-inicio">

        <div class="estadisticas">

          <div class="stat">
            <span class="numero" id="totalPublicadas">0</span>
            <span class="texto">Noticias publicadas</span>
          </div>

          <div class="stat">
            <span class="numero" id="totalBorradores">0</span>
            <span class="texto">Borradores</span>
          </div>

          <div class="stat">
            <span class="numero" id="totalNoticias">0</span>
            <span class="texto">Total de noticias</span>
          </div>

          <div class="stat">
            <span class="numero" id="totalVisitantes">1</span>
            <span class="texto">Visitantes en vivo</span>
          </div>

        </div>

        <div class="panel">

          <h2>👥 Visitantes en vivo</h2>

          <div class="visitantes">

            <span class="punto"></span>

            <div>
              <strong id="visitantesNumero">1</strong>
              <div>personas navegando ahora</div>
            </div>

          </div>

        </div>

        <div class="panel">

          <h2>📌 Acciones rápidas</h2>

          <div class="acciones">

            <button
              class="btn btn-principal"
              id="irCrear"
            >
              📝 Crear noticia
            </button>

            <button
              class="btn btn-gris"
              id="irNoticias"
            >
              📰 Administrar noticias
            </button>

          </div>

        </div>

              </div>

      <!-- CREAR / EDITAR -->

      <div id="seccion-crear" class="oculto">

        <div class="panel">

          <h2 id="tituloEditor">📝 Nueva noticia</h2>

          <form id="noticiaForm">

            <input type="hidden" id="noticiaId" />

            <div class="campo">
              <label for="titulo">Título</label>
              <input
                id="titulo"
                type="text"
                placeholder="Escribe el título de la noticia"
                required
              />
            </div>

            <div class="fila">

              <div class="campo">
                <label for="categoria">Categoría</label>

                <select id="categoria">
                  <option value="Nacionales">Nacionales</option>
                  <option value="Política">Política</option>
                  <option value="Economía">Economía</option>
                  <option value="Deportes">Deportes</option>
                  <option value="Entretenimiento">Entretenimiento</option>
                  <option value="Mundo">Mundo</option>
                  <option value="Tecnología">Tecnología</option>
                  <option value="Actualidad">Actualidad</option>
                </select>
              </div>

              <div class="campo">
                <label for="imagen">Imagen principal</label>

                <input
                  id="imagen"
                  type="text"
                  placeholder="https://... o sube una imagen desde tu PC"
                />

                <div style="display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap;">
                  <label
                    for="imagenArchivo"
                    class="btn btn-gris"
                    style="margin:0;cursor:pointer;display:inline-block;"
                  >
                    📁 Subir desde PC
                  </label>

                  <input
                    id="imagenArchivo"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    style="display:none;"
                  />

                  <button
                    id="quitarImagenPrincipal"
                    type="button"
                    class="btn btn-rojo"
                    style="display:none;"
                  >
                    🗑️ Quitar imagen
                  </button>
                </div>

                <div
                  id="imagenPrincipalPreviewBox"
                  style="display:none;margin-top:10px;"
                >
                  <img
                    id="imagenPrincipalPreview"
                    alt="Vista previa de la imagen principal"
                    style="width:100%;max-width:420px;max-height:230px;object-fit:cover;border-radius:8px;border:1px solid #d6dde5;"
                  />
                  <small style="display:block;margin-top:6px;color:#718096;">
                    Vista previa de la imagen principal
                  </small>
                </div>
              </div>

            </div>

            <!-- SEO -->

            <div class="seo-panel">

              <div class="seo-panel-title">
                <div>
                  <strong>🔎 SEO y posicionamiento</strong>
                  <span>
                    Optimiza esta publicación para Google y búsquedas internas.
                  </span>
                </div>
              </div>

              <div class="campo">
                <label for="tituloSeo">Título SEO</label>

                <input
                  id="tituloSeo"
                  type="text"
                  maxlength="70"
                  placeholder="Título optimizado para buscadores"
                />

                <small
                  id="tituloSeoContador"
                  class="contador-seo"
                >
                  0 / 70
                </small>
              </div>

              <div class="campo">
                <label for="metaDescripcion">
                  Meta descripción
                </label>

                <textarea
                  id="metaDescripcion"
                  maxlength="170"
                  rows="3"
                  placeholder="Descripción breve para Google y redes sociales"
                ></textarea>

                <small
                  id="metaContador"
                  class="contador-seo"
                >
                  0 / 170
                </small>
              </div>

              <div class="campo">
                <label for="etiquetasSeo">
                  Keywords / Etiquetas SEO
                </label>

                <input
                  id="etiquetasSeo"
                  type="text"
                  placeholder="Ej.: pasaporte dominicano, requisitos pasaporte, trámites RD"
                />

                <small class="ayuda-seo">
                  Separa las palabras clave por comas.
                </small>
              </div>

            </div>

            <!-- EDITOR -->

            <div class="campo">

              <label>Contenido</label>

              <div
                class="editor-toolbar"
                id="editorToolbar"
              >

                <select
                  id="formatoTexto"
                  title="Formato"
                >
                  <option value="p">Párrafo</option>
                  <option value="h2">Título H2</option>
                  <option value="h3">Subtítulo H3</option>
                </select>

                <select
                  id="tamanoTexto"
                  title="Tamaño"
                >
                  <option value="">Tamaño</option>
                  <option value="12px">12 px</option>
                  <option value="14px">14 px</option>
                  <option value="16px">16 px</option>
                  <option value="18px">18 px</option>
                  <option value="20px">20 px</option>
                  <option value="24px">24 px</option>
                  <option value="28px">28 px</option>
                  <option value="32px">32 px</option>
                  <option value="36px">36 px</option>
                  <option value="48px">48 px</option>
                </select>

                <button
                  type="button"
                  data-cmd="bold"
                  title="Negrita"
                >
                  <b>B</b>
                </button>

                <button
                  type="button"
                  data-cmd="italic"
                  title="Cursiva"
                >
                  <i>I</i>
                </button>

                <button
                  type="button"
                  data-cmd="underline"
                  title="Subrayado"
                >
                  <u>U</u>
                </button>

                <input
                  type="color"
                  id="colorTexto"
                  value="#111827"
                  title="Color"
                />

                <button
                  type="button"
                  data-cmd="insertUnorderedList"
                >
