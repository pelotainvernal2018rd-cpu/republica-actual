---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administración | República Actual</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6f9;
      color: #102d46;
    }

    button,
    input,
    textarea,
    select {
      font-family: inherit;
    }

    .oculto {
      display: none !important;
    }

    /* LOGIN */

    #login {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-box {
      width: 100%;
      max-width: 420px;
      background: white;
      padding: 35px;
      border-radius: 12px;
      box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .logo {
      text-align: center;
      margin-bottom: 28px;
    }

    .logo h1 {
      margin: 0;
      font-size: 27px;
      font-weight: 800;
      color: #102d46;
    }

    .logo h1 span {
      color: #e52b32;
    }

    .logo p {
      margin: 8px 0 0;
      color: #718096;
      font-size: 13px;
    }

    .login-box h2 {
      margin: 0 0 20px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 700;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #d6dde5;
      border-radius: 7px;
      padding: 12px;
      font-size: 14px;
      outline: none;
      background: white;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #102d46;
    }

    textarea {
      min-height: 220px;
      resize: vertical;
    }

    .campo {
      margin-bottom: 17px;
    }

    .btn {
      border: 0;
      border-radius: 7px;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-principal {
      background: #102d46;
      color: white;
    }

    .btn-principal:hover {
      background: #173d5d;
    }

    .btn-rojo {
      background: #e52b32;
      color: white;
    }

    .btn-gris {
      background: #e9eef3;
      color: #102d46;
    }

    .btn-verde {
      background: #16803c;
      color: white;
    }

    .mensaje {
      margin-top: 14px;
      padding: 11px;
      border-radius: 6px;
      font-size: 13px;
      text-align: center;
      display: none;
    }

    .mensaje.error {
      display: block;
      background: #fee2e2;
      color: #991b1b;
    }

    .mensaje.ok {
      display: block;
      background: #dcfce7;
      color: #166534;
    }

    /* ADMIN */

    #admin {
      min-height: 100vh;
    }

    .topbar {
      background: #102d46;
      color: white;
      padding: 16px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .topbar h1 {
      margin: 0;
      font-size: 20px;
    }

    .topbar small {
      color: #cbd8e4;
    }

    .contenedor {
      max-width: 1200px;
      margin: auto;
      padding: 25px;
    }

    /* MENU */

    .menu {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 25px;
    }

    .menu button {
      border: 1px solid #d6dde5;
      background: white;
      color: #102d46;
      padding: 10px 16px;
      border-radius: 7px;
      cursor: pointer;
      font-weight: 700;
    }

    .menu button.activo {
      background: #102d46;
      color: white;
    }

    /* ESTADISTICAS */

    .estadisticas {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat {
      background: white;
      border: 1px solid #e0e6ec;
      border-radius: 10px;
      padding: 20px;
    }

    .stat .numero {
      display: block;
      font-size: 30px;
      font-weight: 800;
      margin-bottom: 5px;
    }

    .stat .texto {
      color: #718096;
      font-size: 13px;
    }

    /* TARJETAS */

    .panel {
      background: white;
      border: 1px solid #e0e6ec;
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 20px;
    }

    .panel h2 {
      margin-top: 0;
      font-size: 20px;
    }

    .fila {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    /* BOTONES */

    .acciones {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    /* NOTICIAS */

    .noticia-admin {
      border: 1px solid #e0e6ec;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
    }

    .noticia-info {
      min-width: 0;
    }

    .noticia-info h3 {
      margin: 0 0 7px;
      font-size: 16px;
    }

    .noticia-info p {
      margin: 0;
      color: #718096;
      font-size: 12px;
    }

    .estado {
      display: inline-block;
      margin-top: 8px;
      padding: 4px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .estado-publicado {
      background: #dcfce7;
      color: #166534;
    }

    .estado-borrador {
      background: #fef3c7;
      color: #92400e;
    }

    .acciones-noticia {
      display: flex;
      gap: 7px;
      flex-shrink: 0;
    }

    /* VISITANTES */

    .visitantes {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #f3f5f7;
      border-left: 4px solid #16a34a;
      padding: 18px;
      border-radius: 7px;
    }

    .punto {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #16a34a;
      animation: pulsar 1.5s infinite;
    }

    @keyframes pulsar {
      0%, 100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: .4;
        transform: scale(.8);
      }
    }

    .visitantes strong {
      font-size: 25px;
    }

    /* CARGANDO */

    .cargando {
      text-align: center;
      padding: 30px;
      color: #718096;
    }

    #herramientasNoticias input,
    #herramientasNoticias select {
      margin: 0;
    }

    #resultadoVacio {
      border: 1px dashed #d6dde5;
      border-radius: 8px;
    }

    /* EDITOR PROFESIONAL */

    .editor-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 10px;
      border: 1px solid #d6dde5;
      border-bottom: 0;
      border-radius: 7px 7px 0 0;
      background: #f8fafc;
    }

    .editor-toolbar button,
    .editor-toolbar select,
    .editor-toolbar input[type="color"] {
      width: auto;
      min-width: 38px;
      height: 36px;
      padding: 6px 9px;
      border: 1px solid #d6dde5;
      border-radius: 5px;
      background: white;
      cursor: pointer;
      font-weight: 700;
    }

    .editor-toolbar input[type="color"] {
      padding: 3px;
    }

    #contenido {
      min-height: 360px;
      border: 1px solid #d6dde5;
      border-radius: 0 0 7px 7px;
      padding: 18px;
      outline: none;
      background: white;
      color: #111827;
      font-size: 17px;
      line-height: 1.75;
    }

    #contenido:focus {
      border-color: #102d46;
    }

    #contenido h2 {
      color: #102d46;
      font-size: 25px;
      margin: 28px 0 10px;
    }

    #contenido h3 {
      color: #102d46;
      font-size: 21px;
      margin: 24px 0 8px;
    }

    #contenido p { margin: 0 0 16px; }
    #contenido ul, #contenido ol { padding-left: 28px; }
    #contenido blockquote {
      margin: 18px 0;
      padding: 12px 16px;
      border-left: 4px solid #102d46;
      background: #f3f6f9;
    }


    /* MULTIMEDIA + TAMAÑO DE TEXTO */

    .media-box {
      border: 1px solid #d6dde5;
      border-radius: 8px;
      padding: 14px;
      background: #f8fafc;
    }

    .media-box input[type="file"] {
      background: white;
    }

    .media-ayuda {
      margin: 7px 0 0;
      color: #718096;
      font-size: 12px;
    }

    .media-preview {
      margin-top: 12px;
      display: none;
    }

    .media-preview img,
    .media-preview video {
      display: block;
      max-width: 100%;
      max-height: 320px;
      border-radius: 8px;
      background: #0f172a;
    }

    #tamanoTexto {
      min-width: 90px;
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .estadisticas {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 700px) {
      .contenedor {
        padding: 15px;
      }

      .fila {
        grid-template-columns: 1fr;
      }

      .estadisticas {
        grid-template-columns: 1fr 1fr;
      }

      .noticia-admin {
        flex-direction: column;
        align-items: stretch;
      }

      .acciones-noticia {
        width: 100%;
      }

      .acciones-noticia button {
        flex: 1;
      }

      .topbar {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       LOGIN
  ========================== -->

  <section id="login">

    <div class="login-box">

      <div class="logo">
        <h1>REPÚBLICA<span>•</span>ACTUAL</h1>
        <p>Panel de administración</p>
      </div>

      <h2>Iniciar sesión</h2>

      <form id="loginForm">

        <div class="campo">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            type="email"
            placeholder="admin@republicaactual.net"
            required
          />
        </div>

        <div class="campo">
          <label for="password">Contraseña</label>
          <input
            id="password"
            type="password"
            required
          />
        </div>

        <button
          class="btn btn-principal"
          id="loginButton"
          type="submit"
          style="width:100%;"
        >
          Entrar al panel
        </button>

        <div id="loginMensaje" class="mensaje"></div>

      </form>

    </div>

  </section>


  <!-- =========================
       ADMIN
  ========================== -->

  <section id="admin" class="oculto">

    <header class="topbar">

      <div>
        <h1>República Actual — Administración</h1>
        <small id="usuarioAdmin"></small>
      </div>

      <button
        class="btn btn-rojo"
        id="cerrarSesion"
      >
        Cerrar sesión
      </button>

    </header>


    <div class="contenedor">

      <!-- MENU -->

      <nav class="menu">

        <button
          class="activo"
          data-seccion="inicio"
        >
          📊 Resumen
        </button>

        <button
          data-seccion="crear"
        >
          📝 Publicar noticia
        </button>

        <button
          data-seccion="noticias"
        >
          📰 Noticias
        </button>

      </nav>


      <!-- =========================
           RESUMEN
      ========================== -->

      <div id="seccion-inicio">

        <div class="estadisticas">

          <div class="stat">
            <span
              class="numero"
              id="totalPublicadas"
            >
              0
            </span>

            <span class="texto">
              Noticias publicadas
            </span>
          </div>

          <div class="stat">
            <span
              class="numero"
              id="totalBorradores"
            >
              0
            </span>

            <span class="texto">
              Borradores
            </span>
          </div>

          <div class="stat">
            <span
              class="numero"
              id="totalNoticias"
            >
              0
            </span>

            <span class="texto">
              Total de noticias
            </span>
          </div>

          <div class="stat">
            <span
              class="numero"
              id="totalVisitantes"
            >
              1
            </span>

            <span class="texto">
              Visitantes en vivo
            </span>
          </div>

        </div>


        <div class="panel">

          <h2>👥 Visitantes en vivo</h2>

          <div class="visitantes">

            <span class="punto"></span>

            <div>
              <strong id="visitantesNumero">
                1
              </strong>

              <div>
                personas navegando ahora
              </div>
            </div>

          </div>

        </div>


        <div class="panel">

          <h2>📌 Acciones rápidas</h2>

          <div class="acciones">

            <button
              class="btn btn-principal"
              id="irCrear"
            >
              📝 Crear noticia
            </button>

            <button
              class="btn btn-gris"
              id="irNoticias"
            >
              📰 Administrar noticias
            </button>

          </div>

        </div>

      </div>


      <!-- =========================
           CREAR / EDITAR
      ========================== -->

      <div
        id="seccion-crear"
        class="oculto"
      >

        <div class="panel">

          <h2 id="tituloEditor">
            📝 Nueva noticia
          </h2>

          <form id="noticiaForm">

            <input
              type="hidden"
              id="noticiaId"
            />

            <div class="campo">

              <label for="titulo">
                Título
              </label>

              <input
                id="titulo"
                type="text"
                placeholder="Escribe el título de la noticia"
                required
              />

            </div>


            <div class="fila">

              <div class="campo">

                <label for="categoria">
                  Categoría
                </label>

                <select id="categoria">

                  <option value="Nacionales">
                    Nacionales
                  </option>

                  <option value="Política">
                    Política
                  </option>

                  <option value="Economía">
                    Economía
                  </option>

                  <option value="Deportes">
                    Deportes
                  </option>

                  <option value="Entretenimiento">
                    Entretenimiento
                  </option>

                  <option value="Mundo">
                    Mundo
                  </option>

                  <option value="Tecnología">
                    Tecnología
                  </option>

                  <option value="Actualidad">
                    Actualidad
                  </option>

                </select>

              </div>


              <div class="campo">

                <label for="imagen">
                  Imagen principal
                </label>

                <input
                  id="imagen"
                  type="url"
                  placeholder="https://... (opcional si subes una imagen)"
                />

              </div>

            </div>


            <div class="fila">

              <div class="campo">
                <label for="imagenArchivo">Subir imagen desde la PC</label>
                <div class="media-box">
                  <input
                    id="imagenArchivo"
                    type="file"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                  />
                  <p class="media-ayuda">JPG, PNG, WEBP o GIF. Se subirá a Supabase Storage.</p>
                  <div id="imagenPreview" class="media-preview"></div>
                </div>
              </div>

              <div class="campo">
                <label for="videoArchivo">Subir video desde la PC</label>
                <div class="media-box">
                  <input
                    id="videoArchivo"
                    type="file"
                    accept="video/mp4,video/webm,video/ogg"
                  />
                  <p class="media-ayuda">MP4, WEBM u OGG. El video se insertará dentro del contenido.</p>
                  <div id="videoPreview" class="media-preview"></div>
                </div>
              </div>

            </div>


            <div class="campo">

              <label for="contenido">
                Contenido
              </label>

              <div class="editor-toolbar" id="editorToolbar">
                <select id="formatoTexto" title="Formato">
                  <option value="p">Párrafo</option>
                  <option value="h2">Título H2</option>
                  <option value="h3">Subtítulo H3</option>
                </select>
                <select id="tamanoTexto" title="Tamaño de letra">
                  <option value="">Tamaño</option>
                  <option value="12px">12 px</option>
                  <option value="14px">14 px</option>
                  <option value="16px">16 px</option>
                  <option value="18px">18 px</option>
                  <option value="20px">20 px</option>
                  <option value="24px">24 px</option>
                  <option value="28px">28 px</option>
                  <option value="32px">32 px</option>
                  <option value="36px">36 px</option>
                  <option value="48px">48 px</option>
                </select>
                <button type="button" data-cmd="bold" title="Negrita"><b>B</b></button>
                <button type="button" data-cmd="italic" title="Cursiva"><i>I</i></button>
                <button type="button" data-cmd="underline" title="Subrayado"><u>U</u></button>
                <input type="color" id="colorTexto" value="#111827" title="Color del texto" />
                <button type="button" data-cmd="insertUnorderedList" title="Lista">• Lista</button>
                <button type="button" data-cmd="insertOrderedList" title="Lista numerada">1. Lista</button>
                <button type="button" data-cmd="justifyLeft" title="Alinear izquierda">⬅</button>
                <button type="button" data-cmd="justifyCenter" title="Centrar">↔</button>
                <button type="button" data-cmd="justifyRight" title="Alinear derecha">➡</button>
                <button type="button" id="insertarEnlace" title="Insertar enlace">🔗</button>
                <button type="button" id="limpiarFormato" title="Limpiar formato">Tx</button>
              </div>

              <div
                id="contenido"
                contenteditable="true"
                role="textbox"
                aria-multiline="true"
                data-placeholder="Escribe aquí el contenido de la noticia..."
              ></div>

            </div>


            <div class="acciones">

              <button
                type="submit"
                class="btn btn-verde"
                id="publicarButton"
              >
                🚀 Publicar noticia
              </button>

              <button
                type="button"
                class="btn btn-gris"
                id="borradorButton"
              >
                💾 Guardar borrador
              </button>

              <button
                type="button"
                class="btn btn-gris"
                id="cancelarEdicion"
              >
                Cancelar
              </button>

            </div>

            <div
              id="noticiaMensaje"
              class="mensaje"
            ></div>

          </form>

        </div>

      </div>


      <!-- =========================
           NOTICIAS
      ========================== -->

      <div
        id="seccion-noticias"
        class="oculto"
      >

        <div class="panel">

          <h2>📰 Noticias</h2>

          <div id="listaNoticias">

            <div class="cargando">
              Cargando noticias...
            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <script>
    import { createClient } from '@supabase/supabase-js';


    /* =========================
       SUPABASE
    ========================== */

    const SUPABASE_URL =
      'https://kbghquvejqteiawdotqd.supabase.co';

    const SUPABASE_KEY =
      'sb_publishable_ld7ydSagUVERw0yphWzjvg_yeSPpKfi';

    const supabase = createClient(
      SUPABASE_URL,
      SUPABASE_KEY
    );


    /* =========================
       ELEMENTOS
    ========================== */

    const login = document.getElementById('login');
    const admin = document.getElementById('admin');

    const loginForm =
      document.getElementById('loginForm');

    const loginButton =
      document.getElementById('loginButton');

    const loginMensaje =
      document.getElementById('loginMensaje');

    const cerrarSesion =
      document.getElementById('cerrarSesion');

    const usuarioAdmin =
      document.getElementById('usuarioAdmin');

    const noticiaForm =
      document.getElementById('noticiaForm');

    const noticiaMensaje =
      document.getElementById('noticiaMensaje');

    const listaNoticias =
      document.getElementById('listaNoticias');

    const tituloEditor =
      document.getElementById('tituloEditor');

    const noticiaId =
      document.getElementById('noticiaId');

    const titulo =
      document.getElementById('titulo');

    const categoria =
      document.getElementById('categoria');

    const imagen =
      document.getElementById('imagen');

    const imagenArchivo =
      document.getElementById('imagenArchivo');

    const videoArchivo =
      document.getElementById('videoArchivo');

    const imagenPreview =
      document.getElementById('imagenPreview');

    const videoPreview =
      document.getElementById('videoPreview');

    const contenido =
      document.getElementById('contenido');

    const publicarButton =
      document.getElementById('publicarButton');

    const borradorButton =
      document.getElementById('borradorButton');

    const cancelarEdicion =
      document.getElementById('cancelarEdicion');


    /* =========================
       LOGIN
    ========================== */

    function mostrarLogin() {

      login.classList.remove('oculto');
      admin.classList.add('oculto');

    }


    function mostrarAdmin() {

      login.classList.add('oculto');
      admin.classList.remove('oculto');

    }


    function mensajeLogin(texto, tipo = 'error') {

      loginMensaje.textContent = texto;
      loginMensaje.className =
        `mensaje ${tipo}`;

    }


    loginForm.addEventListener(
      'submit',
      async (event) => {

        event.preventDefault();

        loginButton.disabled = true;
        loginButton.textContent = 'Entrando...';

        const email =
          document.getElementById('email')
            .value
            .trim();

        const password =
          document.getElementById('password')
            .value;

        const { data, error } =
          await supabase.auth.signInWithPassword({
            email,
            password
          });

        loginButton.disabled = false;
        loginButton.textContent =
          'Entrar al panel';

        if (error) {

          mensajeLogin(
            'Correo o contraseña incorrectos.'
          );

          return;
        }

        if (data.session) {

          loginMensaje.className =
            'mensaje';

          mostrarAdmin();

          cargarTodo();

        }

      }
    );


    /* =========================
       SESION
    ========================== */

    async function comprobarSesion() {

      const {
        data: { session }
      } =
        await supabase.auth.getSession();

      if (session) {

        mostrarAdmin();

        if (usuarioAdmin) {
          usuarioAdmin.textContent =
            session.user.email || '';
        }

        cargarTodo();

      } else {

        mostrarLogin();

      }

    }


    supabase.auth.onAuthStateChange(
      (_event, session) => {

        if (session) {

          mostrarAdmin();

          if (usuarioAdmin) {
            usuarioAdmin.textContent =
              session.user.email || '';
          }

        } else {

          mostrarLogin();

        }

      }
    );


    cerrarSesion.addEventListener(
      'click',
      async () => {

        await supabase.auth.signOut();

        mostrarLogin();

      }
    );



    /* =========================
       BUSCADOR Y FILTROS
    ========================== */

    let filtroActual = 'todas';
    let textoBusqueda = '';

    function aplicarFiltrosNoticias() {
      const tarjetas = document.querySelectorAll('.noticia-admin');
      let visibles = 0;

      tarjetas.forEach((tarjeta) => {
        const tituloTarjeta =
          (tarjeta.dataset.titulo || '').toLowerCase();

        const estadoTarjeta =
          tarjeta.dataset.estado || '';

        const coincideTexto =
          !textoBusqueda ||
          tituloTarjeta.includes(textoBusqueda);

        const coincideEstado =
          filtroActual === 'todas' ||
          estadoTarjeta === filtroActual;

        const mostrar =
          coincideTexto && coincideEstado;

        tarjeta.style.display =
          mostrar ? 'flex' : 'none';

        if (mostrar) visibles++;
      });

      const vacio = document.getElementById('resultadoVacio');

      if (vacio) {
        vacio.style.display =
          visibles === 0 ? 'block' : 'none';
      }
    }

    function crearHerramientasNoticias() {
      const lista = document.getElementById('listaNoticias');

      if (!lista) return;

      let herramientas =
        document.getElementById('herramientasNoticias');

      if (herramientas) return;

      herramientas = document.createElement('div');
      herramientas.id = 'herramientasNoticias';
      herramientas.style.cssText =
        'display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;';

      herramientas.innerHTML = `
        <input
          id="buscarNoticias"
          type="search"
          placeholder="🔎 Buscar noticia..."
          style="flex:1;min-width:220px;"
        />

        <select
          id="filtroEstado"
          style="width:auto;min-width:170px;"
        >
          <option value="todas">Todas</option>
          <option value="publicadas">Publicadas</option>
          <option value="borradores">Borradores</option>
        </select>

        <button
          type="button"
          class="btn btn-gris"
          id="actualizarNoticias"
        >
          🔄 Actualizar
        </button>
      `;

      lista.parentElement.insertBefore(
        herramientas,
        lista
      );

      const vacio = document.createElement('div');
      vacio.id = 'resultadoVacio';
      vacio.className = 'cargando';
      vacio.textContent = 'No se encontraron noticias.';
      vacio.style.display = 'none';
      lista.parentElement.appendChild(vacio);

      document
        .getElementById('buscarNoticias')
        .addEventListener('input', (event) => {
          textoBusqueda =
            event.target.value.trim().toLowerCase();

          aplicarFiltrosNoticias();
        });

      document
        .getElementById('filtroEstado')
        .addEventListener('change', (event) => {
          filtroActual = event.target.value;
          aplicarFiltrosNoticias();
        });

      document
        .getElementById('actualizarNoticias')
        .addEventListener('click', async () => {
          await cargarNoticias();
          await cargarEstadisticas();
        });
    }

    crearHerramientasNoticias();

    /* =========================
       NAVEGACION
    ========================== */

    const botonesMenu =
      document.querySelectorAll(
        '.menu button'
      );

    botonesMenu.forEach((boton) => {

      boton.addEventListener(
        'click',
        () => {

          const seccion =
            boton.dataset.seccion;

          cambiarSeccion(seccion);

        }
      );

    });


    function cambiarSeccion(seccion) {

      document
        .getElementById('seccion-inicio')
        .classList.toggle(
          'oculto',
          seccion !== 'inicio'
        );

      document
        .getElementById('seccion-crear')
        .classList.toggle(
          'oculto',
          seccion !== 'crear'
        );

      document
        .getElementById('seccion-noticias')
        .classList.toggle(
          'oculto',
          seccion !== 'noticias'
        );

      botonesMenu.forEach((boton) => {

        boton.classList.toggle(
          'activo',
          boton.dataset.seccion === seccion
        );

      });

      if (seccion === 'noticias') {
        cargarNoticias();
      }

    }


    document
      .getElementById('irCrear')
      .addEventListener(
        'click',
        () => {

          limpiarEditor();

          cambiarSeccion('crear');

        }
      );


    document
      .getElementById('irNoticias')
      .addEventListener(
        'click',
        () => {

          cambiarSeccion('noticias');

        }
      );


    /* =========================
       SLUG
    ========================== */

    function crearSlug(texto) {

      return texto
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');

    }


    /* =========================
       LIMPIAR EDITOR
    ========================== */

    function limpiarEditor() {

      noticiaId.value = '';

      titulo.value = '';

      categoria.value =
        'Nacionales';

      imagen.value = '';

      if (imagenArchivo) imagenArchivo.value = '';
      if (videoArchivo) videoArchivo.value = '';

      if (imagenPreview) {
        imagenPreview.innerHTML = '';
        imagenPreview.style.display = 'none';
      }

      if (videoPreview) {
        videoPreview.innerHTML = '';
        videoPreview.style.display = 'none';
      }

      contenido.innerHTML = '';

      tituloEditor.textContent =
        '📝 Nueva noticia';

      publicarButton.textContent =
        '🚀 Publicar noticia';

      noticiaMensaje.className =
        'mensaje';

      noticiaMensaje.textContent = '';

    }


    cancelarEdicion.addEventListener(
      'click',
      () => {

        limpiarEditor();

        cambiarSeccion('inicio');

      }
    );


    /* =========================
       EDITOR VISUAL
    ========================== */

    document.querySelectorAll('#editorToolbar [data-cmd]').forEach((boton) => {
      boton.addEventListener('click', () => {
        contenido.focus();
        document.execCommand(boton.dataset.cmd, false, null);
      });
    });

    document.getElementById('formatoTexto').addEventListener('change', (event) => {
      contenido.focus();
      document.execCommand('formatBlock', false, event.target.value);
      event.target.value = 'p';
    });

    document.getElementById('colorTexto').addEventListener('input', (event) => {
      contenido.focus();
      document.execCommand('foreColor', false, event.target.value);
    });

    document.getElementById('insertarEnlace').addEventListener('click', () => {
      const url = prompt('Pega la URL del enlace:');
      if (!url) return;
      contenido.focus();
      document.execCommand('createLink', false, url);
    });

    document.getElementById('limpiarFormato').addEventListener('click', () => {
      contenido.focus();
      document.execCommand('removeFormat', false, null);
    });


    document.getElementById('tamanoTexto').addEventListener('change', (event) => {
      const size = event.target.value;
      if (!size) return;

      contenido.focus();

      const seleccion = window.getSelection();
      if (!seleccion || seleccion.rangeCount === 0 || seleccion.isCollapsed) {
        mostrarMensajeNoticia('Selecciona primero el texto al que quieres cambiar el tamaño.', 'error');
        event.target.value = '';
        return;
      }

      document.execCommand('styleWithCSS', false, true);
      document.execCommand('fontSize', false, '7');

      contenido.querySelectorAll('font[size="7"]').forEach((font) => {
        const span = document.createElement('span');
        span.style.fontSize = size;
        span.innerHTML = font.innerHTML;
        font.replaceWith(span);
      });

      event.target.value = '';
    });


    function nombreArchivoSeguro(nombre) {
      const punto = nombre.lastIndexOf('.');
      const ext = punto >= 0 ? nombre.slice(punto).toLowerCase() : '';
      const base = punto >= 0 ? nombre.slice(0, punto) : nombre;

      return base
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 70) + ext;
    }


    async function subirArchivoMedia(archivo, carpeta) {
      if (!archivo) return null;

      const {
        data: { session }
      } = await supabase.auth.getSession();

      if (!session) {
        throw new Error('Tu sesión expiró. Inicia sesión nuevamente.');
      }

      const ruta =
        `${session.user.id}/${carpeta}/${Date.now()}-${crypto.randomUUID()}-${nombreArchivoSeguro(archivo.name)}`;

      const { error: uploadError } =
        await supabase.storage
          .from('media')
          .upload(ruta, archivo, {
            cacheControl: '3600',
            upsert: false,
            contentType: archivo.type || undefined
          });

      if (uploadError) throw uploadError;

      const { data } =
        supabase.storage
          .from('media')
          .getPublicUrl(ruta);

      if (!data?.publicUrl) {
        throw new Error('No se pudo obtener la URL pública del archivo.');
      }

      return data.publicUrl;
    }


    imagenArchivo?.addEventListener('change', () => {
      const archivo = imagenArchivo.files?.[0];

      if (!archivo) {
        imagenPreview.innerHTML = '';
        imagenPreview.style.display = 'none';
        return;
      }

      const url = URL.createObjectURL(archivo);
      imagenPreview.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = 'Vista previa de la imagen';
      imagenPreview.appendChild(img);
      imagenPreview.style.display = 'block';
    });


    videoArchivo?.addEventListener('change', () => {
      const archivo = videoArchivo.files?.[0];

      if (!archivo) {
        videoPreview.innerHTML = '';
        videoPreview.style.display = 'none';
        return;
      }

      const url = URL.createObjectURL(archivo);
      videoPreview.innerHTML = '';
      const video = document.createElement('video');
      video.src = url;
      video.controls = true;
      videoPreview.appendChild(video);
      videoPreview.style.display = 'block';
    });

    // Convierte Markdown básico pegado desde ChatGPT en HTML profesional.
    function markdownAHtml(texto) {
      const lineas = texto.replace(/\r/g, '').split('\n');
      let html = '';
      let enLista = false;
      let tipoLista = '';

      const inline = (t) => t
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>');

      const cerrarLista = () => {
        if (enLista) { html += `</${tipoLista}>`; enLista = false; tipoLista = ''; }
      };

      for (const original of lineas) {
        const linea = original.trim();
        if (!linea) { cerrarLista(); continue; }

        if (linea.startsWith('### ')) { cerrarLista(); html += `<h3>${inline(linea.slice(4))}</h3>`; continue; }
        if (linea.startsWith('## ')) { cerrarLista(); html += `<h2>${inline(linea.slice(3))}</h2>`; continue; }
        if (linea.startsWith('# ')) { cerrarLista(); html += `<h2>${inline(linea.slice(2))}</h2>`; continue; }

        const bullet = linea.match(/^[-*]\s+(.+)/);
        const numbered = linea.match(/^\d+[.)]\s+(.+)/);
        if (bullet || numbered) {
          const tipo = bullet ? 'ul' : 'ol';
          if (!enLista || tipoLista !== tipo) { cerrarLista(); html += `<${tipo}>`; enLista = true; tipoLista = tipo; }
          html += `<li>${inline((bullet || numbered)[1])}</li>`;
          continue;
        }

        cerrarLista();
        html += `<p>${inline(linea)}</p>`;
      }
      cerrarLista();
      return html;
    }

    contenido.addEventListener('paste', (event) => {
      const texto = event.clipboardData?.getData('text/plain') || '';
      if (!texto) return;
      if (/^#{1,3}\s|\*\*.+\*\*|^[-*]\s/m.test(texto)) {
        event.preventDefault();
        document.execCommand('insertHTML', false, markdownAHtml(texto));
      }
    });

    /* =========================
       GUARDAR NOTICIA
    ========================== */

    async function guardarNoticia(publicar) {

      const tituloTexto =
        titulo.value.trim();

      const contenidoTexto =
        contenido.innerHTML.trim();

      if (!tituloTexto || !contenidoTexto) {

        mostrarMensajeNoticia(
          'El título y el contenido son obligatorios.',
          'error'
        );

        return;

      }

      publicarButton.disabled = true;
      borradorButton.disabled = true;

      let datos = {

        titulo: tituloTexto,

        slug: crearSlug(tituloTexto),

        imagen:
          imagen.value.trim() || null,

        contenido: contenidoTexto,

        categoria:
          categoria.value,

        publicado:
          publicar

      };


      try {

        const nuevaImagen = imagenArchivo?.files?.[0] || null;
        const nuevoVideo = videoArchivo?.files?.[0] || null;

        if (nuevaImagen) {
          mostrarMensajeNoticia('Subiendo imagen...', 'ok');
          datos.imagen = await subirArchivoMedia(nuevaImagen, 'imagenes');
        }

        if (nuevoVideo) {
          mostrarMensajeNoticia('Subiendo video...', 'ok');
          const videoUrl = await subirArchivoMedia(nuevoVideo, 'videos');

          datos.contenido += `
            <div class="noticia-video" style="margin:24px 0;">
              <video controls playsinline preload="metadata" style="display:block;width:100%;max-width:900px;margin:auto;border-radius:10px;">
                <source src="${videoUrl}" type="${nuevoVideo.type || 'video/mp4'}">
                Tu navegador no puede reproducir este video.
              </video>
            </div>
          `;
        }

        let error = null;


        if (noticiaId.value) {

          const resultado =
            await supabase
              .from('noticias')
              .update(datos)
              .eq('id', noticiaId.value);

          error = resultado.error;

        } else {

          const resultado =
            await supabase
              .from('noticias')
              .insert([datos]);

          error = resultado.error;

        }


        if (error) {

          console.error(error);

          mostrarMensajeNoticia(
            `No se pudo guardar: ${error.message || 'error de Supabase'}`,
            'error'
          );

          return;

        }


        mostrarMensajeNoticia(
          publicar
            ? 'Noticia publicada correctamente.'
            : 'Borrador guardado correctamente.',
          'ok'
        );


        setTimeout(() => {

          limpiarEditor();

          cargarTodo();

          cambiarSeccion('noticias');

        }, 800);


      } catch (error) {

        console.error(error);

        mostrarMensajeNoticia(
          `Ocurrió un error: ${error?.message || 'No se pudo guardar la noticia.'}`,
          'error'
        );

      } finally {

        publicarButton.disabled = false;
        borradorButton.disabled = false;

      }

    }


    noticiaForm.addEventListener(
      'submit',
      async (event) => {

        event.preventDefault();

        await guardarNoticia(true);

      }
    );


    borradorButton.addEventListener(
      'click',
      async () => {

        await guardarNoticia(false);

      }
    );


    function mostrarMensajeNoticia(
      texto,
      tipo
    ) {

      noticiaMensaje.textContent = texto;

      noticiaMensaje.className =
        `mensaje ${tipo}`;

    }


    /* =========================
       CARGAR NOTICIAS
    ========================== */

    async function cargarNoticias() {

      listaNoticias.innerHTML =
        '<div class="cargando">Cargando noticias...</div>';


      const {
        data,
        error
      } =
        await supabase
          .from('noticias')
          .select('*')
          .order('created_at', {
            ascending: false
          });


      if (error) {

        console.error(error);

        listaNoticias.innerHTML =
          '<div class="cargando">No se pudieron cargar las noticias.</div>';

        return;

      }


      if (!data || data.length === 0) {

        listaNoticias.innerHTML =
          '<div class="cargando">No hay noticias todavía.</div>';

        return;

      }


      listaNoticias.innerHTML = '';


      data.forEach((noticia) => {

        const contenedor =
          document.createElement('div');

        contenedor.className =
          'noticia-admin';

        contenedor.dataset.titulo =
          (noticia.titulo || '').toLowerCase();

        contenedor.dataset.estado =
          noticia.publicado
            ? 'publicadas'
            : 'borradores';


        const info =
          document.createElement('div');

        info.className =
          'noticia-info';


        const h3 =
          document.createElement('h3');

        h3.textContent =
          noticia.titulo || 'Sin título';


        const p =
          document.createElement('p');

        p.textContent =
          `${noticia.categoria || 'Sin categoría'} · ${noticia.slug || ''}`;


        const estado =
          document.createElement('span');

        estado.className =
          noticia.publicado
            ? 'estado estado-publicado'
            : 'estado estado-borrador';

        estado.textContent =
          noticia.publicado
            ? 'PUBLICADA'
            : 'BORRADOR';


        info.appendChild(h3);
        info.appendChild(p);
        info.appendChild(estado);


        const acciones =
          document.createElement('div');

        acciones.className =
          'acciones-noticia';


        const editar =
          document.createElement('button');

        editar.className =
          'btn btn-gris';

        editar.textContent =
          '✏️ Editar';

        editar.addEventListener(
          'click',
          () => editarNoticia(noticia)
        );


        const eliminar =
          document.createElement('button');

        eliminar.className =
          'btn btn-rojo';

        eliminar.textContent =
          '🗑️ Eliminar';

        eliminar.addEventListener(
          'click',
          () => eliminarNoticia(noticia)
        );


        acciones.appendChild(editar);
        acciones.appendChild(eliminar);

        contenedor.appendChild(info);
        contenedor.appendChild(acciones);

        listaNoticias.appendChild(
          contenedor
        );

      });

      aplicarFiltrosNoticias();

    }


    /* =========================
       EDITAR
    ========================== */

    function editarNoticia(noticia) {

      noticiaId.value =
        noticia.id || '';

      titulo.value =
        noticia.titulo || '';

      categoria.value =
        noticia.categoria || 'Nacionales';

      imagen.value =
        noticia.imagen || '';

      contenido.innerHTML =
        noticia.contenido || '';

      tituloEditor.textContent =
        '✏️ Editar noticia';

      publicarButton.textContent =
        noticia.publicado
          ? '🚀 Actualizar noticia'
          : '🚀 Publicar noticia';

      cambiarSeccion('crear');

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

    }


    /* =========================
       ELIMINAR
    ========================== */

    async function eliminarNoticia(noticia) {

      const confirmar =
        confirm(
          `¿Eliminar esta noticia?

${noticia.titulo}`
        );

      if (!confirmar) return;

      try {

        const { data, error } =
          await supabase
            .from('noticias')
            .delete()
            .eq('id', noticia.id)
            .select('id');

        if (error) {
          console.error(error);
          alert(`No se pudo eliminar: ${error.message || 'error de Supabase'}`);
          return;
        }

        if (!data || data.length === 0) {
          alert(
            'Supabase no eliminó la noticia. Revisa la política DELETE (RLS) de la tabla noticias.'
          );
          return;
        }

        await cargarNoticias();
        await cargarEstadisticas();

        alert('Noticia eliminada correctamente.');

      } catch (error) {

        console.error(error);
        alert(`No se pudo eliminar: ${error?.message || 'error desconocido'}`);

      }

    }


    /* =========================
       ESTADISTICAS
    ========================== */

    async function cargarEstadisticas() {

      const {
        data,
        error
      } =
        await supabase
          .from('noticias')
          .select('publicado');


      if (error) {

        console.error(error);

        return;

      }


      const total =
        data?.length || 0;

      const publicadas =
        data?.filter(
          n => n.publicado === true
        ).length || 0;

      const borradores =
        data?.filter(
          n => n.publicado !== true
        ).length || 0;


      document.getElementById(
        'totalNoticias'
      ).textContent = total;

      document.getElementById(
        'totalPublicadas'
      ).textContent = publicadas;

      document.getElementById(
        'totalBorradores'
      ).textContent = borradores;

    }


    /* =========================
       VISITANTES EN VIVO
    ========================== */

    const visitanteId =
      crypto.randomUUID();


    const canalVisitantes =
      supabase.channel(
        'republica-actual-visitantes',
        {
          config: {
            presence: {
              key: visitanteId
            }
          }
        }
      );


    function actualizarVisitantes() {

      const estado =
        canalVisitantes.presenceState();

      let total = 0;


      Object.values(estado)
        .forEach((usuarios) => {

          total += usuarios.length;

        });


      if (total < 1) {
        total = 1;
      }


      document.getElementById(
        'totalVisitantes'
      ).textContent = total;


      document.getElementById(
        'visitantesNumero'
      ).textContent = total;

    }


    canalVisitantes
      .on(
        'presence',
        { event: 'sync' },
        actualizarVisitantes
      )
      .on(
        'presence',
        { event: 'join' },
        actualizarVisitantes
      )
      .on(
        'presence',
        { event: 'leave' },
        actualizarVisitantes
      )
      .subscribe(
        async (status) => {

          if (status === 'SUBSCRIBED') {

            await canalVisitantes.track({
              online_at:
                new Date().toISOString()
            });

            actualizarVisitantes();

          }

        }
      );


    window.addEventListener(
      'beforeunload',
      () => {

        canalVisitantes.untrack();

      }
    );


    /* =========================
       CARGAR TODO
    ========================== */

    async function cargarTodo() {

      await cargarEstadisticas();

      await cargarNoticias();

      actualizarVisitantes();

    }


    /* =========================
       INICIO
    ========================== */

    comprobarSesion();

  </script>

