    async function apiNoticiasGitHub(method = 'GET', body = null) {
      const token = await obtenerToken();
      const opciones = {
        method,
        headers: {
          Authorization: `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        cache: 'no-store'
      };
      if (body !== null) opciones.body = JSON.stringify(body);

      const respuesta = await fetch('/api/noticias-admin', opciones);
      const texto = await respuesta.text();
      let data = null;
      try { data = texto ? JSON.parse(texto) : null; } catch { data = null; }
      if (!respuesta.ok) {
        throw new Error(data?.error || texto || `GitHub ${respuesta.status}`);
      }
      return data;
    }

    async function obtenerTodasLasNoticias() {
      const data = await apiNoticiasGitHub('GET');
      const noticias = Array.isArray(data?.noticias) ? data.noticias : [];
      return noticias.sort((a, b) =>
        (Date.parse(b.created_at || '') || 0) -
        (Date.parse(a.created_at || '') || 0)
      );
    }

    async function guardarDocumento(id, datos) {
      const data = await apiNoticiasGitHub('PUT', { id: String(id), noticia: datos });
      return data.noticia;
    }

    async function borrarDocumento(id) {
      await apiNoticiasGitHub('DELETE', { id: String(id) });
      return true;
    }

