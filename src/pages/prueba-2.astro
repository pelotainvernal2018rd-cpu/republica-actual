---
const PROJECT_ID = import.meta.env.FIREBASE_PROJECT_ID || "republica-actual";
const API_KEY = import.meta.env.FIREBASE_API_KEY;

let noticias = [];

function firestoreValue(v) {
  if (!v || typeof v !== "object") return null;
  if ("stringValue" in v) return v.stringValue;
  if ("integerValue" in v) return Number(v.integerValue);
  if ("doubleValue" in v) return Number(v.doubleValue);
  if ("booleanValue" in v) return Boolean(v.booleanValue);
  if ("timestampValue" in v) return v.timestampValue;
  if ("nullValue" in v) return null;
  if ("arrayValue" in v) return (v.arrayValue?.values || []).map(firestoreValue);
  if ("mapValue" in v) return firestoreFields(v.mapValue?.fields || {});
  return null;
}

function firestoreFields(fields = {}) {
  const obj = {};
  for (const [key, value] of Object.entries(fields)) {
    obj[key] = firestoreValue(value);
  }
  return obj;
}

try {
  const url =
    `https://firestore.googleapis.com/v1/projects/${PROJECT_ID}` +
    `/databases/(default)/documents:runQuery?key=${encodeURIComponent(API_KEY || "")}`;

  const response = await fetch(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      structuredQuery: {
        from: [{ collectionId: "noticias" }],
        where: {
          fieldFilter: {
            field: { fieldPath: "publicado" },
            op: "EQUAL",
            value: { booleanValue: true }
          }
        },
        limit: 100
      }
    })
  });

  if (!response.ok) {
    const detalle = await response.text();
    throw new Error(`Firestore REST ${response.status}: ${detalle}`);
  }

  const rows = await response.json();

  noticias = rows
    .filter((row) => row.document)
    .map((row) => {
      const doc = row.document;
      const parsed = firestoreFields(doc.fields || {});
      const docId = String(doc.name || "").split("/").pop();

      return {
        ...parsed,
        id: parsed.id ?? docId
      };
    })
    .sort((a, b) => {
      const fechaA = Date.parse(a.created_at || "") || 0;
      const fechaB = Date.parse(b.created_at || "") || 0;
      return fechaB - fechaA;
    })
    .slice(0, 30);

  console.log(`Firestore REST: ${noticias.length} noticias publicadas cargadas`);
} catch (error) {
  console.error("ERROR FIRESTORE REST:", error);
}


let empleos = [];

try {
  const jobsUrl =
    `https://firestore.googleapis.com/v1/projects/${PROJECT_ID}` +
    `/databases/(default)/documents:runQuery?key=${encodeURIComponent(API_KEY || "")}`;

  const jobsResponse = await fetch(jobsUrl, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      structuredQuery: {
        from: [{ collectionId: "empleos" }],
        orderBy: [{ field: { fieldPath: "created_at" }, direction: "DESCENDING" }],
        limit: 2
      }
    })
  });

  if (jobsResponse.ok) {
    const rows = await jobsResponse.json();
    empleos = rows
      .filter((row) => row.document)
      .map((row) => {
        const doc = row.document;
        const parsed = firestoreFields(doc.fields || {});
        return { ...parsed, docId: String(doc.name || "").split("/").pop() };
      });
  } else {
    console.error("ERROR EMPLEOS FIRESTORE:", await jobsResponse.text());
  }
} catch (error) {
  console.error("ERROR CARGANDO EMPLEOS:", error);
}

function empleoLink(e) {
  return e?.url || e?.url_fuente || "#";
}

const principal = noticias[0];
const secundarias = noticias.slice(1, 4);
const recientes = noticias.slice(4, 10);
const populares = noticias.slice(12, 17);

function clean(html = "") {
  return String(html)
    .replace(/<script[\s\S]*?<\/script>/gi, "")
    .replace(/<style[\s\S]*?<\/style>/gi, "")
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function desc(n, size = 150) {
  const t = clean(n?.contenido || "");
  return t.length > size ? t.slice(0, size) + "..." : t;
}

function cat(n) {
  return n?.categoria || "Actualidad";
}

function link(n) {
  return `/noticia?id=${n.id}`;
}
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>República Actual 2.0</title>
  <meta name="description" content="República Actual - Noticias de República Dominicana y el mundo." />
</head>

<body>

<header class="top">
  <div class="top-in">
    <span>REPÚBLICA DOMINICANA · NOTICIAS DE ÚLTIMA HORA</span>
    <span>Miércoles, 30 de septiembre de 2026</span>
  </div>
</header>

<header class="brand">
  <div class="brand-in">

    <a href="/" class="logo">
      <img src="/republica-actual-logo.svg" alt="República Actual" />
      <span>NOTICIAS DE REPÚBLICA DOMINICANA Y EL MUNDO</span>
    </a>

    <div class="brand-tools">
      <div class="weather-mini">
        🌤️
        <strong>RD AHORA</strong>
        <small>Actualidad nacional</small>
      </div>

      <a href="/categoria/empleate" class="job-button">
        💼 VER EMPLEOS
      </a>
    </div>

  </div>
</header>

<nav class="navigation">
  <div class="nav-in">
    <a class="home" href="/">⌂</a>
    <a href="/categoria/nacionales">Nacionales</a>
    <a href="/categoria/politica">Política</a>
    <a href="/categoria/economia">Economía</a>
    <a href="/categoria/deportes">Deportes</a>
    <a href="/categoria/mundo">Mundo</a>
    <a href="/categoria/entretenimiento">Entretenimiento</a>
    <a href="/categoria/tecnologia">Tecnología</a>
    <a href="/categoria/empleate">Empléate</a>
    <a href="/pagina/loterias">Loterías</a>
  </div>
</nav>

<div class="breaking">
  <div class="breaking-in">
    <strong>ÚLTIMA HORA</strong>
    <span>{principal?.titulo || "Toda la actualidad en República Actual"}</span>
  </div>
</div>

<main>

  <!-- HERO -->
  <section class="hero-area">

    <div class="hero-main">

      {principal ? (
        <a href={link(principal)} class="hero-story">

          {principal.imagen && (
            <img src={principal.imagen} alt={principal.titulo} />
          )}

          <div class="hero-shade"></div>

          <div class="hero-info">
            <span class="label">{cat(principal)}</span>

            <h1>{principal.titulo}</h1>

            <p>{desc(principal, 210)}</p>

            <b>LEER MÁS →</b>
          </div>

        </a>
      ) : (
        <div class="empty">Cargando noticias...</div>
      )}

    </div>

    <aside class="side-news">

      <div class="side-title">
        <h2>ÚLTIMAS NOTICIAS</h2>
        <span>EN VIVO</span>
      </div>

      {secundarias.map((n, i) => (
        <a href={link(n)} class="side-item">

          <div class="side-number">
            0{i + 1}
          </div>

          <div>
            <small>{cat(n)}</small>
            <h3>{n.titulo}</h3>
          </div>

        </a>
      ))}

    </aside>

  </section>


  <!-- DESTACADAS DEL DÍA -->
  <section class="rd-now">

    <div class="rd-heading">
      <div>
        <span>🇩🇴 REPÚBLICA DOMINICANA</span>
        <h2>DESTACADAS DEL DÍA</h2>
      </div>

      <a href="/">VER TODAS →</a>
    </div>

    <div class="rd-grid destacadas-dia">
      {noticias.slice(1, 6).map((n, i) => (
        <a href={link(n)} class={i === 0 ? "destacada-card principal-dia" : "destacada-card"}>
          {n.imagen ? (
            <img src={n.imagen} alt={n.titulo} loading="lazy" />
          ) : (
            <div class="destacada-placeholder">RA</div>
          )}
          <div class="destacada-overlay"></div>
          <div class="destacada-texto">
            <span>{cat(n)}</span>
            <h3>{n.titulo}</h3>
            <small>LEER NOTICIA →</small>
          </div>
        </a>
      ))}
    </div>

  </section>


  <!-- CONTENIDO PRINCIPAL -->
  <section class="layout">

    <div class="news-column">

      <div class="heading">
        <h2>Noticias recientes</h2>
        <a href="/">VER TODAS</a>
      </div>

      <div class="news-list">

        {recientes.map((n) => (
          <a href={link(n)} class="news-row">

            {n.imagen ? (
              <img src={n.imagen} alt={n.titulo} loading="lazy" />
            ) : (
              <div class="placeholder">RA</div>
            )}

            <div class="news-row-text">

              <span>{cat(n)}</span>

              <h3>{n.titulo}</h3>

              <p>{desc(n, 160)}</p>

              <small>República Actual</small>

            </div>

          </a>
        ))}

      </div>

      <nav class="pagination" aria-label="Paginación de noticias recientes">
        <a class="active" href="/pagina/1">1</a>
        <a href="/pagina/2">2</a>
        <a href="/pagina/3">3</a>
        <a href="/pagina/4">4</a>
        <a href="/pagina/5">5</a>
        <a class="next" href="/pagina/2">SIGUIENTE →</a>
      </nav>

    </div>


    <!-- SIDEBAR -->
    <aside class="right-column">

      <div class="box weather">

        <div class="box-head">
          <h2>CLIMA EN RD</h2>
          <span>☀️</span>
        </div>

        <strong>--°C</strong>

        <p>Santo Domingo</p>

        <div class="weather-days">
          <span>Hoy<br />--°</span>
          <span>Mañana<br />--°</span>
          <span>Viernes<br />--°</span>
        </div>

      </div>


      <div class="box">

        <div class="box-head">
          <h2>🔥 LO MÁS LEÍDO</h2>
        </div>

        <div class="popular">

          {populares.map((n, i) => (
            <a href={link(n)}>
              <b>{i + 1}</b>
              <span>{n.titulo}</span>
            </a>
          ))}

        </div>

      </div>


      <a href="/categoria/empleate" class="jobs">

        <small>OPORTUNIDADES</small>

        <h2>EMPLÉATE</h2>

        <p>
          Encuentra nuevas oportunidades
          de trabajo.
        </p>

        <strong>VER VACANTES →</strong>

      </a>

    </aside>

  </section>


  <!-- EMPLEATE -->
  <section class="module employment">

    <div class="module-head">

      <div>
        <small>OPORTUNIDADES LABORALES</small>
        <h2>EMPLÉATE</h2>
      </div>

      <a href="/categoria/empleate">
        VER TODAS LAS VACANTES →
      </a>

    </div>

    <div class="employment-grid jobs-recent-grid">

      {empleos.length ? empleos.map((e) => (
        <a href={empleoLink(e)} class="job-card">
          <small>VACANTE RECIENTE</small>
          <h3>{e.titulo || "Oportunidad laboral"}</h3>
          <p>
            {[e.empresa, e.ubicacion, e.tipoEmpleo].filter(Boolean).join(" · ")}
          </p>
          <strong>VER VACANTE →</strong>
        </a>
      )) : (
        <>
          <div class="job-card">
            <small>VACANTES</small>
            <h3>Esperando nuevas oportunidades</h3>
            <p>Las dos vacantes más recientes aparecerán aquí automáticamente.</p>
          </div>
          <div class="job-card">
            <small>EMPLÉATE</small>
            <h3>Oportunidades laborales</h3>
            <p>Conectado con la colección de empleos de República Actual.</p>
          </div>
        </>
      )}

      <div class="jobs-more">
        <small>OPORTUNIDADES LABORALES</small>
        <h3>¿Buscas empleo?</h3>
        <a href="/empleos">VER MÁS EMPLEOS →</a>
      </div>

    </div>

  </section>


  <!-- LOTERIAS -->
  <section class="module lottery">

    <div class="module-head">

      <div>
        <small>RESULTADOS</small>
        <h2>LOTERÍAS</h2>
      </div>

      <a href="/pagina/loterias">
        VER RESULTADOS →
      </a>

    </div>

    <div class="lottery-tabs">
      <span class="selected">🇩🇴 República Dominicana</span>
      <span>🇺🇸 Estados Unidos</span>
      <span>Historial</span>
      <span>Próximos sorteos</span>
      <span>Estadísticas</span>
    </div>

    <div class="lottery-cards">

      <div>
        <strong>🇩🇴</strong>
        <h3>República Dominicana</h3>
        <p>Resultados actualizados automáticamente.</p>
        <a href="/pagina/loterias">VER RESULTADOS →</a>
      </div>

      <div>
        <strong>🇺🇸</strong>
        <h3>Estados Unidos</h3>
        <p>Powerball, Mega Millions y más.</p>
        <a href="/pagina/loterias">VER RESULTADOS →</a>
      </div>

    </div>

  </section>


  <!-- DESTACADAS -->
  <section class="featured">

    <div class="heading">
      <h2>NUNCA PASAN DE MODA</h2>
    </div>

    <div class="featured-grid evergreen-grid">

      {noticias.slice(0, 8).map((n) => (
        <a href={link(n)} class="evergreen-card">

          {n.imagen ? (
            <img src={n.imagen} alt={n.titulo} loading="lazy" />
          ) : (
            <div class="evergreen-placeholder">RA</div>
          )}

          <div class="evergreen-copy">
            <span>{cat(n)}</span>
            <h3>{n.titulo}</h3>
          </div>

        </a>
      ))}

    </div>

  </section>

</main>


<footer>

  <div class="footer-in">

    <div>
      <img src="/republica-actual-logo.svg" alt="República Actual" />
      <p>Noticias de República Dominicana y el mundo.</p>
    </div>

    <div>
      <strong>REPÚBLICA ACTUAL 2.0</strong>
      <p>Versión de prueba independiente de la página principal.</p>
    </div>

  </div>

</footer>

</body>
</html>


