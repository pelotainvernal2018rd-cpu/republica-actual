---
import Layout from '../layouts/Layout.astro';
import { cargarRepublicaUtil } from '../lib/noticias-firestore.js';

const noticias = await cargarRepublicaUtil();

function limpiarHTML(html = '') {
  return String(html)
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<img[^>]*>/gi, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function resumen(contenido = '', limite = 150) {
  const texto = limpiarHTML(contenido);

  if (texto.length <= limite) {
    return texto;
  }

  return texto.substring(0, limite).trim() + '...';
}

function enlaceNoticia(noticia) {
  return `/noticia/${noticia.slug || noticia.id}/`;
}

function obtenerImagen(noticia = {}) {
  return (
    noticia.imagen ||
    noticia.imagen_principal ||
    noticia.image ||
    noticia.image_url ||
    ''
  );
}

function imagenCloudflare(url = '', ancho = 700) {
  if (!url) return '';

  if (!/^https?:\/\//i.test(url)) {
    return url;
  }

  return `/cdn-cgi/image/width=${ancho},quality=78,format=auto,fit=cover/${url}`;
}
---

<Layout
  title="República Útil | Guías y trámites de República Dominicana"
  description="Guías prácticas, trámites, documentos, empleo, vehículos, educación y servicios útiles para República Dominicana."
>

  <main class="util-page">

    <section class="util-hero">

      <span class="util-etiqueta">
        REPÚBLICA ACTUAL
      </span>

      <h1>
        República Útil
      </h1>

      <p>
        Guías prácticas para resolver trámites,
        documentos, empleo, vehículos, educación
        y situaciones cotidianas en República Dominicana.
      </p>

    </section>


    <div class="util-barra">

      <div>
        <strong>
          {noticias.length}
        </strong>

        guías disponibles
      </div>

      <a href="/">
        ← Volver a portada
      </a>

    </div>


    {
      noticias.length > 0 ? (

        <section
          class="util-grid"
          aria-label="Guías de República Útil"
        >

          {
            noticias.map((noticia) => {

              const imagen =
                obtenerImagen(noticia);

              return (

                <article class="util-card">

                  {
                    imagen && (

                      <a
                        class="util-imagen-enlace"
                        href={enlaceNoticia(noticia)}
                      >

                        <img
                          class="util-imagen"
                          src={imagenCloudflare(imagen, 700)}
                          alt={noticia.titulo}
                          width="700"
                          height="394"
                          loading="lazy"
                          decoding="async"
                          referrerpolicy="no-referrer"
                          data-original={imagen}
                          onerror="
                            if (
                              this.dataset.fallbackStage !== 'original'
                            ) {
                              this.dataset.fallbackStage = 'original';
                              this.src = this.dataset.original;
                            } else {
                              this.onerror = null;
                              this.style.display = 'none';
                            }
                          "
                        />

                      </a>

                    )
                  }


                  <div class="util-contenido">

                    <span class="util-categoria">
                      REPÚBLICA ÚTIL
                    </span>

                    <h2>

                      <a href={enlaceNoticia(noticia)}>
                        {noticia.titulo}
                      </a>

                    </h2>

                    <p>
                      {resumen(noticia.contenido, 150)}
                    </p>

                    <a
                      class="util-leer"
                      href={enlaceNoticia(noticia)}
                    >
                      VER GUÍA →
                    </a>

                  </div>

                </article>

              );

            })
          }

        </section>

      ) : (

        <div class="util-vacio">
          Todavía no hay guías publicadas en República Útil.
        </div>

      )
    }

  </main>


  <style>

    * {
      box-sizing: border-box;
    }


    .util-page {
      width: 100%;
      max-width: 1180px;
      margin: auto;
      padding: 35px 20px 70px;
      color: #102d46;
    }


    /* ===============================
       CABECERA
    =============================== */

    .util-hero {
      position: relative;
      overflow: hidden;

      padding:
        55px
        45px;

      margin-bottom:
        25px;

      border-radius:
        4px;

      background:
        linear-gradient(
          135deg,
          #071a3d 0%,
          #102d46 65%,
          #173e5d 100%
        );

      color:
        #ffffff;
    }


    .util-hero::after {
      content: "";

      position:
        absolute;

      width:
        260px;

      height:
        260px;

      right:
        -90px;

      top:
        -110px;

      border-radius:
        50%;

      background:
        rgba(255,255,255,.05);
    }


    .util-etiqueta {
      display:
        inline-block;

      margin-bottom:
        12px;

      color:
        #ff4b52;

      font-size:
        11px;

      font-weight:
        900;

      letter-spacing:
        1.5px;
    }


    .util-hero h1 {
      margin:
        0 0 12px;

      color:
        #ffffff;

      font-size:
        clamp(
          38px,
          6vw,
          65px
        );

      line-height:
        1;

      letter-spacing:
        -2px;
    }


    .util-hero p {
      max-width:
        720px;

      margin:
        0;

      color:
        #dce6ee;

      font-size:
        16px;

      line-height:
        1.65;
    }


    /* ===============================
       BARRA
    =============================== */

    .util-barra {
      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      gap:
        20px;

      margin:
        0 0 28px;

      padding:
        15px 0;

      border-bottom:
        2px solid #102d46;

      color:
        #657786;

      font-size:
        13px;
    }


    .util-barra strong {
      color:
        #e52b32;

      font-size:
        17px;
    }


    .util-barra a {
      color:
        #102d46;

      font-size:
        12px;

      font-weight:
        800;

      text-decoration:
        none;
    }


    .util-barra a:hover {
      color:
        #e52b32;
    }


    /* ===============================
       GRID
    =============================== */

    .util-grid {
      display:
        grid;

      grid-template-columns:
        repeat(
          3,
          minmax(0,1fr)
        );

      gap:
        26px 22px;
    }


    /* ===============================
       TARJETA
    =============================== */

    .util-card {
      min-width:
        0;

      overflow:
        hidden;

      border:
        1px solid #e1e6ea;

      background:
        #ffffff;

      box-shadow:
        0 4px 15px
        rgba(16,45,70,.06);

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }


    .util-card:hover {
      transform:
        translateY(-3px);

      box-shadow:
        0 8px 25px
        rgba(16,45,70,.11);
    }


    /* ===============================
       IMAGEN
    =============================== */

    .util-imagen-enlace {
      display:
        block;

      width:
        100%;

      aspect-ratio:
        16 / 9;

      overflow:
        hidden;

      background:
        #eef1f4;
    }


    .util-imagen {
      display:
        block;

      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

      transition:
        transform .35s ease;
    }


    .util-card:hover
    .util-imagen {
      transform:
        scale(1.025);
    }


    /* ===============================
       CONTENIDO
    =============================== */

    .util-contenido {
      padding:
        20px;
    }


    .util-categoria {
      display:
        block;

      margin-bottom:
        8px;

      color:
        #e52b32;

      font-size:
        10px;

      font-weight:
        900;

      letter-spacing:
        1px;
    }


    .util-contenido h2 {
      margin:
        0 0 10px;

      font-size:
        20px;

      line-height:
        1.18;

      letter-spacing:
        -.3px;
    }


    .util-contenido h2 a {
      color:
        #102d46;

      text-decoration:
        none;
    }


    .util-contenido h2 a:hover {
      color:
        #e52b32;
    }


    .util-contenido p {
      margin:
        0 0 17px;

      color:
        #667887;

      font-size:
        13px;

      line-height:
        1.55;
    }


    .util-leer {
      color:
        #e52b32;

      font-size:
        11px;

      font-weight:
        900;

      letter-spacing:
        .7px;

      text-decoration:
        none;
    }


    .util-leer:hover {
      text-decoration:
        underline;
    }


    /* ===============================
       VACÍO
    =============================== */

    .util-vacio {
      padding:
        50px 25px;

      border:
        1px dashed #ccd5dd;

      background:
        #f8fafb;

      color:
        #687986;

      text-align:
        center;
    }


    /* ===============================
       TABLET
    =============================== */

    @media (
      max-width:
      900px
    ) {

      .util-grid {
        grid-template-columns:
          repeat(
            2,
            minmax(0,1fr)
          );
      }

    }


    /* ===============================
       MÓVIL
    =============================== */

    @media (
      max-width:
      620px
    ) {

      .util-page {
        padding:
          20px
          14px
          50px;
      }


      .util-hero {
        padding:
          35px
          22px;
      }


      .util-hero h1 {
        font-size:
          38px;
      }


      .util-hero p {
        font-size:
          14px;
      }


      .util-barra {
        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .util-grid {
        grid-template-columns:
          1fr;
      }


      .util-contenido h2 {
        font-size:
          19px;
      }

    }

  </style>

</Layout>